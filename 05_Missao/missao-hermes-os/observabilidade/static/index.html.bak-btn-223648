<!-- ===== Plano de Escala — status ao vivo ===== -->
<style>
#escala-strip{
  max-width:1100px;margin:16px auto 0;padding:14px 18px;
  background:rgba(20,20,24,.72);border:1px solid rgba(255,255,255,.08);
  border-radius:12px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;
  color:#e8e8ec;font-size:12px;
}
#escala-strip h3{margin:0 0 10px;font-size:13px;color:#aaa;
  text-transform:uppercase;letter-spacing:.08em;font-weight:500}
#escala-strip .fases{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}
#escala-strip .f{padding:10px;border-radius:9px;background:rgba(255,255,255,.03);
  border:1px solid rgba(255,255,255,.06);position:relative}
#escala-strip .f.on{border-color:#4da3ff55;background:#4da3ff11}
#escala-strip .f .n{color:#888;font-size:10px;text-transform:uppercase;letter-spacing:.06em}
#escala-strip .f .t{font-weight:600;font-size:13px;margin:2px 0 6px}
#escala-strip .f .d{color:#999;font-size:11px;line-height:1.4}
#escala-strip .f .eta{position:absolute;top:8px;right:10px;font-size:10px;color:#4da3ff}
#escala-strip .regra{margin-top:12px;padding:8px 12px;border-radius:8px;
  background:#e74c3c11;border:1px solid #e74c3c33;color:#e74c3c;font-size:11px}
#escala-strip .next{margin-top:12px;padding:10px 12px;border-radius:8px;
  background:#2ecc7111;border:1px solid #2ecc7133;color:#2ecc71;font-size:11px}
</style>

<div id="escala-strip">
  <h3>Plano de Escala · 4 fases</h3>
  <div class="fases">
    <div class="f on">
      <span class="eta">2h</span>
      <div class="n">Fase 1</div>
      <div class="t">Endurecer</div>
