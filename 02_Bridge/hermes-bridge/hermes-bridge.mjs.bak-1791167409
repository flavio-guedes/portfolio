let _hooked=null;
setInterval(function(){
  if(sock && sock!==_hooked){
    _hooked=sock;
    sock.ev.on('messages.upsert', async function(ev){
      /* HERMES_AGENT_HOOK */
      (async function(){
        if(!ev || ev.type!=='notify') return;
        const myJid = String((sock&&sock.user&&sock.user.id)||'').replace(/:.*@/,'@');
        for(const m of ev.messages){
          try{
            const jid = m && m.key && m.key.remoteJid;
            const fromMe = !!(m && m.key && m.key.fromMe);
            if(!jid) continue;
            if(fromMe && jid===myJid) continue; // self-chat = comandos /status etc
            const mm = m.message||{};
            const texto = (mm.conversation || (mm.extendedTextMessage&&mm.extendedTextMessage.text) || '').trim();
            if(!texto) continue;
            fetch('http://127.0.0.1:8422/hermes',{
              method:'POST', headers:{'Content-Type':'application/json'},
              body: JSON.stringify({ jid, texto, meta: { nome:'', empresa:'', cargo:'', segmento:'', score:'' } })
            }).catch(function(){});
          }catch(e){}
        }
      })();
      
      if(ev.type!=='notify') return;
      for(const m of ev.messages){ try{ await waHandle(m); }catch(e){ console.error('wa:',e.message); } }
    });
    console.log('• Comandos WhatsApp ativos — manda /ajuda no chat consigo mesmo.');
  }
},2000);
