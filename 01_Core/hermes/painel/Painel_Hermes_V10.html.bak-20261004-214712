  }
  $('#sidebar').classList.remove('hidden');
  const items=userCfg.nav.filter(n=>n.visible);
  const orderedModes=getOrderedModes().filter(m=>m.visible&&!WORKSPACE_MODE_IDS.includes(m.id));

  const isCol=id=>!!userCfg.layout.collapsedSections[id];
  const secOpen=(id,body)=>`<div class="nav-section" data-section="${esc(id)}"${isCol(id)?' hidden':''}>${body}</div>`;

  /* Ordem: Workspace primeiro, depois Modo. A navegação de telas é usada
     com mais frequência que a troca de modo, então fica no topo. */
  let html=`<div class="sidebar-content">
    <div class="brand"><div class="mark">H</div>
      <div><b>HERMES OS</b><small>Flávio Guedes · operação</small></div>
    </div>`;
  if(showNav){
    /* Agrupado por dado. Automações deixa de ter seção própria e entra em
       Sistema — continua com o mesmo id, mesmo botão e mesmo setView. */
    html+=navSectionHead('workspace','Workspace');
    html+=secOpen('workspace',`<nav class="nav nav-groups">${navGroupedHTML(items)}</nav>`);
  }
  if(showModes){
    html+=`<div class="nav-sep"></div>`+navSectionHead('modo','Modo');
    html+=secOpen('modo',`<nav class="nav modes-nav">${orderedModes.map(modeBtnHTML).join('')}</nav>`);
  }
  if(showFilters){
    html+=`<div class="nav-sep"></div>`+navSectionHead('filtros','Filtros');
