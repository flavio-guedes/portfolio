def cores():
    curses.start_color(); curses.use_default_colors()
    curses.init_pair(1, curses.COLOR_WHITE, -1)
    curses.init_pair(2, curses.COLOR_GREEN, -1)
    curses.init_pair(3, curses.COLOR_RED, -1)
    curses.init_pair(4, curses.COLOR_CYAN, -1)
    curses.init_pair(5, curses.COLOR_YELLOW, -1)
    curses.init_pair(6, 8, -1)
    curses.init_pair(7, curses.COLOR_MAGENTA, -1)

def barra(pct, w):
    pct = max(0, min(100, int(pct)))
    n = int(w*pct/100)
    return "█"*n + "░"*(w-n)

def draw(scr):
    """TUI leve — só visualiza. Comandos são escritos em ~/hermes/cmd para o runner processar."""
    cores(); curses.curs_set(0); scr.nodelay(1); scr.timeout(500)
    aba = 1; cur_fila = 0; off_fila = 0; ult = 0; d = None

    while True:
        c = scr.getch()
        h, w = scr.getmaxyx()
        if c == ord('q') or c == 27: break
        elif c == ord('\t'): aba = (aba+1)%3
        elif c == ord('1'): aba=0
        elif c == ord('2'): aba=1
        elif c == ord('3'): aba=2
        elif c in (curses.KEY_DOWN, ord('j')): cur_fila += 1
        elif c in (curses.KEY_UP, ord('k')): cur_fila = max(0, cur_fila-1)
        elif c == ord('r'): ult = 0
        elif c in (ord('s'), ord('p'), ord('B'), ord('d'), ord('F'), ord('X'), curses.KEY_DC, curses.KEY_ENTER, ord('\n'), ord('\r')):
            # envia comando pro runner via arquivo
            item_sel = None
            if aba == 1 and d and d.get("fila"):
                ordn = ordenada(d["fila"])
                if 0 <= cur_fila < len(ordn): item_sel = ordn[cur_fila]
            cmd = {
                "cmd": {ord('s'):'start', ord('p'):'pause', ord('B'):'bloquear',
                        ord('d'):'pular', ord('F'):'etapa', ord('X'):'despedida',
                        curses.KEY_DC:'remover', curses.KEY_ENTER:'enviar',
                        ord('\n'):'enviar', ord('\r'):'enviar'}.get(c, '?'),
                "id": item_sel["id"] if item_sel else None,
                "ts": datetime.now().isoformat()
            }
            try:
                with open(os.path.join(HOME,"hermes/cmd"), "w") as f: json.dump(cmd, f)
            except: pass
            EST["msg"] = f"→ {cmd['cmd']}" + (f" {cmd['id']}" if cmd["id"] else "")
            ult = 0

        if time.time() - ult > 1.0:
            d = {"fila": load(FILA), "bridge": health(), "agora": datetime.now(),
                 "runner": load(os.path.join(HOME,"hermes/runner.state")) or {}}
            ult = time.time()

        scr.erase()
        fila = (d or {}).get("fila")
        bst = ((d or {}).get("bridge") or {}).get("status","?")
        bcor = curses.color_pair(2) if bst=="connected" else curses.color_pair(3)
        rst = ((d or {}).get("runner") or {}).get("status","?")
        rcor = curses.color_pair(2) if rst in ("ativo","running") else curses.A_DIM

        scr.addstr(0, 2, "HERMES", curses.A_BOLD | curses.color_pair(4))
        scr.addstr(0, 10, datetime.now().strftime("%H:%M:%S"), curses.A_DIM)
        scr.addstr(0, 20, "bridge", curses.A_DIM)
        scr.addstr(0, 27, f"●{bst}", bcor | curses.A_BOLD)
        scr.addstr(0, 40, f"runner:{rst}", rcor | curses.A_BOLD)
        nomes = ["1 Campanha","2 Fila","3 Funil"]
        pos = w - 30
        for i, n in enumerate(nomes):
            if aba==i: scr.addstr(0, pos, f" {n} ", curses.A_REVERSE | curses.A_BOLD)
            else: scr.addstr(0, pos, f" {n} ", curses.A_DIM)
            pos += len(n) + 2
        scr.addstr(1, 2, (EST["msg"] or "s ativa · p pausa · ENTER envia · B bloq · d pula · F etapa · X desped")[:w-4], curses.color_pair(4))
        scr.addstr(2, 0, "─"*w, curses.A_DIM)

        top = 4
        painel_h = max(10, int(h/3))
        bot_lista = h - painel_h - 1

        if aba == 0:
            lin = top+1
            scr.addstr(lin, 2, "CAMPANHAS", curses.A_BOLD | curses.color_pair(4)); lin += 2
            if fila:
                for tipo, gap in [("novo",GAP_NOVO),("base",GAP_BASE),("hot",GAP_HOT)]:
                    sub = [i for i in fila["itens"] if i.get("tipo")==tipo]
                    ok = sum(1 for i in sub if i["status"]=="OK")
                    er = sum(1 for i in sub if i["status"]=="ERRO")
                    pd = sum(1 for i in sub if i["status"]=="AGENDADO")
                    pct = int((ok+er)*100/len(sub)) if sub else 0
                    cor = curses.color_pair(7) if tipo=="novo" else (curses.color_pair(5) if tipo=="base" else curses.color_pair(3))
                    scr.addstr(lin, 2, f"● {tipo.upper():5s} · {gap}min", curses.A_BOLD | cor); lin += 1
                    b = barra(pct, 40)
                    scr.addstr(lin, 4, "[")
                    scr.addstr(lin, 5, b[:int(40*pct/100)], cor)
                    scr.addstr(lin, 5+int(40*pct/100), b[int(40*pct/100):], curses.color_pair(6))
                    scr.addstr(lin, 45, f"] {pct:3d}%  {len(sub)} itens"); lin += 1
                    scr.addstr(lin, 4, f"✓{ok}  ✗{er}  ⏳{pd}", curses.A_DIM); lin += 2
        elif aba == 1:
            if not fila: scr.addstr(top+1, 2, "sem fila", curses.A_DIM)
            else:
                it = fila["itens"]
                ok = sum(1 for i in it if i["status"]=="OK")
                pd = sum(1 for i in it if i["status"]=="AGENDADO")
                er = sum(1 for i in it if i["status"]=="ERRO")
                scr.addstr(top, 2, "FILA", curses.A_BOLD | curses.color_pair(4))
                scr.addstr(top, 8, f"{len(it)}", curses.A_DIM)
                scr.addstr(top, 14, f"✓{ok}", curses.color_pair(2))
                scr.addstr(top, 22, f"✗{er}", curses.color_pair(3) if er else curses.A_DIM)
                scr.addstr(top, 30, f"⏳{pd}", curses.color_pair(7))
                lin = top+2
                scr.addstr(lin, 3, "TEMPO", curses.A_DIM)
                scr.addstr(lin, 11, "TIPO", curses.A_DIM)
                scr.addstr(lin, 18, "NOME", curses.A_DIM)
                scr.addstr(lin, 41, "EMPRESA", curses.A_DIM)
                scr.addstr(lin, 68, "ETAPA", curses.A_DIM)
                scr.addstr(lin, 82, "STATUS", curses.A_DIM)
                lin += 2
                ordn = ordenada(fila)
                altura = bot_lista - lin
                if altura < 3: altura = 3
                cur_fila = min(cur_fila, max(0, len(ordn)-1))
                if cur_fila < off_fila: off_fila = cur_fila
                if cur_fila >= off_fila + altura: off_fila = cur_fila - altura + 1
                for idx in range(off_fila, min(len(ordn), off_fila+altura)):
                    i = ordn[idx]
                    st = i["status"]; tipo = i.get("tipo","novo"); et = i.get("etapa","D0")
                    sel = (idx == cur_fila)
                    if st == "AGENDADO":
                        try:
                            alvo = datetime.strptime(i["prazo"],"%Y-%m-%d %H:%M:%S")
                            seg = (alvo - d["agora"]).total_seconds()
                            tstr = f"{int(seg//60)}m{int(seg%60):02d}s" if seg>60 else (f"{int(seg)}s" if seg>0 else "agora")
                        except: tstr = i["prazo"][11:16]
                    else: tstr = (i.get("enviado_em") or i["prazo"])[11:16]
                    nome = (i.get("nome") or "—")[:22]
                    empresa = (i.get("empresa") or "—")[:26]
                    et_nome = ETAPAS.get(et, ("?",""))[0][:10]
                    if st == "OK":          mc, marc = curses.color_pair(2), "✓"
                    elif st == "ERRO":      mc, marc = curses.color_pair(3), "✗"
                    elif st == "PULADO":    mc, marc = curses.color_pair(5), "→"
                    elif st == "BLOQUEADO": mc, marc = curses.color_pair(6), "⊘"
                    elif st == "DESPEDIDA": mc, marc = curses.color_pair(6), "⊗"
                    else:                   mc, marc = curses.color_pair(7), "·"
                    ct = curses.color_pair(7) if tipo=="novo" else (curses.color_pair(5) if tipo=="base" else curses.color_pair(3))
                    ce = curses.color_pair(4) if et in ("Q","D0") else (curses.color_pair(5) if et.startswith("F") else curses.A_DIM)
                    at = curses.A_REVERSE | curses.A_BOLD if sel else curses.A_NORMAL
                    scr.addstr(lin, 0, " " * (w-1), at if sel else curses.A_NORMAL)
                    scr.addstr(lin, 0, " ▶ " if sel else "   ", at if sel else curses.A_DIM)
                    scr.addstr(lin, 3, f"{tstr:>6}", (mc | curses.A_BOLD) | at)
                    scr.addstr(lin, 11, f"{tipo:>5}", ct | at)
                    scr.addstr(lin, 18, f"{nome:22s}", at)
                    scr.addstr(lin, 41, f"{empresa:26s}", at)
                    scr.addstr(lin, 68, f"{et:4s}{et_nome:10s}", ce | at)
                    scr.addstr(lin, 82, f"{marc}{st:10s}", mc | at)
                    lin += 1
                scr.addstr(bot_lista, 2, f"cursor: {cur_fila+1}/{len(ordn)}", curses.A_DIM)
        elif aba == 2:
            lin = top+1
            it = (fila or {}).get("itens") or []
            env = sum(1 for i in it if i["status"]=="OK")
            scr.addstr(lin, 2, "FUNIL", curses.A_BOLD | curses.color_pair(4)); lin += 2
            for nome, n in [("Enviados",env),("Respondidos",0),("Conversas",0),("Reuniões",0),("Propostas",0),("Ganhos",0)]:
                pct = int(n*100/(env or 1))
                b = barra(pct, 40)
                scr.addstr(lin, 2, f"{nome:12s}", curses.A_BOLD)
                scr.addstr(lin, 15, "[")
                scr.addstr(lin, 16, b[:int(40*pct/100)], curses.color_pair(2))
                scr.addstr(lin, 16+int(40*pct/100), b[int(40*pct/100):], curses.color_pair(6))
                scr.addstr(lin, 56, f"] {n:>4} ({pct:>3}%)"); lin += 1

        # painel msg
        painel_ini = h - painel_h
        scr.addstr(painel_ini, 0, "─"*w, curses.A_DIM)
        item_sel = None
        if aba == 1 and fila:
            ordn = ordenada(fila)
            if 0 <= cur_fila < len(ordn): item_sel = ordn[cur_fila]
        if item_sel:
            et = item_sel.get("etapa","D0")
            et_nome = ETAPAS.get(et, ("?",""))[0]
            st = item_sel.get("status","?")
            cabec = f" {item_sel['id']}  ·  {item_sel.get('nome','—')[:26]}  ·  {item_sel['empresa'][:26]}  ·  {item_sel['telefone']}  ·  {et}({et_nome})  ·  {st}"
            scr.addstr(painel_ini+1, 2, cabec[:w-4], curses.A_BOLD | curses.color_pair(4))
            texto = (item_sel.get("mensagem") or "").strip()
            larg = w - 6
            linhas = []
            for par in texto.split("\n"):
                linha = ""
                for pal in par.split():
                    if len(linha) + len(pal) + 1 <= larg:
                        linha = (linha + " " + pal).strip()
                    else:
                        if linha: linhas.append(linha)
                        linha = pal
                if linha: linhas.append(linha)
                linhas.append("")
            for k, lm in enumerate(linhas[:painel_h-3]):
                scr.addstr(painel_ini+2+k, 3, lm[:larg], curses.color_pair(6) if lm else curses.A_DIM)

        scr.addstr(h-1, 2, "↑↓ navega ENTER envia DEL remove B bloq d pula F etapa X desped s ativa p pausa q sai", curses.A_DIM)
        scr.refresh()


