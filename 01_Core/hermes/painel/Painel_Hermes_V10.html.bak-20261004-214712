*{box-sizing:border-box}
html,body{margin:0;background:var(--bg);color:var(--txt);font-family:var(--font-body);line-height:1.45;font-size:14px;min-height:100%}
body{background-image:radial-gradient(900px 500px at 10% -10%,var(--accent-bg),transparent 60%),radial-gradient(800px 500px at 100% 0,rgba(96,165,250,.04),transparent 58%);transition:background-image .3s,background-color .3s,color .3s;}
button,input,select,textarea{font:inherit;color:inherit}
button{cursor:pointer;background:transparent;border:0;padding:0}
a{color:inherit;text-decoration:none}
::selection{background:var(--accent);color:#000}

/* ============ LAYOUT ============ */
.app{display:grid;grid-template-columns:var(--left-w) minmax(0,1fr) var(--right-w);min-height:100vh;transition:grid-template-columns .18s ease;}
body[data-right-collapsed="true"] .right-rail{display:none;}
body[data-right-collapsed="true"] .chat-fab,body[data-right-collapsed="true"] .chat-panel{right:20px;}
[data-mode="minimal"] .chat-fab{right:20px;}
@media(min-width:1281px){body:not([data-right-collapsed="true"]):not([data-mode="minimal"]) .chat-fab,body:not([data-right-collapsed="true"]):not([data-mode="minimal"]) .chat-panel{right:340px;}}
@media(max-width:820px){
  .app{display:block;}
  .sidebar{position:sticky;top:0;height:auto;border-bottom:1px solid var(--line);border-right:0;z-index:8;}
  .sidebar-content{padding:8px 12px;display:flex;flex-direction:row;align-items:center;gap:6px;overflow-x:auto;flex:unset;height:auto;}
  .sidebar .brand{padding:0;margin-right:6px;flex-shrink:0;}
  .sidebar .nav{display:flex;gap:2px;flex-direction:row;flex:1;overflow-x:auto;}
  .sidebar .nav button span:not(.ico){display:none;}
  .sidebar .nav button{padding:8px;flex-shrink:0;}
  .sidebar .nav-sep,.sidebar .side-foot,.sidebar .nav-label,.sidebar .nav-group-label{display:none;}
  .sidebar-resizer{display:none;}
  .topbar{padding:14px 16px 10px;}
  .content{padding:16px;}
  .right-rail{display:none;}
}
[data-mode="minimal"] .right-rail{display:none;}

.sidebar{position:sticky;top:0;height:100vh;background:rgba(9,11,15,.86);backdrop-filter:blur(14px);border-right:1px solid var(--line);display:flex;flex-direction:column;z-index:4;transition:background .3s;}
.sidebar.hidden{display:none;}
.sidebar-content{flex:1;overflow-y:auto;overflow-x:hidden;padding:22px 12px;display:flex;flex-direction:column;gap:4px;}
.sidebar-resizer{position:absolute;right:-3px;top:0;bottom:0;width:6px;cursor:col-resize;z-index:5;transition:background .15s;}
.sidebar-resizer:hover,.sidebar-resizer.dragging{background:var(--accent-bd);}
body[data-left-collapsed="true"] .sidebar-resizer{display:none;}

.brand{display:flex;align-items:center;gap:10px;padding:2px 10px 18px;flex-shrink:0;}
.mark{width:30px;height:30px;border-radius:8px;background:var(--accent);color:#08090c;display:grid;place-items:center;font-family:var(--font-display);font-size:17px;font-weight:600;box-shadow:0 0 0 4px var(--accent-bg);transition:.25s;flex-shrink:0;}
.brand b{font-size:12.5px;letter-spacing:.02em;display:block;}
.brand small{color:var(--muted);font-size:10px;}
.nav-label{color:var(--muted2);font-size:10px;font-weight:800;letter-spacing:.14em;text-transform:uppercase;padding:12px 12px 4px;display:flex;align-items:center;gap:6px;}
.nav-label .tag{background:var(--recommend-bg);color:var(--recommend);border:1px solid var(--recommend-bd);border-radius:999px;padding:1px 6px;font-size:8.5px;letter-spacing:.08em;}
.nav{display:grid;gap:2px;}
.nav button{padding:9px 12px;border-radius:9px;color:var(--muted);text-align:left;display:flex;gap:10px;align-items:center;font-size:13px;transition:.15s;width:100%;border-left:2px solid transparent;}
.nav button:hover{color:var(--txt);background:rgba(255,255,255,.05);}
.nav button.active{color:var(--txt);background:var(--accent-bg);border-left-color:var(--accent);font-weight:600;}
.nav .ico{width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center;color:var(--accent);font-size:14px;opacity:.95;flex-shrink:0;transition:opacity .15s,transform .15s;}
.ico svg{width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round;display:block;}
.nav button:not(.active) .ico{opacity:.75;}
.nav button:hover .ico{opacity:1;}
.nav button:focus-visible{outline:2px solid var(--accent);outline-offset:-2px;}
.modes-nav .ico.mi-explore{color:#e0b878;}
.modes-nav .ico.mi-act{color:#ff5b5b;}
.modes-nav .ico.mi-recommend{color:#22d3ee;}
.modes-nav .ico.mi-insight{color:#c084fc;}
.modes-nav .ico.mi-risk{color:#f97316;}
.modes-nav .ico.mi-minimal{color:#a8b2bd;}
.modes-nav .ico.mi-dashboards{color:#60a5fa;}
.modes-nav .ico.mi-listas{color:#e0b878;}
.modes-nav .ico.mi-sprints{color:#4ade80;}
.modes-nav .ico.mi-experimentos{color:#22d3ee;}
.modes-nav .ico.mi-playbooks{color:#c084fc;}
.modes-nav .ico.mi-simulador{color:#fbbf24;}
.modes-nav .ico.mi-portfolio{color:#e0b878;}
.modes-nav button.active .ico{color:var(--accent);}
.nav-sep{height:1px;background:var(--line);margin:12px 12px;}
.side-foot{margin-top:auto;padding:14px 12px 0;border-top:1px solid var(--line);color:var(--muted);font-size:10.5px;}
.side-foot strong{color:var(--txt);font-size:11.5px;display:block;margin-bottom:5px;}
.dot{width:7px;height:7px;border-radius:50%;display:inline-block;background:var(--neutral);vertical-align:middle;}
.dot.ok{background:var(--ok);}.dot.warm{background:var(--warn);}.dot.err{background:var(--urgent);}.dot.ai{background:var(--ai);}.dot.info{background:var(--info);}.dot.risk{background:var(--risk);}
body[data-left-collapsed="true"] .sidebar-content{padding:22px 8px;}
body[data-left-collapsed="true"] .sidebar .brand > div:not(.mark){display:none;}
body[data-left-collapsed="true"] .sidebar .nav-label,body[data-left-collapsed="true"] .sidebar .nav-sep,body[data-left-collapsed="true"] .sidebar .side-filters,body[data-left-collapsed="true"] .sidebar .nav-group-label{display:none;}
body[data-left-collapsed="true"] .sidebar .nav button span:not(.ico){display:none;}
body[data-left-collapsed="true"] .sidebar .nav button{justify-content:center;padding:11px;}
body[data-left-collapsed="true"] .sidebar .side-foot{display:none;}
body[data-left-collapsed="true"] .sidebar .brand{padding:2px 0 18px;justify-content:center;}

.main{display:flex;flex-direction:column;min-width:0;}
.topbar{padding:16px 22px 10px;border-bottom:1px solid var(--line);background:rgba(9,11,15,.72);backdrop-filter:blur(12px);position:sticky;top:0;z-index:6;transition:padding .15s;}
body[data-header-resized="true"] .topbar{height:var(--header-h,auto);max-height:var(--header-h,auto);overflow-y:auto;}
body[data-header-collapsed="true"] .topbar{padding:8px 22px;}
body[data-header-collapsed="true"] .topbar .eyebrow,body[data-header-collapsed="true"] .topbar h1,body[data-header-collapsed="true"] .topbar p,body[data-header-collapsed="true"] .topbar .filters,body[data-header-collapsed="true"] .topbar .header-nav,body[data-header-collapsed="true"] .topbar-resizer{display:none;}
body[data-header-collapsed="true"] .topbar-row{margin:0;}
.topbar-row{display:flex;justify-content:space-between;align-items:flex-start;gap:20px;flex-wrap:wrap;}
.topbar .eyebrow{color:var(--accent);font-size:10px;font-weight:800;letter-spacing:.14em;text-transform:uppercase;margin-bottom:5px;}
.topbar h1{font:500 clamp(20px,2.2vw,26px)/1.1 var(--font-display);margin:0;letter-spacing:-.02em;}
.topbar p{color:var(--muted);margin:5px 0 0;font-size:12px;max-width:640px;}
.topbar-actions{display:flex;gap:6px;flex-wrap:wrap;justify-content:flex-end;align-items:center;}
.topbar-resizer{position:absolute;left:0;right:0;bottom:-3px;height:6px;cursor:row-resize;z-index:7;transition:background .15s;}
.topbar-resizer:hover,.topbar-resizer.dragging{background:var(--accent-bd);}
.header-nav{display:flex;gap:4px;flex-wrap:wrap;margin-top:10px;padding-top:10px;border-top:1px solid var(--line);}
.header-nav.modes-nav{border-top:0;padding-top:6px;margin-top:4px;}
.header-nav button{padding:5px 10px;border-radius:8px;font-size:11.5px;color:var(--muted);display:inline-flex;align-items:center;gap:6px;border:1px solid transparent;transition:.15s;}
.header-nav button:hover{color:var(--txt);background:rgba(255,255,255,.05);}
.header-nav button.active{color:var(--accent);background:var(--accent-bg);border-color:var(--accent-bd);font-weight:600;}
.header-nav .ico{color:var(--accent);font-size:12px;}

.btn{border:1px solid var(--line2);background:rgba(255,255,255,.035);color:var(--txt);border-radius:9px;padding:7px 11px;font-size:12px;font-weight:700;transition:.15s;white-space:nowrap;display:inline-flex;align-items:center;gap:6px;}
.btn:hover{background:rgba(255,255,255,.08);transform:translateY(-1px);border-color:var(--line3);}
.btn.primary{background:var(--accent);border-color:var(--accent);color:#08090c;}
.btn.primary:hover{filter:brightness(1.1);}
.btn.ghost{border-color:transparent;background:transparent;color:var(--muted);}
.btn.ghost:hover{color:var(--txt);background:rgba(255,255,255,.05);}
.btn.sm{padding:4px 8px;font-size:10.5px;border-radius:7px;}
.btn.danger{color:var(--urgent);border-color:var(--urgent-bd);}
.btn.success{background:var(--ok);border-color:var(--ok);color:#08140c;}
.btn.warn{background:var(--warn);border-color:var(--warn);color:#1a1204;}
.btn.icon{padding:7px;min-width:32px;height:32px;justify-content:center;}
.btn.icon.active{background:var(--accent-bg);border-color:var(--accent-bd);color:var(--accent);}
.btn[disabled]{opacity:.4;cursor:not-allowed;transform:none;}

.filters{display:flex;gap:6px;flex-wrap:nowrap;align-items:center;padding:10px 0 2px;overflow-x:auto;scrollbar-width:thin;}
/* Filtros no cabeçalho: acompanham a altura redimensionada e nunca somem.
   O topbar vira overflow-y:auto quando encurtado, então a linha de filtros
   fica grudada no rodapé da área visível e ainda rola por dentro se a
   largura apertar. */
.topbar-filters{position:sticky;bottom:0;z-index:3;background:var(--bg);
  border-top:1px solid var(--line);padding:5px 0 1px;margin-top:6px;}
.topbar-filters .filters{padding:0;}
body[data-header-collapsed="true"] .topbar-filters{display:none;}
.filter-group{display:inline-flex;align-items:center;gap:4px;background:rgba(255,255,255,.03);border:1px solid var(--line);border-radius:7px;padding:2px 7px;height:26px;font-size:10.5px;transition:.15s;flex-shrink:0;}
.filter-group:hover{border-color:var(--line2);}
.filter-group .lbl{color:var(--muted2);font-size:8.5px;font-weight:800;letter-spacing:.06em;text-transform:uppercase;white-space:nowrap;}
.filter-group select{border:0;background:transparent;color:var(--txt);font-size:11px;outline:0;padding:0;cursor:pointer;min-width:38px;max-width:140px;white-space:nowrap;text-overflow:ellipsis;}
.filter-group select option{background:var(--panel2);}
.filters .filters-clear{color:var(--muted);font-size:10.5px;flex-shrink:0;background:rgba(255,255,255,.03);border:1px solid var(--line);border-radius:7px;padding:3px 8px;height:26px;}
.filters .filters-clear:hover{color:var(--txt);border-color:var(--line2);}
.side-filters,.rail-filters{display:flex;flex-direction:column;gap:6px;padding:0;min-width:0;}
.side-filters .filter-group,.rail-filters .filter-group{width:100%;justify-content:space-between;min-width:0;}
/* No trilho estreito o select mantinha a largura do texto e empurrava a página.
   min-width:0 + flex permite encolher e truncar com reticências. */
.side-filters .filter-group select,.rail-filters .filter-group select{flex:1;min-width:0;max-width:100%;text-overflow:ellipsis;}

.content{padding:20px 22px 100px;flex:1;min-width:0;}
body.footer-open .content{padding-bottom:140px;}
.view{display:none;}
.view.active{display:block;}

.right-rail{border-left:1px solid var(--line);padding:20px 14px;position:sticky;top:0;height:100vh;overflow-y:auto;background:rgba(9,11,15,.6);}
.right-resizer{position:absolute;left:-3px;top:0;bottom:0;width:6px;cursor:col-resize;z-index:5;transition:background .15s;}
.right-resizer:hover,.right-resizer.dragging{background:var(--accent-bd);}
.rail-section{margin-bottom:20px;}
.rail-title{color:var(--accent);font-size:10px;font-weight:800;letter-spacing:.14em;text-transform:uppercase;margin-bottom:10px;display:flex;justify-content:space-between;align-items:center;}
.rail-title span{color:var(--muted);font-weight:600;letter-spacing:0;text-transform:none;font-size:10.5px;}
.rail-item{display:flex;gap:10px;align-items:flex-start;padding:10px 0;border-bottom:1px solid var(--line);font-size:12px;}
.rail-item:last-child{border-bottom:0;}
.rail-item .mini{color:var(--muted);font-size:10.5px;display:block;margin-top:2px;}
.rail-status{display:flex;align-items:center;gap:8px;padding:7px 0;font-size:12px;color:var(--muted);}
.rail-status strong{color:var(--txt);font-weight:600;}

.app-footer{position:fixed;left:0;right:0;bottom:0;z-index:9;background:rgba(13,17,22,.96);backdrop-filter:blur(12px);border-top:1px solid var(--line2);padding:8px 16px;display:none;gap:10px;align-items:center;box-shadow:0 -8px 24px rgba(0,0,0,.4);overflow-x:auto;}
.app-footer.open{display:flex;}
.footer-nav{display:flex;gap:2px;flex-shrink:0;align-items:center;flex-wrap:nowrap;}
.footer-nav button{padding:7px 11px;border-radius:8px;font-size:11.5px;color:var(--muted);display:inline-flex;align-items:center;gap:6px;border:1px solid transparent;transition:.15s;white-space:nowrap;}
.footer-nav button:hover{color:var(--txt);background:rgba(255,255,255,.05);}
.footer-nav button.active{color:var(--accent);background:var(--accent-bg);border-color:var(--accent-bd);font-weight:600;}
.footer-sep{width:1px;background:var(--line2);height:22px;flex-shrink:0;margin:0 4px;}

.grid{display:grid;gap:14px;}
.g2{grid-template-columns:repeat(2,minmax(0,1fr));}
.g3{grid-template-columns:repeat(3,minmax(0,1fr));}
.g4{grid-template-columns:repeat(4,minmax(0,1fr));}
.g5{grid-template-columns:repeat(5,minmax(0,1fr));}
@media(max-width:1100px){.g4{grid-template-columns:repeat(2,1fr);}.g3{grid-template-columns:repeat(2,1fr);}.g5{grid-template-columns:repeat(2,1fr);}}
@media(max-width:640px){.g2,.g3,.g4,.g5{grid-template-columns:1fr;}}

.card{background:linear-gradient(160deg,rgba(255,255,255,.045),rgba(255,255,255,.015));border:1px solid var(--line);border-radius:var(--r);padding:16px;position:relative;transition:.15s;}
.card.x-click{cursor:pointer;}
.card.x-click:hover{border-color:var(--line3);transform:translateY(-2px);}
.card.left-urgent{border-left:3px solid var(--urgent);}
.card.left-warn{border-left:3px solid var(--warn);}
.card.left-ok{border-left:3px solid var(--ok);}
.card.left-info{border-left:3px solid var(--info);}
.card.left-ai{border-left:3px solid var(--ai);}
.card.left-risk{border-left:3px solid var(--risk);}
.card.left-recommend{border-left:3px solid var(--recommend);}
.card.left-accent{border-left:3px solid var(--accent);}
.card-head{display:flex;justify-content:space-between;align-items:flex-start;gap:12px;margin-bottom:12px;}
.card-head h3{margin:0;font-size:13px;font-weight:700;}
.card-head p{margin:3px 0 0;color:var(--muted);font-size:11.5px;}
.section-head{display:flex;justify-content:space-between;align-items:flex-end;gap:16px;margin:24px 0 12px;flex-wrap:wrap;}
.section-head h2{font:500 20px var(--font-display);margin:0;}
.section-head p{color:var(--muted);font-size:12px;margin:3px 0 0;}

.kpi{padding:12px 14px;border-radius:12px;background:rgba(255,255,255,.03);border:1px solid var(--line);position:relative;overflow:hidden;}
.kpi .k{color:var(--muted);font-size:11px;display:flex;justify-content:space-between;align-items:center;gap:8px;font-weight:600;min-width:0;overflow-wrap:anywhere;}
.kpi .n{font:500 24px/1.1 var(--font-display);margin:6px 0 3px;color:var(--txt);overflow-wrap:anywhere;}
.kpi .d{color:var(--muted);font-size:10.5px;overflow-wrap:anywhere;}
.kpi::before{content:'';position:absolute;left:0;top:0;bottom:0;width:3px;background:var(--neutral);}
.kpi.ok::before{background:var(--ok);}.kpi.ok .n{color:var(--ok);}
.kpi.warn::before{background:var(--warn);}.kpi.warn .n{color:var(--warn);}
.kpi.alert::before{background:var(--urgent);}.kpi.alert .n{color:var(--urgent);}
.kpi.info::before{background:var(--info);}.kpi.info .n{color:var(--info);}
.kpi.ai::before{background:var(--ai);}.kpi.ai .n{color:var(--ai);}
.kpi.risk::before{background:var(--risk);}.kpi.risk .n{color:var(--risk);}
.kpi.recommend::before{background:var(--recommend);}.kpi.recommend .n{color:var(--recommend);}
.kpi.money::before{background:var(--money);}.kpi.money .n{color:var(--money);}
.kpi.accent::before{background:var(--accent);}.kpi.accent .n{color:var(--accent);}

.badge{display:inline-flex;align-items:center;gap:5px;border:1px solid var(--line2);border-radius:999px;padding:3px 8px;font-size:10.5px;color:var(--muted);white-space:nowrap;font-weight:600;background:rgba(255,255,255,.03);}
.badge.hot{color:var(--urgent);border-color:var(--urgent-bd);background:var(--urgent-bg);}
.badge.warm{color:var(--warn);border-color:var(--warn-bd);background:var(--warn-bg);}
.badge.ok{color:var(--ok);border-color:var(--ok-bd);background:var(--ok-bg);}
.badge.info{color:var(--info);border-color:var(--info-bd);background:var(--info-bg);}
.badge.ai{color:var(--ai);border-color:var(--ai-bd);background:var(--ai-bg);}
.badge.risk{color:var(--risk);border-color:var(--risk-bd);background:var(--risk-bg);}
.badge.recommend{color:var(--recommend);border-color:var(--recommend-bd);background:var(--recommend-bg);}
.badge.gold{color:var(--gold);border-color:var(--accent-bd);background:var(--accent-bg);}
.badge.neutral{color:var(--muted);}

.tbl-wrap{overflow:auto;border:1px solid var(--line);border-radius:var(--r);background:rgba(255,255,255,.015);}
table.tbl{width:100%;border-collapse:collapse;font-size:12.5px;}
table.tbl th{color:var(--muted);font-weight:800;text-align:left;font-size:10px;text-transform:uppercase;letter-spacing:.08em;border-bottom:1px solid var(--line);padding:12px 14px;background:rgba(255,255,255,.02);white-space:nowrap;}
table.tbl td{padding:12px 14px;border-bottom:1px solid var(--line);vertical-align:middle;}
/* Nomes de empresa e segmento podem ser longos e não tinham ponto de quebra,
   o que empurrava a tabela para fora do container. */
table.tbl td{overflow-wrap:anywhere;min-width:0;}
table.tbl td .name{display:block;overflow-wrap:anywhere;}
table.tbl tr:last-child td{border-bottom:0;}
table.tbl tr.row{cursor:pointer;transition:.1s;}
table.tbl tr.row:hover td{background:rgba(255,255,255,.03);}
table.tbl tr.row.urgent td:first-child{box-shadow:inset 3px 0 var(--urgent);}
table.tbl tr.row.warn td:first-child{box-shadow:inset 3px 0 var(--warn);}
table.tbl tr.row.ok td:first-child{box-shadow:inset 3px 0 var(--ok);}
.name{font-weight:600;color:var(--txt);}
.sub{color:var(--muted);font-size:10.5px;margin-top:2px;}

.progress{height:5px;background:rgba(255,255,255,.07);border-radius:99px;overflow:hidden;min-width:60px;flex:1;}
.progress i{display:block;height:100%;background:var(--accent);border-radius:inherit;transition:.4s;}
.progress i.ok{background:var(--ok);}.progress i.warn{background:var(--warn);}
.progress i.urgent{background:var(--urgent);}.progress i.info{background:var(--info);}
.progress i.ai{background:var(--ai);}.progress i.risk{background:var(--risk);}

.feed{display:flex;flex-direction:column;gap:0;}
.feed-item{display:grid;grid-template-columns:58px 14px 1fr auto;gap:10px;padding:11px 0;border-bottom:1px solid var(--line);font-size:12.5px;align-items:center;}
.feed-item:last-child{border-bottom:0;}
.feed-item .t{color:var(--muted);font-size:11px;font-variant-numeric:tabular-nums;}
.feed-item .w{color:var(--muted);font-size:10.5px;font-weight:600;}
.feed-item .marker{width:7px;height:7px;border-radius:50%;background:var(--neutral);}
.feed-item.t-captura .marker{background:var(--info);}
.feed-item.t-envio .marker{background:var(--ok);}
.feed-item.t-resposta .marker{background:var(--ai);}
.feed-item.t-erro .marker{background:var(--urgent);}
.feed-item.t-decisao .marker{background:var(--accent);}
.feed-item.t-acao .marker{background:var(--warn);}

.kanban{display:grid;gap:12px;grid-auto-flow:column;grid-auto-columns:minmax(220px,1fr);overflow-x:auto;padding-bottom:6px;}
.kanban-col{background:rgba(255,255,255,.018);border:1px solid var(--line);border-radius:12px;padding:12px;min-height:200px;display:flex;flex-direction:column;}
.kanban-col .col-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;}
.kanban-col .col-head strong{font-size:12px;}
.kanban-col .col-head span{font-size:10px;color:var(--muted);background:rgba(255,255,255,.06);border-radius:999px;padding:2px 8px;}
.kcard{background:var(--panel);border:1px solid var(--line);border-radius:10px;padding:12px;margin-bottom:8px;cursor:pointer;transition:.15s;border-left:3px solid var(--neutral);}
.kcard:hover{border-color:var(--line3);transform:translateY(-1px);}
.kcard.stage-descoberta{border-left-color:var(--info);}
.kcard.stage-qualificacao{border-left-color:var(--warn);}
.kcard.stage-conversa{border-left-color:var(--ai);}
.kcard.stage-proposta{border-left-color:var(--urgent);}
.kcard.stage-fechado{border-left-color:var(--ok);}
.kcard h4{margin:0 0 4px;font-size:12.5px;font-weight:700;}
.kcard p{margin:0;color:var(--muted);font-size:10.5px;min-height:14px;line-height:1.45;}
.kcard .row{display:flex;justify-content:space-between;align-items:center;gap:8px;margin-top:8px;font-size:10.5px;color:var(--muted);flex-wrap:wrap;}

.chips{display:flex;gap:6px;flex-wrap:wrap;}
.chip-s{background:rgba(255,255,255,.045);border:1px solid var(--line);border-radius:999px;padding:4px 10px;font-size:10.5px;color:var(--muted);}
.chip-s b{color:var(--txt);margin-left:6px;font-weight:600;}

/* Barra de ações da sessão de execução. Os grupos quebram linha antes de
   qualquer elemento estourar a largura em telas estreitas. */
.exec-toolbar{display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin-bottom:6px;}
.exec-toolbar-grp{display:flex;gap:8px;flex-wrap:wrap;min-width:0;}
/* Destaque da seção para onde um atalho (Campanhas / Ações) apontou. */
.exec-focus{scroll-margin-top:16px;}
.exec-focus>section,.section.exec-focus{border-radius:12px;}
.exec-focus{outline:1px solid var(--accent-bd);outline-offset:6px;}

.kv{display:flex;justify-content:space-between;align-items:baseline;gap:14px;padding:9px 0;border-bottom:1px solid var(--line);font-size:12px;}
.kv:last-child{border-bottom:0;}
.kv span{color:var(--muted);font-size:11px;}
.kv b{font-weight:600;text-align:right;}

.note{border-left:2px solid var(--accent);background:var(--accent-bg);color:var(--muted);font-size:11.5px;padding:6px 11px;border-radius:0 7px 7px 0;margin:0 0 10px;line-height:1.45;}
.note strong{color:var(--txt);font-weight:700;}
.note em{color:var(--accent);font-style:italic;font-weight:600;}

.backdrop{position:fixed;inset:0;background:rgba(0,0,0,.68);display:none;z-index:20;backdrop-filter:blur(2px);}
.backdrop.open{display:block;}
.drawer{display:none;position:absolute;top:0;right:0;bottom:0;width:min(560px,100%);background:var(--bg2);border-left:1px solid var(--line2);padding:24px;overflow-y:auto;box-shadow:-24px 0 80px rgba(0,0,0,.5);}
.drawer.open{display:block;}
.drawer h2{font:500 22px var(--font-display);margin:0 0 4px;}
.drawer .eyebrow{color:var(--accent);font-size:10px;font-weight:800;letter-spacing:.14em;text-transform:uppercase;margin-bottom:6px;}
.modal{display:none;position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:min(600px,calc(100% - 32px));max-height:90vh;overflow-y:auto;background:var(--bg2);border:1px solid var(--line2);border-radius:16px;padding:24px;box-shadow:0 24px 90px rgba(0,0,0,.6);}
.modal.open{display:block;}
.close{font-size:22px;color:var(--muted);padding:4px;line-height:1;}
.close:hover{color:var(--txt);}

.settings-footer{position:fixed;left:0;right:0;bottom:0;background:var(--bg2);border-top:1px solid var(--line2);padding:18px 26px 22px;z-index:22;max-height:60vh;overflow-y:auto;display:none;box-shadow:0 -16px 48px rgba(0,0,0,.55);}
.settings-footer.open{display:block;}
.settings-footer .sf-head{display:flex;justify-content:space-between;align-items:flex-start;gap:12px;margin-bottom:6px;}
.settings-footer .eyebrow{color:var(--accent);font-size:10px;font-weight:800;letter-spacing:.14em;text-transform:uppercase;margin-bottom:6px;}
.settings-footer h2{font:500 20px var(--font-display);margin:0 0 2px;}
.settings-footer .sf-body{max-width:1000px;margin:0 auto;}

.settings-tabs{display:flex;gap:4px;border-bottom:1px solid var(--line);margin:16px 0 20px;overflow-x:auto;}
.settings-tabs button{padding:9px 14px;font-size:12px;font-weight:700;color:var(--muted);border-bottom:2px solid transparent;border-radius:0;white-space:nowrap;}
.settings-tabs button.active{color:var(--accent);border-bottom-color:var(--accent);}

.cfg-row{display:grid;grid-template-columns:auto 1fr auto auto;gap:10px;align-items:center;padding:9px 12px;border:1px solid var(--line);border-radius:10px;margin-bottom:6px;background:rgba(255,255,255,.02);}
.cfg-row .grip{color:var(--muted2);font-size:14px;}
.cfg-row .label{font-size:12.5px;font-weight:600;}
.cfg-row .label small{display:block;color:var(--muted);font-size:10.5px;font-weight:400;}
.cfg-row .ctrl{display:flex;gap:2px;}
.cfg-row .ctrl button{width:26px;height:26px;border-radius:6px;border:1px solid var(--line);color:var(--muted);display:grid;place-items:center;font-size:12px;}
.cfg-row .ctrl button:hover{color:var(--txt);background:rgba(255,255,255,.05);}
.cfg-row .ctrl button:disabled{opacity:.3;cursor:not-allowed;}
.cfg-row .toggle{width:34px;height:20px;border-radius:999px;background:rgba(255,255,255,.08);position:relative;transition:.2s;cursor:pointer;border:1px solid var(--line);}
.cfg-row .toggle::after{content:'';position:absolute;left:2px;top:2px;width:14px;height:14px;border-radius:50%;background:var(--muted);transition:.2s;}
.cfg-row .toggle.on{background:var(--accent-bg);border-color:var(--accent-bd);}
.cfg-row .toggle.on::after{background:var(--accent);left:16px;}

.seg-control{display:inline-flex;border:1px solid var(--line);border-radius:9px;padding:2px;gap:2px;background:rgba(255,255,255,.02);flex-wrap:wrap;}
.seg-control button{padding:4px 9px;border-radius:7px;font-size:10.5px;font-weight:700;color:var(--muted);transition:.15s;white-space:nowrap;}
.seg-control button.active{background:var(--accent);color:#08090c;}

.list-row{display:grid;grid-template-columns:auto 1fr auto;gap:14px;padding:14px 0;border-bottom:1px solid var(--line);align-items:center;cursor:pointer;transition:.12s;}
.list-row:hover{background:rgba(255,255,255,.02);}
.list-row:last-child{border-bottom:0;}
.list-row.warn{border-left:3px solid var(--warn);padding-left:12px;background:var(--warn-bg);}
.list-row.risk{border-left:3px solid var(--risk);padding-left:12px;background:var(--risk-bg);}
.list-row.ok{border-left:3px solid var(--ok);padding-left:12px;background:var(--ok-bg);}
/* Campanha em linha: só o título aparece; o resto vem no expandir. */
.camp-row{padding:0;margin-bottom:0;border-radius:0;border-left:0;border-right:0;border-top:0;cursor:pointer;transition:.12s;}
.camp-row:first-child{border-radius:var(--r) var(--r) 0 0;}
.camp-row:last-child{border-radius:0 0 var(--r) var(--r);}
.camp-row:hover{background:rgba(255,255,255,.02);}
.camp-head{display:flex;align-items:center;gap:12px;padding:14px 16px;}
.camp-head .name{font-weight:700;font-size:13.5px;line-height:1.35;}
.camp-row.expanded{background:rgba(255,255,255,.025);}
.camp-body{padding:0 16px 16px 42px;border-top:1px solid var(--line);}
.camp-body .kv{align-items:flex-start;gap:16px;}
.camp-body .kv span{flex:0 0 150px;}
.camp-body .kv b{flex:1;text-align:right;}

.bars{display:grid;gap:8px;}
/* Coluna do rótulo era fixa em 160px; com a barra (min-width 60px) o mínimo
   da linha passava de 240px e estourava o card em telas estreitas.
   minmax(0,...) deixa o rótulo encolher e truncar com reticências. */
.bar-line{display:grid;grid-template-columns:minmax(0,160px) minmax(0,1fr) auto;gap:12px;align-items:center;font-size:11.5px;}
.bar-line>span{color:var(--muted);min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
.bar-line b{text-align:right;font-family:var(--font-display);font-weight:500;font-size:14px;white-space:nowrap;}

.empty{padding:30px;text-align:center;color:var(--muted);font-size:12px;}

/* ============ MINIMAL ============ */
[data-mode="minimal"] .topbar{padding:14px 22px 10px;}
[data-mode="minimal"] .topbar h1{font-size:22px;}
[data-mode="minimal"] .topbar p{display:none;}
[data-mode="minimal"] .content{padding:20px 22px 80px;max-width:920px;}
[data-mode="minimal"] .note{display:none;}
[data-mode="minimal"] .section-head{margin:24px 0 6px;}
[data-mode="minimal"] .section-head h2{font-family:Manrope,sans-serif;color:var(--muted);text-transform:uppercase;letter-spacing:.14em;font-size:11px;font-weight:800;}
[data-mode="minimal"] .section-head p{display:none;}

.min-status{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:26px;align-items:center;}
.min-pill{display:inline-flex;align-items:center;gap:6px;padding:6px 12px;border-radius:999px;font-size:11.5px;font-weight:700;border:1px solid var(--line);background:rgba(255,255,255,.02);color:var(--muted);}
.min-pill.urgent{color:var(--urgent);border-color:var(--urgent-bd);background:var(--urgent-bg);}
.min-pill.warn{color:var(--warn);border-color:var(--warn-bd);background:var(--warn-bg);}
.min-pill.ai{color:var(--ai);border-color:var(--ai-bd);background:var(--ai-bg);}
.min-pill.ok{color:var(--ok);border-color:var(--ok-bd);background:var(--ok-bg);}
.min-section-label{font-size:10px;font-weight:800;letter-spacing:.16em;text-transform:uppercase;color:var(--muted2);margin:26px 0 10px;display:flex;justify-content:space-between;align-items:center;}
.min-section-label span{color:var(--muted);letter-spacing:0;text-transform:none;font-weight:500;font-size:10.5px;}
.min-list{display:flex;flex-direction:column;gap:0;}
.min-row{display:grid;grid-template-columns:1fr auto;gap:16px;align-items:center;padding:14px 0;border-bottom:1px solid var(--line);cursor:pointer;transition:.15s;position:relative;}
.min-row:last-child{border-bottom:0;}
.min-row:hover{padding-left:8px;}
.min-row .title{font-size:13.5px;font-weight:600;color:var(--txt);display:flex;align-items:center;gap:10px;flex-wrap:wrap;}
.min-row .meta{color:var(--muted);font-size:11.5px;margin-top:4px;line-height:1.5;}
.min-row .go{color:var(--muted2);font-size:15px;transition:.15s;}
.min-row .dot-min{width:6px;height:6px;border-radius:50%;background:var(--neutral);flex-shrink:0;}
.min-row.r-urgent .dot-min{background:var(--urgent);}
.min-row.r-warn .dot-min{background:var(--warn);}
.min-row.r-ai .dot-min{background:var(--ai);}
.min-row.r-ok .dot-min{background:var(--ok);}
.min-empty{padding:56px 20px;text-align:center;color:var(--muted);font-size:13px;line-height:1.6;border:1px dashed var(--line);border-radius:12px;margin:20px 0;}
.min-empty strong{display:block;color:var(--txt);font-size:15px;font-weight:600;margin-bottom:6px;}
.min-footer{margin-top:56px;padding-top:20px;border-top:1px solid var(--line);font-size:11px;color:var(--muted2);display:flex;gap:18px;flex-wrap:wrap;}
.min-footer b{color:var(--muted);font-weight:600;}

/* ============ RECOMENDAÇÃO ============ */
.rec-topbar{display:flex;flex-wrap:wrap;gap:10px;align-items:center;padding:8px 12px;border:1px solid var(--line);border-radius:10px;background:rgba(34,211,238,.03);margin-bottom:12px;}
.rec-filters{display:inline-flex;gap:6px;align-items:center;flex-wrap:wrap;flex:1;min-width:0;}
.rec-filter-group{display:inline-flex;align-items:center;gap:4px;background:rgba(255,255,255,.04);border:1px solid var(--line);border-radius:7px;padding:2px 7px;height:26px;flex-shrink:0;}
.rec-filter-group .lbl{color:var(--recommend);font-size:8.5px;font-weight:800;letter-spacing:.06em;text-transform:uppercase;}
.rec-filter-group select{border:0;background:transparent;color:var(--txt);font-size:11px;outline:0;padding:0;cursor:pointer;max-width:260px;min-width:0;}
/* Nomes de lista são longos ("08 - Baixa_Relevancia (3509)"): sem isto o texto
   era cortado no meio da palavra dentro do select. */
.rec-filter-group select[data-lista-select]{max-width:min(420px,100%);text-overflow:ellipsis;}
.rec-mini-btn{font-size:10px;font-weight:700;color:var(--muted);background:rgba(255,255,255,.04);border:1px solid var(--line);border-radius:6px;padding:3px 7px;height:24px;}
.rec-stat-strip{display:inline-flex;align-items:center;gap:0;flex-wrap:wrap;border:1px solid var(--line);border-radius:8px;background:rgba(255,255,255,.02);padding:3px 4px;height:28px;}
.rec-stat-strip .rs-item{display:inline-flex;align-items:baseline;gap:5px;padding:0 10px;height:22px;line-height:22px;font-size:10.5px;color:var(--muted);}
.rec-stat-strip .rs-item b{font:500 14px/1 var(--font-display);color:var(--txt);}
.rec-stat-strip .rs-item.pending b{color:var(--recommend);}
.rec-stat-strip .rs-item.ok b{color:var(--ok);}
.rec-stat-strip .rs-item.warn b{color:var(--warn);}
.rec-stat-strip .rs-sep{width:1px;height:14px;background:var(--line2);align-self:center;}
.rec-list{display:flex;flex-direction:column;gap:10px;}
/* min-width:0 nas duas colunas: sem isso a coluna 1fr não cede e o texto
   comprido estica o card quando o trilho direito aperta a área. */
.rec-card{border:1px solid var(--line);border-left:3px solid var(--recommend);background:linear-gradient(160deg,rgba(34,211,238,.05),rgba(255,255,255,.01));border-radius:12px;padding:12px 14px;display:grid;grid-template-columns:minmax(0,1fr) auto;gap:14px;align-items:flex-start;overflow-wrap:anywhere;}
.rec-card>*{min-width:0;}
.rec-card.s-approved{border-left-color:var(--ok);background:linear-gradient(160deg,rgba(74,222,128,.06),rgba(255,255,255,.01));opacity:.85;}
.rec-card.s-rejected{border-left-color:var(--muted2);background:rgba(255,255,255,.01);opacity:.55;}
.rec-card.s-scheduled{border-left-color:var(--warn);background:linear-gradient(160deg,rgba(251,191,36,.06),rgba(255,255,255,.01));}
.rec-card .rc-head{display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-bottom:4px;}
.rec-card .rc-title{font-size:13.5px;font-weight:700;}
.rec-card .rc-action{font-size:12.5px;margin:5px 0;}
.rec-card .rc-meta{color:var(--muted);font-size:11px;display:flex;gap:10px;flex-wrap:wrap;align-items:center;margin-top:4px;}
.rec-card .rc-motivo{color:var(--recommend);font-size:11.5px;margin-top:7px;padding:6px 10px;background:var(--recommend-bg);border-radius:8px;border-left:2px solid var(--recommend);}
.rec-actions{display:flex;gap:6px;flex-wrap:wrap;justify-content:flex-end;align-items:center;min-width:200px;}
.rec-empty{padding:40px 20px;text-align:center;color:var(--muted);font-size:13px;border:1px dashed var(--line);border-radius:12px;}
.rec-empty strong{display:block;color:var(--txt);font-size:15px;font-weight:600;margin-bottom:6px;}

/* ============ CHAT ============ */
.chat-fab{position:fixed;right:20px;bottom:20px;background:var(--accent);color:#08090c;border-radius:999px;padding:11px 16px;font-weight:800;font-size:12.5px;box-shadow:0 12px 30px var(--accent-bg);display:flex;align-items:center;gap:8px;z-index:15;transition:background .3s,bottom .3s;}
body.footer-open .chat-fab{bottom:66px;}
.chat-panel{position:fixed;right:20px;bottom:80px;width:min(420px,calc(100vw - 40px));height:min(540px,70vh);background:var(--bg2);border:1px solid var(--line2);border-radius:16px;z-index:16;display:none;flex-direction:column;overflow:hidden;box-shadow:0 24px 60px rgba(0,0,0,.6);transition:bottom .3s;}
body.footer-open .chat-panel{bottom:120px;}
.chat-panel.open{display:flex;}
.chat-head{padding:14px 18px;border-bottom:1px solid var(--line);display:flex;justify-content:space-between;align-items:center;}
.chat-head strong{font-family:var(--font-display);font-size:16px;}
.chat-body{flex:1;overflow-y:auto;padding:16px 18px;display:flex;flex-direction:column;gap:10px;font-size:12.5px;}
.msg{padding:10px 12px;border-radius:12px;max-width:88%;line-height:1.5;}
.msg.me{background:var(--accent-bg);border:1px solid var(--accent-bd);align-self:flex-end;}
.msg.hermes{background:rgba(255,255,255,.04);border:1px solid var(--line);align-self:flex-start;}
.msg .ex{margin-top:8px;padding:8px 10px;border-radius:9px;background:rgba(0,0,0,.25);font-size:11.5px;display:flex;justify-content:space-between;align-items:center;gap:8px;}
.chat-foot{padding:12px 14px;border-top:1px solid var(--line);display:flex;gap:8px;}
.chat-foot input{flex:1;background:var(--panel);border:1px solid var(--line);color:var(--txt);border-radius:9px;padding:9px 12px;font-size:12.5px;outline:0;}

.form{display:grid;gap:12px;}
.form label{font-size:11px;color:var(--muted);display:block;}
/* Rótulo de configuração (Ajustes › Integrações) reaproveita o mesmo
   desenho do formulário, então o input nasce com o mesmo formato. */
.cfg-label{font-size:11px;color:var(--muted);display:block;margin-top:12px;}
.cfg-label input{display:block;width:100%;margin-top:5px;background:var(--panel);border:1px solid var(--line);color:var(--txt);border-radius:9px;padding:10px;font-size:12.5px;outline:0;font-family:inherit;}
.cfg-label input:focus{border-color:var(--accent);}
.form input,.form select,.form textarea{display:block;width:100%;margin-top:5px;background:var(--panel);border:1px solid var(--line);color:var(--txt);border-radius:9px;padding:10px;font-size:12.5px;outline:0;font-family:inherit;}
.form textarea{min-height:80px;resize:vertical;}
.form-row{display:grid;grid-template-columns:1fr 1fr;gap:10px;}
.form-actions{display:flex;gap:8px;justify-content:flex-end;margin-top:18px;padding-top:14px;border-top:1px solid var(--line);}
.form-hint{font-size:11px;color:var(--muted);line-height:1.5;margin-top:6px;}

/* Seções recolhíveis do menu (Workspace / Modo / Operação) */
.nav-label.clickable{cursor:pointer;user-select:none;justify-content:space-between;padding-right:8px;}
.nav-label.clickable:hover{color:var(--txt);}
.nav-label.clickable .caret{transition:transform .2s;opacity:.6;font-size:9px;}
.nav-label.clickable[aria-expanded="false"] .caret{transform:rotate(-90deg);}
.nav-section[hidden]{display:none;}
.nav-section .nav{margin-bottom:2px;}
/* Grupos do menu: apenas rotulam e separam. Botões e eventos não mudam. */
.nav-groups{gap:0;}
.nav-group{display:grid;gap:2px;margin-bottom:10px;}
.nav-group:last-child{margin-bottom:2px;}
.nav-group-label{color:var(--muted2);font-size:9.5px;font-weight:800;letter-spacing:.13em;text-transform:uppercase;padding:8px 12px 3px;opacity:.8;}

.toast{position:fixed;bottom:20px;left:20px;background:var(--accent);color:#08090c;padding:10px 14px;border-radius:10px;font-size:12px;font-weight:700;z-index:30;box-shadow:0 8px 30px rgba(0,0,0,.5);animation:tin .25s;}
@keyframes tin{from{transform:translateY(10px);opacity:0;}}

/* Dashboards */
.chart{display:flex;align-items:flex-end;gap:6px;height:120px;padding:8px 0;border-bottom:1px solid var(--line);}
.chart .col{flex:1;background:linear-gradient(180deg,var(--accent),transparent);border-radius:4px 4px 0 0;min-height:4px;position:relative;transition:.3s;}
.chart .col:hover{filter:brightness(1.3);}
.chart .col span{position:absolute;top:-18px;left:50%;transform:translateX(-50%);font-size:10px;color:var(--muted);white-space:nowrap;opacity:0;transition:.15s;}
.chart .col:hover span{opacity:1;}
.chart-labels{display:flex;gap:6px;padding-top:6px;}
.chart-labels div{flex:1;text-align:center;font-size:9.5px;color:var(--muted2);}
.heat-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:4px;}
.heat-grid .cell{aspect-ratio:1;border-radius:4px;background:rgba(255,255,255,.04);transition:.15s;}
.funnel{display:flex;flex-direction:column;gap:6px;}
.funnel .row{display:grid;grid-template-columns:120px 1fr auto;gap:12px;align-items:center;font-size:11.5px;}
.funnel .bar{height:22px;border-radius:5px;background:var(--accent-bg);border:1px solid var(--accent-bd);display:flex;align-items:center;padding:0 8px;font-size:10.5px;color:var(--accent);font-weight:600;}

/* Gantt / Sprint */
.gantt{display:grid;gap:4px;}
.gantt .grow{display:grid;grid-template-columns:180px repeat(14,1fr);gap:2px;align-items:center;padding:6px 0;border-bottom:1px solid var(--line);}
.gantt .grow .gname{font-size:11.5px;font-weight:600;}
.gantt .grow .gcell{height:22px;border-radius:4px;background:rgba(255,255,255,.03);}
.gantt .grow .gcell.on{background:var(--accent-bg);border:1px solid var(--accent-bd);}
.gantt .header{display:grid;grid-template-columns:180px repeat(14,1fr);gap:2px;font-size:9.5px;color:var(--muted2);text-align:center;padding-bottom:4px;border-bottom:1px solid var(--line);}

/* ============ EM EXECUÇÃO ============ */
.exec-status-bar{display:flex;gap:16px;align-items:center;flex-wrap:wrap;padding:14px 18px;border:1px solid var(--line);border-radius:12px;background:linear-gradient(160deg,rgba(224,184,120,.06),rgba(255,255,255,.01));margin-bottom:14px;}
.exec-status-bar .live{display:inline-flex;align-items:center;gap:9px;font-weight:800;font-size:12px;color:var(--ok);letter-spacing:.08em;}
.exec-status-bar .live .dot{width:9px;height:9px;background:var(--ok);box-shadow:0 0 0 4px rgba(74,222,128,.20);animation:execPulse 1.6s infinite;display:inline-block;border-radius:50%;}
@keyframes execPulse{0%,100%{box-shadow:0 0 0 4px rgba(74,222,128,.20)}50%{box-shadow:0 0 0 9px rgba(74,222,128,.05)}}
.exec-status-bar .metrics{display:flex;gap:16px;flex-wrap:wrap;font-size:12px;color:var(--muted);}
.exec-status-bar .metrics span{display:inline-flex;align-items:baseline;gap:5px;}
.exec-status-bar .metrics b{color:var(--txt);font-weight:500;font-family:var(--font-display);font-size:16px;margin-right:4px;}
.exec-status-bar .metrics .m-exec b{color:var(--info);}
.exec-status-bar .metrics .m-ok b{color:var(--ok);}
.exec-status-bar .metrics .m-wait b{color:var(--ai);}
.exec-status-bar .metrics .m-block b{color:var(--warn);}
.exec-status-bar .last{margin-left:auto;color:var(--muted2);font-size:11px;font-variant-numeric:tabular-nums;}

/* ---- Fila: um filtro só, em pílulas -----------------------------------
   Antes eram dois grupos (fonte x status) com 9 botões. Agora a escolha é
   o que importa na prática: qual grupo da fila eu quero ver. "Tudo" volta
   ao padrão, então nada fica escondido sem querer. */
.fila-filters{display:flex;gap:7px;flex-wrap:wrap;align-items:center;margin-bottom:14px;}
.pill{display:inline-flex;align-items:center;gap:7px;padding:7px 12px;border:1px solid var(--line);border-radius:999px;background:rgba(255,255,255,.02);font-size:11.5px;font-weight:700;color:var(--muted);transition:.14s;white-space:nowrap;}
.pill:hover{color:var(--txt);border-color:var(--muted2);}
.pill b{font-family:var(--font-display);font-size:13px;font-weight:600;color:var(--txt);font-variant-numeric:tabular-nums;}
.pill .dot{width:7px;height:7px;border-radius:50%;background:currentColor;flex:none;}
.pill.is-active{background:var(--accent);border-color:var(--accent);color:#08090c;}
.pill.is-active b{color:#08090c;}
.pill.tom-urgent{color:var(--urgent);}
.pill.tom-hot{color:var(--urgent);}
.pill.tom-warn{color:var(--warn);}
.pill.tom-info{color:var(--info);}
.pill.tom-ai{color:var(--ai);}
.pill.tom-ok{color:var(--ok);}
.pill.tom-accent{color:var(--accent);}
.pill.is-zero{opacity:.4;}

/* Painel da fila: foco do bloco, então ganha moldura própria. */
.fila-panel{border:1px solid var(--line);border-radius:14px;background:linear-gradient(165deg,rgba(224,184,120,.05),rgba(255,255,255,.008));padding:16px 18px;margin-bottom:6px;}
.fila-grupo{margin-top:16px;}
.fila-grupo:first-of-type{margin-top:12px;}
.fila-grupo-head{display:flex;align-items:center;gap:9px;margin-bottom:9px;padding-bottom:7px;border-bottom:1px solid var(--line);}
.fila-grupo-head .nome{font-size:10.5px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);}
.fila-grupo-head .n{font-family:var(--font-display);font-size:15px;font-weight:600;margin-left:2px;}
.fila-grupo-head .regra{flex:1;height:1px;background:var(--line);}

/* Agenda: o que o relógio vai fazer nas próximas horas. */
.agenda-item{display:grid;grid-template-columns:74px 1fr auto;gap:12px;align-items:center;padding:10px 0;border-bottom:1px solid var(--line);}
.agenda-item:last-child{border-bottom:0;}
.agenda-quando{font-size:11.5px;font-variant-numeric:tabular-nums;color:var(--muted);text-align:right;}
.agenda-quando .em{font-weight:700;color:var(--txt);display:block;font-size:12.5px;}
.agenda-quando .abs{color:var(--muted2);font-size:10.5px;}
.agenda-o{font-size:12.5px;font-weight:600;overflow-wrap:anywhere;}
.agenda-meta{display:flex;gap:7px;flex-wrap:wrap;align-items:center;margin-top:3px;}
.agenda-mini{font-size:11px;color:var(--warn);font-variant-numeric:tabular-nums;white-space:nowrap;font-weight:600;}
.agenda-vazia{color:var(--muted2);font-size:12px;padding:14px 0;}

/* Atualização ao vivo sem re-render: só o texto que muda. */
@media(prefers-reduced-motion:no-preference){
  [data-live] .live-dot{animation:execPulse 1.6s infinite;}
}

/* Histórico recolhido: a sessão é sobre o que vai acontecer, não sobre o
   que já aconteceu. O detalhe fica a um clique. */
.hist-box{border:1px solid var(--line);border-radius:12px;background:rgba(255,255,255,.015);overflow:hidden;}
.hist-box>summary{cursor:pointer;padding:12px 16px;font-size:12px;font-weight:700;color:var(--muted);list-style:none;display:flex;align-items:center;gap:9px;user-select:none;}
.hist-box>summary::-webkit-details-marker{display:none;}
.hist-box>summary::before{content:'▸';font-size:10px;transition:.15s;display:inline-block;}
.hist-box[open]>summary::before{transform:rotate(90deg);}
.hist-box>summary:hover{color:var(--txt);background:rgba(255,255,255,.02);}
.hist-body{padding:0 14px 14px;}

/* Par rótulo/valor curto nos cartões de ação. */
.kv-mini{display:flex;align-items:baseline;gap:8px;font-size:11px;color:var(--muted2);flex-wrap:wrap;}
.kv-mini b{color:var(--txt);font-weight:600;font-size:12px;}

.timeline{position:relative;display:flex;flex-direction:column;}
.timeline::before{content:'';position:absolute;left:82px;top:6px;bottom:6px;width:1px;background:var(--line);}
.tl-item{position:relative;border-bottom:1px solid var(--line);transition:.12s;}
.tl-item:last-child{border-bottom:0;}
.tl-item:hover{background:rgba(255,255,255,.015);}
.tl-head{display:grid;grid-template-columns:68px 28px 1fr 18px;gap:12px;align-items:flex-start;padding:13px 10px;cursor:pointer;}
.tl-time{font-size:11px;color:var(--muted);font-variant-numeric:tabular-nums;padding-top:5px;}
.tl-icon{width:28px;height:28px;border-radius:9px;display:grid;place-items:center;font-size:13px;background:rgba(255,255,255,.05);border:1px solid var(--line);color:var(--accent);position:relative;z-index:1;}
.tl-item.status-EXECUTANDO .tl-icon{background:var(--info-bg);border-color:var(--info-bd);color:var(--info);animation:execPulse 1.6s infinite;}
.tl-item.status-CONCLUÍDO .tl-icon{background:var(--ok-bg);border-color:var(--ok-bd);color:var(--ok);}
.tl-item.status-BLOQUEADO .tl-icon{background:var(--warn-bg);border-color:var(--warn-bd);color:var(--warn);}
.tl-item.status-AGUARDANDO .tl-icon{background:var(--ai-bg);border-color:var(--ai-bd);color:var(--ai);}
.tl-body{min-width:0;padding-top:1px;}
.tl-agente{font-size:10px;color:var(--muted2);font-weight:800;letter-spacing:.08em;text-transform:uppercase;margin-bottom:3px;}
.tl-acao{font-size:13px;color:var(--txt);font-weight:600;}
.tl-resumo{font-size:12.5px;color:var(--muted);margin-top:3px;line-height:1.5;}
.tl-resultado{font-size:12px;color:var(--accent);margin-top:4px;}
.tl-chevron{color:var(--muted2);font-size:10px;padding-top:8px;transition:.15s;text-align:center;}
.tl-item.expanded .tl-chevron{transform:rotate(90deg);color:var(--accent);}
.tl-item:not(.has-details) .tl-chevron{opacity:0;}

.tl-expand{display:none;padding:2px 14px 18px 118px;animation:tlFade .18s ease;}
.tl-item.expanded .tl-expand{display:block;}
@keyframes tlFade{from{opacity:0;transform:translateY(-4px)}to{opacity:1;transform:none}}

.tl-expand .sec-mini{font-size:9.5px;font-weight:800;letter-spacing:.12em;text-transform:uppercase;color:var(--muted2);margin:16px 0 6px;}
.tl-expand .sec-mini:first-child{margin-top:0;}
.tl-expand .obj{font-size:12.5px;color:var(--txt);line-height:1.55;}
.tl-expand ul.criterios{margin:0;padding-left:16px;font-size:12px;color:var(--muted);}
.tl-expand ul.criterios li{margin-bottom:3px;}
.tl-expand .progress-line{display:flex;align-items:center;gap:12px;font-size:12px;color:var(--muted);}
.tl-expand .progress-line .progress{flex:1;height:6px;}
.tl-expand .resultados-parciais{display:flex;gap:8px;flex-wrap:wrap;margin-top:4px;}
.tl-expand .resultados-parciais .rp{padding:7px 11px;border-radius:9px;border:1px solid var(--line);background:rgba(255,255,255,.02);font-size:11.5px;color:var(--muted);}
.tl-expand .resultados-parciais .rp b{font-family:var(--font-display);font-size:16px;margin-right:6px;color:var(--txt);font-weight:500;}
.tl-expand .resultados-parciais .rp.ok b{color:var(--ok);}
.tl-expand .resultados-parciais .rp.warn b{color:var(--warn);}
.tl-expand .resultados-parciais .rp.muted b{color:var(--muted);}

.exec-chain{display:flex;flex-direction:column;gap:2px;}
.exec-chain .step{display:grid;grid-template-columns:118px 1fr;gap:12px;align-items:center;font-size:12px;padding:8px 12px;border-radius:9px;background:rgba(255,255,255,.025);border-left:2px solid var(--accent);}
.exec-chain .step .lbl{font-size:9.5px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;color:var(--accent);}
.exec-chain .step .val{color:var(--txt);}
.exec-chain .arrow{color:var(--muted2);font-size:11px;text-align:center;line-height:1;padding:1px 0;}

.steps-list{display:flex;flex-direction:column;gap:6px;margin-top:4px;}
.steps-list .step-row{display:flex;align-items:center;gap:10px;font-size:12.5px;color:var(--muted);}
.steps-list .step-row .st{width:14px;text-align:center;font-size:12px;}
.steps-list .step-row.done .st{color:var(--ok);}
.steps-list .step-row.done{color:var(--txt);}
.steps-list .step-row.running .st{color:var(--info);}
.steps-list .step-row.running{color:var(--txt);font-weight:600;}
.steps-list .step-row.pending{color:var(--muted2);}

.tl-expand .detail-actions{display:flex;gap:8px;margin-top:16px;flex-wrap:wrap;}

.hermes-panel{display:flex;flex-direction:column;gap:14px;}
.hermes-panel .hp-section{border:1px solid var(--line);border-radius:12px;padding:14px;background:linear-gradient(160deg,rgba(255,255,255,.03),rgba(255,255,255,.005));}
.hermes-panel .hp-title{font-size:10px;font-weight:800;letter-spacing:.14em;text-transform:uppercase;color:var(--accent);margin-bottom:10px;display:flex;justify-content:space-between;align-items:center;}
.hermes-panel .hp-title span{color:var(--muted);font-weight:600;letter-spacing:0;text-transform:none;font-size:10.5px;}
.hermes-panel .hp-row{display:flex;flex-direction:column;gap:6px;padding:9px 0;border-bottom:1px solid var(--line);}
.hermes-panel .hp-row:last-child{border-bottom:0;padding-bottom:0;}
.hermes-panel .hp-row .lbl{font-size:12px;color:var(--txt);display:flex;justify-content:space-between;align-items:baseline;}
.hermes-panel .hp-row .lbl .num{font-size:10.5px;color:var(--muted);font-variant-numeric:tabular-nums;}
.hermes-panel .hp-row .progress{height:5px;}
.hermes-panel .hp-next .titulo{font-size:13.5px;font-weight:700;color:var(--txt);}
.hermes-panel .hp-next .alvo{font-size:11.5px;color:var(--muted);margin-top:2px;}
.hermes-panel .hp-next .kv-mini{display:flex;justify-content:space-between;gap:10px;font-size:11.5px;padding:8px 0;border-top:1px solid var(--line);margin-top:10px;}
.hermes-panel .hp-next .kv-mini:first-of-type{margin-top:14px;}
.hermes-panel .hp-next .kv-mini span{color:var(--muted2);}
.hermes-panel .hp-next .kv-mini b{color:var(--txt);font-weight:600;text-align:right;}

.flow-chain{display:flex;flex-direction:column;align-items:center;gap:3px;font-size:10.5px;font-weight:800;letter-spacing:.1em;}
.flow-chain .fc{padding:7px 14px;border-radius:8px;border:1px solid var(--line);background:rgba(255,255,255,.02);color:var(--muted);min-width:140px;text-align:center;}
