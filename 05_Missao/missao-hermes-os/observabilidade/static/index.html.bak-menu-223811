   </div>
 </div>
 <div class="tabs" id="tabs"></div>


 <div class="pn">
   <h2 id="ptitle"></h2>
   <div class="pb" id="pbody"></div>
 </div>
 <div class="ft">
   <div class="it"><span class="dot" id="fd-l"></span> LiteLLM <span class="mo">:4000</span></div>
