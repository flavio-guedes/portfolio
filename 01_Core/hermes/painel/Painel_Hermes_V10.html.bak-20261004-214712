  }
  const imp=state.meta.importedCount;
  const srcLabel=imp?`${imp} importadas`:(state.meta.source==='mock'?'Fonte: MOCK':'Fonte: API');
  const dotCls=imp?'ok':'warm';
  html+=`<div class="side-foot">
    <strong><span class="dot ${dotCls}"></span>${imp?'Base real':'Protótipo'}</strong>
    <span>${srcLabel}</span><br><span>Leitura: ${esc(fmtTime(state.meta.syncedAt))}</span>
  </div></div>
  <div class="sidebar-resizer" id="sidebarResizer"></div>`;
  $('#sidebar').innerHTML=html;
  attachModeNavEvents('#sidebar');
  attachFilterEvents('#sidebar');
  $$('#sidebar [data-toggle-section]').forEach(h=>{
    h.addEventListener('click',()=>toggleNavSection(h.dataset.toggleSection));
    h.addEventListener('keydown',e=>{ if(e.key==='Enter'||e.key===' '){ e.preventDefault(); toggleNavSection(h.dataset.toggleSection); } });
  });
  initSidebarResizer();
}
function initSidebarResizer(){
  const r=$('#sidebarResizer'); if(!r) return;
  let resizing=false,startX=0,startW=0;
  const onMove=e=>{ if(!resizing) return;
    const w=Math.max(180,Math.min(420,startW+(e.clientX-startX)));
    document.body.style.setProperty('--left-w',w+'px');
  };
  const onUp=()=>{ if(!resizing) return; resizing=false; r.classList.remove('dragging');
    document.body.style.cursor=''; document.body.style.userSelect='';
    const w=parseInt(getComputedStyle(document.body).getPropertyValue('--left-w'))||240;
    userCfg.layout.leftWidth=w; userCfg.layout.leftCollapsed=false;
    saveConfig(); applyAppearance();
    document.removeEventListener('mousemove',onMove); document.removeEventListener('mouseup',onUp);
