(function(){
  var URL='http://127.0.0.1:8440/api/campanhas';
  var cache=null;
  function esc(v){return String(v==null?'':v).replace(/[&<>"']/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];});}
  function carregar(){
    return fetch(URL,{cache:'no-store'}).then(function(r){return r.json();})
      .then(function(d){cache=d||[];return cache;})
      ['catch'](function(e){cache=[];cache.__erro=String(e.message||e);return cache;});
  }
  function tone(s){s=String(s||'').toLowerCase();if(s==='ativa')return'ok';if(s==='pausada')return'warn';if(s==='encerrada')return'';return'info';}
  function card(c){
    var t=tone(c.status), canal=String(c.canal||'').toLowerCase();
    var cor=canal==='whatsapp'?'var(--ok)':canal==='email'?'var(--info)':'var(--muted)';
    var msgs=c.mensagens?Object.keys(c.mensagens).length:0;
    var h='<div class="card left-'+t+'" style="padding:12px;margin-bottom:8px">';
    h+='<div style="display:flex;justify-content:space-between;align-items:flex-start;gap:10px;margin-bottom:6px;flex-wrap:wrap"><div style="min-width:0">';
    h+='<div style="display:flex;align-items:center;gap:8px;margin-bottom:2px"><span style="font-family:var(--font-display);font-size:15px;font-weight:700;color:'+cor+'">'+esc(c.id)+'</span><span style="font-size:13px;font-weight:600">'+esc(c.nome)+'</span></div>';
    h+='<div class="sub" style="font-size:11px">'+esc(c.nicho||'')+'</div></div>';
    h+='<span class="badge '+t+'">'+esc(c.status||'?')+'</span></div>';
    h+='<div style="display:flex;flex-wrap:wrap;gap:6px 14px;font-size:11px;color:var(--muted);margin-bottom:6px">';
    if(c.canal)h+='<span>Canal <b style="color:'+cor+'">'+esc(c.canal)+'</b></span>';
    if(c.meta_leads)h+='<span>Meta <b style="color:var(--txt)">'+c.meta_leads+' leads</b></span>';
    if(c.cadencia_min!==undefined)h+='<span>Cadência <b style="color:var(--txt)">'+(c.cadencia_min===0?'manual':c.cadencia_min+' min')+'</b></span>';
    if(c.inicio)h+='<span>Início <b style="color:var(--txt)">'+esc(c.inicio)+'</b></span>';
    if(c.fim)h+='<span>Fim <b style="color:var(--txt)">'+esc(c.fim)+'</b></span>';
    if(msgs)h+='<span>Mensagens <b style="color:var(--txt)">'+msgs+'</b></span>';
    h+='</div>';
    if(c.publico)h+='<div class="sub" style="font-size:11px;margin-bottom:4px">Público: '+esc(c.publico)+'</div>';
    if(c.tese)h+='<div class="sub" style="font-size:11px;color:var(--recommend)">Tese: '+esc(c.tese)+'</div>';
    if(c.mensagens){
      var et=Object.keys(c.mensagens).sort();
      h+='<details style="margin-top:10px;border-top:1px solid var(--line);padding-top:8px"><summary class="sub" style="cursor:pointer;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.08em">Ver mensagens ('+et.length+')</summary>';
      et.forEach(function(k){
        var m=c.mensagens[k];
        h+='<div style="margin-top:10px;padding:10px 12px;background:rgba(255,255,255,.03);border-left:2px solid var(--info);border-radius:0 6px 6px 0">';
        h+='<div style="font-size:10px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;color:var(--info);margin-bottom:4px">'+esc(k)+'</div>';
        if(m.assunto)h+='<div style="font-size:12px;font-weight:600;margin-bottom:2px">'+esc(m.assunto)+'</div>';
        if(m.preview)h+='<div class="sub" style="font-size:10.5px;font-style:italic;margin-bottom:6px">'+esc(m.preview)+'</div>';
        if(m.corpo)h+='<div style="font-size:11.5px;line-height:1.55;white-space:pre-wrap;color:var(--muted)">'+esc(m.corpo)+'</div>';
        h+='</div>';
      });
      h+='</details>';
    }
    h+='</div>';
    return h;
  }
  function bloco(){
    if(cache&&cache.__erro)return '<div class="card left-risk" style="padding:12px"><div style="font-size:12px;color:var(--urgent)">Servidor de campanhas offline</div><div class="sub" style="margin-top:4px">Rode: python3 /Users/mac/hermes/painel/serve-campanhas.py</div></div>';
    if(!cache)return '<div class="card" style="padding:12px"><div class="sub">Carregando campanhas…</div></div>';
    var w=[],e=[],o=[];
    cache.forEach(function(c){var cc=String(c.canal||'').toLowerCase();if(cc==='whatsapp')w.push(c);else if(cc==='email')e.push(c);else o.push(c);});
    var h='<div class="card left-accent" style="padding:14px 16px;margin-bottom:14px"><div style="display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap">';
    h+='<div><div class="eyebrow" style="margin-bottom:2px">Campanhas do Hermes-work</div>';
    h+='<div style="font-family:var(--font-display);font-size:16px;font-weight:700">'+cache.length+' campanha(s)</div>';
    h+='<div class="sub" style="font-size:11px">WhatsApp '+w.length+' · E-mail '+e.length+' · Outros '+o.length+'</div></div>';
    h+='<button class="btn sm" data-camp-reload>↻ Recarregar</button></div></div>';
    if(w.length){h+='<div class="op-head" style="margin-top:16px"><h2>WhatsApp</h2><span class="sub">'+w.length+'</span></div>';w.forEach(function(c){h+=card(c);});}
    if(e.length){h+='<div class="op-head" style="margin-top:16px"><h2>E-mail</h2><span class="sub">'+e.length+'</span></div>';e.forEach(function(c){h+=card(c);});}
    if(o.length){h+='<div class="op-head" style="margin-top:16px"><h2>Outros</h2><span class="sub">'+o.length+'</span></div>';o.forEach(function(c){h+=card(c);});}
    return h;
  }
  function injetar(){
    if(typeof state==='undefined'||state.view!=='fila')return;
    var c=document.getElementById('content');if(!c)return;
    var alvo=c.querySelector('section.view');if(!alvo)return;
    var antigo=alvo.querySelector('[data-camp-block]');
    var tmp=document.createElement('div');tmp.innerHTML=bloco();
    var b=tmp.firstChild;b.setAttribute('data-camp-block','1');
    if(antigo)antigo.replaceWith(b);
    else{var k=alvo.querySelector('.op-kpis');if(k&&k.parentNode)k.parentNode.insertBefore(b,k.nextSibling);else alvo.insertBefore(b,alvo.firstChild);}
  }
  function iniciar(){carregar().then(injetar);setInterval(function(){if(!cache)carregar().then(injetar);},30000);setInterval(injetar,600);}
  document.addEventListener('click',function(ev){
    if(ev.target.closest('[data-camp-reload]')){ev.preventDefault();ev.stopPropagation();cache=null;carregar().then(injetar);return;}
  },true);
  iniciar();
})();
