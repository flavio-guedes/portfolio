   "u:<id>" foi criada pelo usuário no painel. */
function buildListIndex(){
  const segs={};
  state.opportunities.forEach(o=>{ const k=o.lista_v2||o.segmento||'—'; if(!segs[k]) segs[k]=[]; segs[k].push(o); });
  const entries=Object.keys(segs).map(k=>({key:'b:'+k,label:k,list:segs[k],user:false}));
  userLists().forEach(l=>{
    entries.push({key:'u:'+l.id,label:l.nome,list:userListMembers(l),user:true,def:l});
  });
  /* Listas do usuário primeiro, depois a base por tamanho. */
  entries.sort((a,b)=>(a.user===b.user)?(b.list.length-a.list.length):(a.user?-1:1));
  return entries;
}
