    criadaEm:new Date().toISOString()
  };
  if(sugerida) c.motivo=String(fd.get('objetivo')||'').trim()||'Criada manualmente · aguardando avaliação';

  /* Edição: preserva id, métricas, criação e o que já foi enviado. Só o que
     o usuário mudou entra. Sem isso, salvar de novo zeraria o histórico. */
  const editId=String(form.dataset.editId||'').trim();
  if(editId){
    const store=loadUserStore();
    const alvo=store.campanhas.find(x=>x.id===editId);
    if(!alvo){ toast('Campanha não encontrada'); closeBackdrop(); return; }
    const listaMudou=alvo.lista!==c.lista;
    const mudouAlvo=JSON.stringify(alvo.publico||{})!==JSON.stringify(c.publico);
    Object.assign(alvo,{
      nome:c.nome,objetivo:c.objetivo,responsavel:c.responsavel,periodo:c.periodo,
      status:executar?'EM EXECUÇÃO':c.status,
      lista:c.lista,publico:c.publico,oferta:c.oferta,canais:c.canais,etapas:c.etapas,
      cadencia:c.cadencia,estilo:c.estilo,
      mensagem:c.mensagem||alvo.mensagem,
      volume_dia:c.volume_dia,agendada_em:c.agendada_em,nota:c.nota
    });
    saveUserStore(store);
    const naMemoria=state.campaigns.find(x=>x.id===editId);
    if(naMemoria) Object.assign(naMemoria,alvo);
    /* Se a origem mudou, entram só os contatos que ainda não estão na fila. */
    const criadas=(listaMudou||mudouAlvo)?gerarAcoesDaCampanha(alvo):0;
    closeBackdrop();
    setView('execucao'); render();
    toast(criadas?`Campanha atualizada · ${criadas} contato(s) novos na fila`:'Campanha atualizada');
    if(executar) runDisparo(alvo,true).then(res=>{ toast(res.texto); render(); });
    return;
  }

  const store=loadUserStore();
  store.campanhas.push(c);
  saveUserStore(store);
  state.campaigns.push(c);
  /* Gerar as ações é o que transforma "campanha" em trabalho real. Sem
     isso a campanha existe no papel e a fila nunca anda. */
  const criadas=gerarAcoesDaCampanha(c);
  closeBackdrop();
  setView('campanhas');
  render();
  if(executar){
    runDisparo(c,true).then(res=>{
      toast(res.texto);
    });
  }else{
    toast((sugerida?'Sugestão salva: ':'Campanha criada: ')+c.nome+' · '+criadas+' ação(ões) na fila');
  }
}
/* Cria uma ação por contato, respeitando o limite por dia. */
function gerarAcoesDaCampanha(c){
  const alvo=campTargets(c);
  const jaExiste=new Set(acoesDaCampanha(c.id).map(a=>String(a.opportunity_id)));
  const onda=alvo.filter(o=>!jaExiste.has(String(o.id)));
  const ondaComTel=onda.filter(o=>normalizeBR(o.telefone));
  const pool=c.canais.includes('WhatsApp')&&c.canais.length===1
    ? (ondaComTel.length?ondaComTel:onda)
    : onda;
  const primeiraOnda=pool.slice(0,Math.max(1,c.volume_dia||30));
  const etapas=c.etapas.length?c.etapas:['Abordar'];
  let criadas=0;
  primeiraOnda.forEach((o,i)=>{
    const ac={
      id:'ACT-'+c.id+'-'+o.id,
      opportunity_id:o.id,campaign_id:c.id,
      contato:o.contato||o.empresa,empresa:o.empresa,
      canal:c.canais.includes('WhatsApp')?'WhatsApp':c.canais[0],
      etapa:etapas[0]||'Abordar',
      acao:'Primeiro contato · '+(c.estilo||'Direto'),
      prazo:c.agendada_em||new Date().toISOString().slice(0,16),
      prioridade:'Média',prioridade_fila:2,
      status:c.agendada_em?'AGENDADO':'PRONTO'
    };
    upsertAction(ac);
    criadas++;
  });
  /* As ondas seguintes da cadência entram como ações separadas, para o
     painel mostrar o que ainda falta em vez de um número solto. */
  const toques=String(c.cadencia||'').match(/D(\d+)/g);
  if( toques&&toques.length>1 ){
    pool.slice(Math.max(1,c.volume_dia||30)).forEach((o,i)=>{
      const dias=toques.map(x=>parseInt(x.slice(1),10)).sort((a,b)=>a-b);
      const passo=dias[Math.min(i+1,dias.length-1)];
      const ac={
        id:'ACT-'+c.id+'-'+(i+1)+'-'+o.id,
        opportunity_id:o.id,campaign_id:c.id,
        contato:o.contato||o.empresa,empresa:o.empresa,
        canal:c.canais.includes('WhatsApp')?'WhatsApp':c.canais[0],
        etapa:etapas[1]||etapas[0]||'Follow-up',
        acao:'Cadência D'+passo+' · '+(c.estilo||'Direto'),
        prazo:new Date(Date.now()+passo*86400000).toISOString().slice(0,16),
        prioridade:'Média',prioridade_fila:4,
        status:'AGENDADO'
      };
      upsertAction(ac);
    });
  }
  return criadas;
}
