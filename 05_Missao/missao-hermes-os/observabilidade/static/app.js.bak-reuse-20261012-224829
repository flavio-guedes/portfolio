      for (var y=0;y<cards.length;y++){
        cards[y].style.borderColor = (parseInt(cards[y].getAttribute('data-fase'))===idx)
          ? 'rgba(77,163,255,.7)' : 'rgba(255,255,255,.06)';
      }
      var chevs = document.querySelectorAll('.esc-chev');
      for (var z=0;z<chevs.length;z++) chevs[z].style.transform = '';
      if (chevs[idx]) chevs[idx].style.transform = 'rotate(90deg)';

      // rola até o dropdown se não estiver visível
      try { drop.scrollIntoView({behavior:'smooth', block:'nearest'}); } catch(e){}
    }

    // click nos cards
    var cards = document.querySelectorAll('.esc-card');
    for (var i=0;i<cards.length;i++){
      cards[i].addEventListener('click', (function(idx){
        return function(){
          if (abertos === idx) { fechar(); }
          else { abrir(idx); }
        };
      })(parseInt(cards[i].getAttribute('data-fase'))));
    }

    // botão fechar
    dropClose.addEventListener('click', fechar);

    // alertas de escala
    fetch('/api/alerts?tipo=escala&limit=5', {cache:'no-store'})
      .then(function(r){ if (!r.ok) throw 0; return r.json(); })
      .then(function(arr){
        var box = document.getElementById('esc-alertas'); if (!box) return;
        if (!arr || !arr.length){ box.innerHTML = '<div style="color:#cce4ff">▶ Nenhuma sugestão nova ainda</div>'; return; }
        box.innerHTML = arr.slice(-5).map(function(a){
          return '<div style="padding:3px 0;color:#cce4ff">▶ '+(a.msg||'')+'</div>';
        }).join('');
      })
      .catch(function(){
        var box = document.getElementById('esc-alertas'); if (!box) return;
        box.innerHTML = '<div style="padding:3px 0;color:#cce4ff">▶ Fase 4: acumulando amostras para v11 preditiva</div>'
                      + '<div style="padding:3px 0;color:#cce4ff">▶ Fase 2: hora de integrar leads + campanhas (só local)</div>';
      });
  }, 50);

  return h;
}

