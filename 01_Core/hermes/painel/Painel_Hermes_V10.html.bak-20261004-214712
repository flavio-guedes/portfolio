/* Título da base que originou a campanha. Sem lista, é a base geral. */
function campBaseLabel(c){
  if(c.lista&&c.lista!=='base'){
    const l=userLists().find(x=>x.id===c.lista);
    if(l) return l.nome;
    return 'Lista removida';
  }
  const pub=c.publico||{};
  const alvo=[pub.segmento,pub.cargo,pub.localizacao].filter(Boolean).join(' · ');
  return 'Base geral'+(alvo&&alvo!=='Multi · Decisor · BR'?' · '+alvo:'');
}

/* =====================================================================
   LEADS DA CAMPANHA
   Une quem foi ligado à campanha (campaign_id) com a lista de origem
   (lista do usuário ou base filtrada pelo público). A situação de cada
   lead é derivada das ações da campanha — nada é guardado à parte.
   ===================================================================== */
const CL_SIT=[
  {id:'sem',   label:'Sem ação',  tone:''},
  {id:'fila',  label:'Na fila',   tone:'info'},
  {id:'env',   label:'Enviado',   tone:'ok'},
  {id:'resp',  label:'Respondeu', tone:'hot'},
  {id:'prob',  label:'Problema',  tone:'urgent'}
];
function campLeadsAll(c){
  const m=new Map();
  state.opportunities.forEach(o=>{ if(o.campaign_id===c.id) m.set(o.id,o); });
  campTargets(c).forEach(o=>{ if(o&&!m.has(o.id)) m.set(o.id,o); });
  /* Contatos que já têm ação nesta campanha mas não estão na base carregada
     (ex.: leads cadastrados direto na fila). Entram com o que a ação sabe deles. */
  acoesDaCampanha(c.id).forEach(a=>{
    const key=a.opportunity_id||('ACT:'+a.id);
    if(m.has(key)) return;
    const o=oppOf(a.opportunity_id);
    if(o){ m.set(key,o); return; }
    m.set(key,{id:key,empresa:a.contato,contato:a.contato,estagio:a.etapa,proxima_acao:a.acao,
      descricao:a.canal,_acaoId:a.id});
  });
  return [...m.values()];
}
function campLeadSituacao(c,acts,o,convEmp){
  const mine=acts.get(o.id)||[];
  if(mine.some(a=>a.status==='RESPONDIDO')||convEmp.has(o.empresa)) return 'resp';
  if(mine.some(a=>a.status==='ERRO'||a.status==='BLOQUEADO')) return 'prob';
  if(mine.some(a=>['ENVIADO','CONCLUÍDO'].includes(a.status))) return 'env';
  if(mine.some(a=>['PRONTO','AGENDADO','EXECUTANDO','REAGENDADO'].includes(a.status))) return 'fila';
  return 'sem';
}
function campLeadsState(id){
  state.campLeads=state.campLeads||{};
  return state.campLeads[id]||(state.campLeads[id]={q:'',f:'all',n:25});
}
function campLeadsHTML(c){
  const st=campLeadsState(c.id);
  const all=campLeadsAll(c);
  const acts=new Map();
  acoesDaCampanha(c.id).forEach(a=>{ (acts.get(a.opportunity_id)||acts.set(a.opportunity_id,[]).get(a.opportunity_id)).push(a); });
  const convEmp=new Set(liveConversations().filter(x=>x.campaign_id===c.id).map(x=>x.empresa));
  const rows=all.map(o=>({o,sit:campLeadSituacao(c,acts,o,convEmp)}));
  const cnt={}; CL_SIT.forEach(x=>cnt[x.id]=0); rows.forEach(r=>cnt[r.sit]++);
  const q=st.q.trim().toLowerCase();
  const vis=rows.filter(r=>{
    if(st.f!=='all'&&r.sit!==st.f) return false;
    if(!q) return true;
    const o=r.o;
    return [o.empresa,o.contato,o.descricao,o.segmento,o.email].join(' ').toLowerCase().includes(q);
  }).sort((a,b)=>(b.o.score||0)-(a.o.score||0));
  const base=(!c.lista||c.lista==='base')&&all.length===state.opportunities.length&&all.length>200;
  return `<div class="cl-wrap" data-camp-leads="${esc(c.id)}">
    <div class="cl-head">
      <h4>Leads da lista</h4>
      <span class="sub">${all.length} no total · origem: ${esc(campBaseLabel(c))}${base?' (sem filtro de público: base inteira)':''}</span>
      <input class="cl-search" data-cl-q="${esc(c.id)}" placeholder="Buscar empresa, contato, cargo, e-mail…" value="${esc(st.q)}" aria-label="Buscar leads">
    </div>
    <div class="cl-pills">
      <button class="pill ${st.f==='all'?'is-active':'tom-accent'}" data-cl-f="all" data-cl-id="${esc(c.id)}">Todos <b>${all.length}</b></button>
      ${CL_SIT.map(x=>`<button class="pill ${st.f===x.id?'is-active':'tom-accent'} ${cnt[x.id]?'':'is-zero'}" data-cl-f="${x.id}" data-cl-id="${esc(c.id)}">${x.label} <b>${cnt[x.id]}</b></button>`).join('')}
    </div>
    <div data-cl-body="${esc(c.id)}">${campLeadsBodyHTML(c,vis,st)}</div>
  </div>`;
}
function campLeadsBodyHTML(c,vis,st){
  if(!vis.length) return `<div class="op-empty">Nenhum lead com esse filtro.</div>`;
  const sitOf=id=>CL_SIT.find(x=>x.id===id);
  return vis.slice(0,st.n).map(({o,sit})=>{
    const s0=sitOf(sit);
    const canais=[o.linkedin_url&&'LinkedIn',o.email&&'E-mail',(o.whatsapp||o.telefone)&&'WhatsApp'].filter(Boolean).join(' · ');
