PALAVRAS_NAO = [
    "não quero","nao quero","sem interesse","não é o momento","nao e o momento",
    "não precisa","nao precisa","depois","agora não","agora nao","ocupado",
    "sem tempo","fora do perfil","não trabalho","nao trabalho","já resolvi",
    "ja resolvi","obrigado","obg","valeu","não faz sentido","nao faz sentido",
    "deixa pra lá","deixa pra la","tira meu contato","não me chame"
]

def detectar_despedida():
    """Lê /messages e marca como DESPEDIDA quem respondeu negativamente."""
    try:
        r = urllib.request.urlopen(BRIDGE+"/messages", timeout=5)
        msgs = json.loads(r.read().decode())
    except: return 0
    d = load(FILA)
    if not d: return 0
    respostas = {}
    for m in msgs[-800:]:
        if m.get("fromMe"): continue
        jid = (m.get("chatId") or m.get("senderId") or "")
        tel = jid.replace("@s.whatsapp.net","").replace("@c.us","").replace("+","").strip()
        txt = (m.get("text") or m.get("message") or "").lower()
        if tel and txt: respostas[tel] = txt
    marcados = 0
    for i in d["itens"]:
        tel = i["telefone"].replace("+","").strip()
        if tel in respostas:
            txt = respostas[tel]
            if any(p in txt for p in PALAVRAS_NAO):
                if i["status"] not in ("DESPEDIDA","BLOQUEADO"):
                    i["status"] = "DESPEDIDA"
                    i["erro"] = f"resposta negativa: {txt[:60]}"
                    i["despedida_em"] = now()
                    marcados += 1
    if marcados: save(FILA, d)
    return marcados

def adicionar_menor_cadencia(n=30, gap=GAP_BASE):
    """Adiciona N leads com cadência menor (4min) no fim da fila. Tipo 'base' (amarelo)."""
    leads = load(LEADS) or []
    if not leads: return 0
    d = load(FILA) or {"itens":[], "total":0, "novos":0, "base":0}
    ja_na_fila = set(i["telefone"].replace("+","") for i in d["itens"])
    ja_env = _ja_enviados()
    disp = [l for l in leads
            if l["telefone"].replace("+","") not in ja_na_fila
            and l["telefone"].replace("+","") not in ja_env]
    disp.sort(key=lambda l:(-l.get("score_composto",0), -l.get("score",0)))
    sel = disp[:n]
    if not sel: return 0
    # continua a partir do último prazo agendado
    agendados = [i for i in d["itens"] if i.get("status")=="AGENDADO"]
    if agendados:
        try:
            ult = max(datetime.strptime(i["prazo"],"%Y-%m-%d %H:%M:%S") for i in agendados)
            cur = ult + timedelta(minutes=gap)
        except:
            cur = datetime.now() + timedelta(minutes=5)
    else:
        cur = datetime.now() + timedelta(minutes=5)
    cur = cur.replace(second=0, microsecond=0)
    c = 0
    for l in sel:
        d["itens"].append({
            "id": f"M{c+1:03d}",
            "nome":l["nome"],"empresa":l["empresa"],"telefone":l["telefone"],
            "chatId":l["telefone"]+"@s.whatsapp.net",
            "tipo":"base","etapa":"F1",
            "mensagem": msg_etapa("F1", l["nome"], l["empresa"]),
            "prazo": cur.strftime("%Y-%m-%d %H:%M:%S"),
            "status":"AGENDADO","enviado_em":None,"erro":None})
        c += 1
        cur += timedelta(minutes=gap)
    d["total"] = len(d["itens"])
    save(FILA, d)
    return c

