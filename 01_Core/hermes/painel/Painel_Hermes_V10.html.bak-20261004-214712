  Object.keys(mapa).forEach(k=>{ t=t.split(k).join(mapa[k]); });
  return t;
}
/* Chamada real. Devolve {ok,erro,resposta} — nunca lança: um servidor fora
   do ar tem que virar status de erro na ação, não tela branca. */
async function enviarWhatsApp(numero,texto){
  const cfg=baileyConfig();
  const base=(cfg.url||'').trim().replace(/\/+$/,'');
  if(!base) return {ok:false,erro:'Baileys não configurado · sem URL em Ajustes › Integrações'};
  const to=normalizeBR(numero);
  if(!to) return {ok:false,erro:'Contato sem telefone válido'};
  /* Algumas pontes (Baileys puro) exigem o JID completo; outras recebem só
     os dígitos. O sufixo fica configurável em vez de assumido. */
  const jid=to+(cfg.jidSuffix||'').trim();
  const path=(cfg.sendPath||'/send').trim();
  const url=base+(path.startsWith('/')?'':'/')+path;
  const body={};
  body[cfg.fieldTo||'number']=jid;
  body[cfg.fieldText||'message']=texto;
  const headers={'Content-Type':'application/json'};
  if((cfg.token||'').trim()) headers.Authorization='Bearer '+(cfg.token||'').trim();
  try{
    const r=await fetch(url,{method:'POST',headers,body:JSON.stringify(body)});
    const t=await r.text();
    if(!r.ok) return {ok:false,erro:'HTTP '+r.status+' · '+(t||'').slice(0,140)};
    let d=null; try{ d=JSON.parse(t); }catch(e){ d={raw:t}; }
    /* Resposta 200 com corpo de erro é mentira: reporto como falha. */
    if(d&&d.error) return {ok:false,erro:String(d.error),url,para:jid,resposta:d};
    if(d&&d.success===false) return {ok:false,erro:String(d.error||'a ponte recusou o envio'),url,para:jid,resposta:d};
    return {ok:true,resposta:d,url,para:jid};
  }catch(e){
    return {ok:false,erro:'Não consegui falar com o Baileys · '+(e&&e.message||e),url,para:to};
  }
}
async function despacharAcao(act,camp){
  const o=oppOf(act.opportunity_id)||{};
  if(act.canal!=='WhatsApp'){
    /* E-mail e LinkedIn não têm saída implementada. Marco como enviado só
       quando existe canal real, senão o contador vira mentira. */
    return {ok:false,erro:'Canal '+act.canal+' ainda não tem integração de envio'};
  }
  return enviarWhatsApp(o.telefone,renderMensagem(act,camp,o));
}
/* --- Contadores de campanha -------------------------------------------
   `metricas.enviados` é o histórico da base e não é recalculado: a base
   não traz as ações de origem, então sobrescrever zeraria 142 envios
   históricos. O que o painel despacha agora entra por cima, e `pendentes`
   é sempre derivado das ações vivas. */
function acoesDaCampanha(id){
  return state.actions.filter(a=>String(a.campaign_id)===String(id));
}
function campEnviados(c){
  const base=(c.metricas&&c.metricas.enviados)||0;
  const agora=acoesDaCampanha(c.id).filter(a=>['ENVIADO','RESPONDIDO','CONCLUÍDO'].includes(a.status)).length;
  return base+agora;
}
function campPendentes(c){
  return acoesDaCampanha(c.id).filter(a=>['PRONTO','AGENDADO','EXECUTANDO'].includes(a.status)).length;
}
function campFalhas(c){
  return acoesDaCampanha(c.id).filter(a=>a.status==='ERRO').length;
}
/* Origem da campanha: uma lista do usuário, ou a base com filtro de público. */
function campTargets(c){
  const store=loadUserStore();
  if(c.lista&&c.lista!=='base'){
    const l=store.listas.find(x=>x.id===c.lista);
    if(l) return l.ids.map(id=>OPP_INDEX.get(id)).filter(Boolean);
  }
  const pub=c.publico||{};
  if(pub.segmento&&pub.segmento!=='Multi'&&pub.segmento!=='a definir'){
    const seg=String(pub.segmento).toLowerCase();
    const cargo=String(pub.cargo||'').toLowerCase().split(',')[0].trim();
    return state.opportunities.filter(o=>{
      if(pub.localizacao&&pub.localizacao!=='BR'){
        const loc=[o.cidade,o.uf,o.localizacao].join(' ').toLowerCase();
        if(!loc.includes(pub.localizacao.toLowerCase())) return false;
      }
      if(seg&&!(String(o.segmento||'')+' '+String(o.empresa||'')).toLowerCase().includes(seg)) return false;
      if(cargo&&cargo!=='decisor'&&!(String(o.cargo||'')+' '+String(o.perfil||'')).toLowerCase().includes(cargo)) return false;
      return true;
    });
  }
  return state.opportunities;
}
const COMMANDS={
  execute:{label:'Executar'},postpone:{label:'Reagendar'},
  block:{label:'Bloquear'},retry:{label:'Tentar de novo'}
};
function nextToqueCadencia(c){
  const d=String(c.cadencia||'').match(/D(\d+)/g);
  if(!d||d.length<2) return '';
  const dias=d.map(x=>parseInt(x.slice(1),10)).sort((a,b)=>a-b);
  const passo=dias[Math.min(1,dias.length-1)];
  return new Date(Date.now()+passo*86400000).toISOString().slice(0,16);
}
async function sendCommand(name,actionId){
  const cmd=COMMANDS[name]; if(!cmd) return;
  const a=state.actions.find(x=>String(x.id)===String(actionId));
  if(!a){ toast('Ação não encontrada'); return; }
  if(name==='block'){
    a.status='BLOQUEADO'; upsertAction(a); render(); return toast('Bloqueada · '+a.contato);
  }
  if(name==='postpone'){
    a.status='REAGENDADO';
    a.prazo=new Date(Date.now()+86400000).toISOString().slice(0,16);
    upsertAction(a); render(); return toast('Reagendada para amanhã · '+a.contato);
  }
  if(name==='execute'||name==='retry'){
    a.status='EXECUTANDO'; upsertAction(a); render();
    const camp=a.campaign_id?campaignOf(a.campaign_id):null;
    const r=await despacharAcao(a,camp);
    if(r.ok){
      a.status='ENVIADO';
      a.enviado_em=new Date().toISOString();
      a.enviado_para=r.para;
      a.erro=undefined;
    }else{
      a.status='ERRO';
      a.erro=r.erro;
    }
    upsertAction(a);
    registerEvent(a,r.ok?'envio':'erro');
    render();
    return toast(r.ok?('Enviado · '+a.contato):('Falhou · '+a.erro));
  }
}
function registerEvent(a,tipo){
  state.events=Array.isArray(state.events)?state.events:[];
  state.events.unshift({
    id:'EVT-'+Date.now()+'-'+Math.floor(Math.random()*1e4),
    tipo,atualizado:new Date().toISOString(),
    acao:a.acao,contato:a.contato,canal:a.canal,
    campanha_id:a.campaign_id,detalhe:a.erro||a.enviado_para||''
  });
  if(state.events.length>200) state.events.length=200;
}
/* =====================================================================
   12c. DISPARO
   Dispara uma onda da campanha: pega as ações pendentes, respeita o
   limite por dia e chama o canal de verdade. Devolve o que aconteceu
   para a tela falar a verdade — inclusive quando não mandou nada.
   ===================================================================== */
async function runDisparo(c,forcar){
  const store=loadUserStore();
  const reg=store.campanhas.find(x=>x.id===c.id);
  const alvo=reg||c;
  /* Pausa vale inclusive no disparo manual. Se `forcar` furasse a pausa, o
     botão "Pausar" seria decoração — e é justamente a campaigns pausada que
     o usuário não quer que saia nada. */
  if(alvo.status==='PAUSADA') return {ok:false,texto:'Campanha pausada · retome para disparar',enviados:0,bloqueado:true};
  if(alvo.status==='ENCERRADA') return {ok:false,texto:'Campanha encerrada',enviados:0,bloqueado:true};
  const agora=Date.now();
  if(alvo.agendada_em&&!forcar){
    const quando=new Date(alvo.agendada_em).getTime();
    if(quando>agora) return {ok:false,texto:'Agendada para '+fmtWhen(alvo.agendada_em),enviados:0};
  }
  const hoje=new Date().toISOString().slice(0,10);
  /* Limite por dia conta o que JÁ saiu hoje, senão reiniciar o painel
     burlaria o teto e estouraria a conta do WhatsApp. */
  const enviadosHoje=state.actions.filter(a=>
    a.campaign_id===c.id&&a.status==='ENVIADO'&&
    String(a.enviado_em||'').slice(0,10)===hoje).length;
  const teto=Math.max(1,alvo.volume_dia||30);
  const room=teto-enviadosHoje;
  if(room<=0) return {ok:false,texto:`Limite de ${teto}/dia já atingido hoje`,enviados:0};

  const fila=acoesDaCampanha(c.id)
    .filter(a=>['PRONTO','AGENDADO','EXECUTANDO'].includes(a.status))
    .sort((a,b)=>String(a.prazo).localeCompare(String(b.prazo)))
    .slice(0,room);
  if(!fila.length) return {ok:false,texto:'Nenhuma ação pendente',enviados:0};

  if(!waPronto()&&alvo.canais.includes('WhatsApp')){
    return {ok:false,texto:'Baileys não configurado · nada foi enviado',enviados:0,bloqueado:true};
  }
  let ok=0,fail=0,primeiroErro='';
  for(const a of fila){
    const r=await despacharAcao(a,alvo);
    if(r.ok){
      a.status='ENVIADO'; a.enviado_em=new Date().toISOString(); a.enviado_para=r.para; a.erro=undefined; ok++;
    }else{
      a.status='ERRO'; a.erro=r.erro; fail++;
      if(!primeiroErro) primeiroErro=r.erro;
    }
    upsertAction(a);
    registerEvent(a,r.ok?'envio':'erro');
  }
  if(reg){
    reg.ultimo_disparo=new Date().toISOString();
    saveUserStore(store);
  }
  render();
  const partes=[];
  if(ok) partes.push(ok+' enviado(s)');
  if(fail) partes.push(fail+' com falha'+(primeiroErro?' ('+primeiroErro.slice(0,60)+')':''));
  return {ok:ok>0,enviados:ok,falhas:fail,texto:partes.join(' · ')||'nada enviado'};
}
/* Ações agendadas agem sozinhas: o painel está aberto, o tique roda e
   a hora bateu, então dispara. Sem reliance em servidor externo. */
async function tickDisparo(){
  if(state.dispando) return;
  state.dispando=true;
  try{
    const agora=Date.now();
    for(const c of state.campaigns.slice()){
      if(c.sugestao) continue;
      if(c.status==='PAUSADA'||c.status==='ENCERRADA') continue;
      if(!c.agendada_em) continue;
      if(new Date(c.agendada_em).getTime()>agora) continue;
      if(!acoesDaCampanha(c.id).some(a=>['PRONTO','AGENDADO','EXECUTANDO'].includes(a.status))) continue;
      const r=await runDisparo(c,false);
      if(r.ok) toast(c.nome+' · '+r.texto);
    }
  }catch(e){
    /* Um tique que quebra para no catch: sem isso a exceção mata o
       setInterval e o agendamento morre silenciosamente. */
    console.error('tickDisparo',e);
  }finally{
    state.dispando=false;
  }
}
function startDisparoLoop(){
  if(state.disparoTimer) return;
  state.disparoTimer=setInterval(tickDisparo,30000);
  setTimeout(tickDisparo,4000);
}

/* ---- Relógio da sessão de execução ------------------------------------
   A fila precisa parecer viva: a contagem regressiva anda e, quando algo
   vence ou sai da janela, o painel se corrige sozinho. Duas velocidades,
   de propósito:
     - a cada 5s, só o texto das contagens muda (barato, não mexe no DOM
       estrutural, não rouba o foco de ninguém);
     - só redesenha a view inteira quando a situação da fila realmente
       mudou (um item venceu, um erro entrou, a janela da agenda mudou).
   Sem essa segunda checagem, o painel piscaria a cada 5 segundos. */
function filaSignature(){
  const c=filaContagem();
  return FILA_GRUPOS.map(g=>c[g.id]).join('|')
    +'#'+(state.filaFiltro||'tudo')+'#'+(state.agendaHoras||24)
    +'#'+agendaProximas(state.agendaHoras||24).length;
}
function startFilaTicker(){
  if(state.filaTimer) return;
  state.filaLastSig=filaSignature();
  state.filaTimer=setInterval(()=>{
    /* 1) só o texto que muda */
    document.querySelectorAll('[data-count]').forEach(el=>{
      const m=minutosAte(el.dataset.count);
      if(m!==null) el.textContent=fmtContagem(m);
    });
    /* 2) redesenha só se a situação mudou */
    const sig=filaSignature();
    if(sig===state.filaLastSig) return;
    state.filaLastSig=sig;
    if(['execucao','campanhas','acoes','central'].includes(state.view)) render();
  },5000);
}

