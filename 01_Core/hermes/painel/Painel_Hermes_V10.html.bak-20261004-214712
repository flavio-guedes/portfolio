function deriveInsights(){
  const o=state.opportunities;
  const total=o.length||1;
  const porSeg={}; o.forEach(x=>{porSeg[x.segmento]=(porSeg[x.segmento]||0)+1;});
  const quentes=o.filter(x=>x.temperatura==='Quente'||x.temperatura==='Muito quente');
  const qSeg={}; quentes.forEach(x=>{qSeg[x.segmento]=(qSeg[x.segmento]||0)+1;});
  const insights=[];

  const topSeg=Object.entries(porSeg).sort((a,b)=>b[1]-a[1])[0];
  if(topSeg&&topSeg[1]/total>0.15){
    const q=Math.round((qSeg[topSeg[0]]||0)/Math.max(1,quentes.length)*100);
    insights.push({
      tone:'ai',
      title:`${topSeg[0]} representa ${Math.round(topSeg[1]/total*100)}% da base`,
      evidencia:`${topSeg[1]} leads em ${topSeg[0]}.`,
      interpretacao:`Mas concentra ${q}% das oportunidades quentes.`,
      acao:'Criar case específico e cadência dedicada.'
    });
  }

  const semToque=o.filter(x=>!x.ultima_interacao&&x.estagio==='Descoberta'&&x.grupo==='A');
  if(semToque.length>5){
    insights.push({
      tone:'hot',
      title:`${semToque.length} leads quentes sem abordagem`,
      evidencia:`Grupo A, alta temperatura, sem primeira interação.`,
      interpretacao:`Risco de esfriar em 7 dias.`,
      acao:'Disparar primeiro contato prioritário.'
    });
  }

  const tres=o.filter(x=>x.temperatura==='Frio'&&x.score<20&&x.grupo==='B').length;
  if(tres>10){
    insights.push({
      tone:'warn',
      title:`${tres} leads frios no Grupo B`,
      evidencia:`Score < 20, sem sinal de intenção.`,
      interpretacao:`Custo de toque maior que retorno esperado.`,
      acao:'Reclassificar como Grupo C ou aguardar gatilho.'
    });
  }

  return insights;
}

/* Índice por id: com 11k+ leads, find() linear em cada render custa caro. */
let OPP_INDEX=new Map();
const rebuildOppIndex=()=>{ OPP_INDEX=new Map(state.opportunities.map(o=>[o.id,o])); };

function oMatchesDim(o,dim,val){
  if(val==='all'||dim==='none') return true;
  if(dim==='contexto') return o.tipo===val;
  if(dim==='canal') return o.canal_preferido===val;
  if(dim==='estagio') return o.estagio===val;
  if(dim==='prioridade') return o.prioridade===val;
  if(dim==='campanha') return o.campaign_id===val;
  if(dim==='grupo') return o.grupo===val;
  if(dim==='perfil') return o.perfil===val;
  if(dim==='segmento') return o.segmento===val;
  return true;
}
function deriveEtapaSuggest(o){
  const map={Descoberta:'A1',Qualificação:'A2',Conversa:'A4',Proposta:'B3'};
  return map[o.estagio]||'A1';
}
function recFilterPass(o){
  const f=state.recommendFilter;
  for(let i=1;i<=(f.count||2);i++){
    const dim=f['dim'+i],val=f['val'+i];
    if(!oMatchesDim(o,dim,val)) return false;
  }
  if(state.recommendScope==='campaign'&&state.recommendTarget!=='all'){
    if((o.campaign_id||'')!==state.recommendTarget) return false;
  }
  if(state.recommendScope==='action'&&state.recommendTarget!=='all'){
    if(o.id!==state.recommendTarget) return false;
  }
  return true;
}
const REC_LIMIT=300;
function generateRecommendations(){
  const recs=[];
  const open=state.opportunities.filter(o=>o.estagio!=='Fechado'&&o.estagio!=='Perdido');
  /* A base embutida tem 11k+ leads. A UI só exibe 120 recomendações,
     então ordenamos por prioridade/score e truncamos para não travar. */
  const cand=open.filter(recFilterPass)
    .sort((a,b)=>(b.score||0)-(a.score||0));
  const LIMITE=REC_LIMIT;
  for(let i=0;i<cand.length&&recs.length<LIMITE;i++){
    const o=cand[i];
    if(o.proxima_acao){
      recs.push({id:'REC-'+o.id+'-NX',opportunity_id:o.id,empresa:o.empresa,contato:o.contato,
        acao:o.proxima_acao,canal:o.canal_preferido||'LinkedIn',etapa:deriveEtapaSuggest(o),
        prazo:o.proxima_data||suggestDate(1),prioridade:o.prioridade||'Média',
        motivo:'Próxima ação já definida no plano.',tipo:'next'});
      continue;
    }
    if(o.estagio==='Conversa'){
      recs.push({id:'REC-'+o.id+'-FU',opportunity_id:o.id,empresa:o.empresa,contato:o.contato,
        acao:'Enviar follow-up curto com o próximo passo',canal:o.canal_preferido||'LinkedIn',etapa:'F1',
        prazo:suggestDate(1),prioridade:o.prioridade||'Média',
        motivo:'Oportunidade em conversa sem próxima ação agendada.',tipo:'followup'});
      continue;
    }
    if((o.temperatura==='Muito quente'||o.temperatura==='Quente')&&!o.ultima_interacao){
      recs.push({id:'REC-'+o.id+'-HOT',opportunity_id:o.id,empresa:o.empresa,contato:o.contato,
        acao:'Fazer primeiro contato prioritário',canal:o.canal_preferido||'LinkedIn',etapa:'A1',
        prazo:suggestDate(0),prioridade:'Alta',
        motivo:'Lead quente ainda sem abordagem registrada.',tipo:'hot'});
      continue;
    }
    if(o.estagio==='Descoberta'||o.estagio==='Qualificação'){
      recs.push({id:'REC-'+o.id+'-QUAL',opportunity_id:o.id,empresa:o.empresa,contato:o.contato,
        acao:'Enviar apresentação curta com 1 case relevante',canal:o.canal_preferido||'LinkedIn',etapa:'A2',
        prazo:suggestDate(2),prioridade:o.prioridade||'Média',
        motivo:'Lead qualificado aguardando primeira abordagem com prova.',tipo:'qualify'});
    }
  }
  return recs;
}
function getRecommendations(){
  return generateRecommendations().map(r=>{
    const d=state.recommendDecisions[r.id];
    if(d) return {...r,status:d.status,scheduled_at:d.when};
    return {...r,status:'pending'};
  });
}
function createActionFromRecommendation(rec,prazo){
  const o=oppOf(rec.opportunity_id)||{};
  const act={
    id:'ACT-'+Date.now()+'-'+Math.floor(Math.random()*1000),
    opportunity_id:rec.opportunity_id,campaign_id:o.campaign_id||null,
    contato:o.contato||rec.empresa,canal:rec.canal,etapa:rec.etapa,
    acao:rec.acao,prazo:prazo,prioridade:rec.prioridade||'Média',
    prioridade_fila:3,status:'AGENDADO',allowed:['execute','postpone','block']
  };
  /* upsertAction, não state.actions.push: applyData() recarrega a base
     embutida a cada refresh, então o que não vai para o store some no
     próximo reload. A ação precisa sobreviver, senão "Agendar" mentia. */
  return upsertAction(act);
}
function handleRecommendDecision(recId,decision,when){
  const rec=getRecommendations().find(r=>r.id===recId); if(!rec) return;
  if(decision==='yes'){ state.recommendDecisions[recId]={status:'approved'}; createActionFromRecommendation(rec,rec.prazo); toast('Autorizado · '+rec.empresa); }
  else if(decision==='no'){ state.recommendDecisions[recId]={status:'rejected'}; toast('Descartado · '+rec.empresa); }
  else if(decision==='schedule'){
    if(!when){ state.recommendScheduling=recId; refreshRecommendSection(); return; }
    state.recommendDecisions[recId]={status:'scheduled',when};
    createActionFromRecommendation(rec,when);
    state.recommendScheduling=null; toast('Agendado · '+rec.empresa);
  }
  refreshRecommendSection();
}
function refreshRecommendSection(){
  /* A lista de recomendações aparece na Central (modo recomendação) e também
     em destaque na Execução, então o refresh precisa valer nas duas. */
  if(state.view!=='central'&&state.view!=='execucao') return;
  render();
}

