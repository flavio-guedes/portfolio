function setupCSVImport(){
  if(window.__csvImportReady) return;
  window.__csvImportReady=true;
  const run=async(text,grupos)=>{
    const status=document.getElementById('csvStatus');
    if(status) status.innerHTML=`<div class="sub">Processando…</div>`;
    try{
      const {opportunities,stats}=importCSV(text,{grupos:grupos||['A','B']});
      const persisted=saveImported(opportunities,stats);
      if(status){
        status.innerHTML=`<div class="note" style="margin:0">
          <strong>Importação concluída.</strong> A: ${fmtNum(stats.A)} · B: ${fmtNum(stats.B)} · C: ${fmtNum(stats.C)} (${grupos&&grupos.includes('C')?'incluído':'não importado'}).
          <br>Total importado: <strong>${fmtNum(stats.importadas)}</strong>.
          ${persisted?'':'<br><span style="color:var(--warn)">Acima da cota do localStorage — a base vale só para esta sessão. A base embutida continua salva no painel.</span>'}
        </div>`;
      }
      await refresh(false);
      toast(`Importadas ${stats.importadas} oportunidades`);
    }catch(e){
      console.error(e);
      if(status) status.innerHTML=`<div class="note" style="border-color:var(--urgent);background:var(--urgent-bg);color:var(--txt)">Erro: ${esc(e.message)}</div>`;
    }
  };
  document.addEventListener('change',async e=>{
    if(!e.target.matches('#csvFileInput')) return;
    const file=e.target.files[0]; if(!file) return;
    const text=await file.text();
    run(text,['A','B']);
  });
  document.addEventListener('click',async e=>{
    if(e.target.closest('#csvPasteBtn')){
      const text=window.prompt('Cole o conteúdo do CSV e confirme.');
      if(text) run(text,['A','B']);
    }
    if(e.target.closest('#csvImportAllBtn')){
      const text=window.prompt('Cole o conteúdo do CSV para importar A + B + C.');
      if(text) run(text,['A','B','C']);
    }
    if(e.target.closest('#csvClearBtn')){
      if(confirm(`Descartar o CSV importado e voltar à base embutida (${LEADS_SOURCE_FILE})?`)){
        clearImported(); await refresh(false); toast('Base embutida restaurada');
      }
    }
  });
}

