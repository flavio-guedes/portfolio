/* =====================================================================
   AGRUPAMENTO OBJETIVO DO MENU
   Cada grupo junta telas que leem o mesmo dado:
     Visão geral   → central + resultados   (KPIs cruzados, funil de campanhas)
     Prospecção    → oportunidades + listas (base de leads, open pipeline e recortes)
     Execução      → Operação: campanhas + ações + conversas + histórico numa tela só
     Entrega       → projetos + ativos      (contas em curso e recursos comerciais)
     Inteligência  → inteligência           (insights, aprendizado, mercado)
     Sistema       → automações, agentes, dados (infraestrutura e base)
   Regra: NENHUM id sai de userCfg.nav nem de VIEWS. Agrupar é só presentation.
   ===================================================================== */
const NAV_GROUPS=[
  {id:'g_visao',   label:'Visão geral',    views:['central','resultados','execucao','recommend']},
  {id:'g_prospec', label:'Prospecção',     views:['oportunidades'], modes:['listas']},
    {id:'g_entrega', label:'Entrega',        views:['projetos','ativos']},
  {id:'g_intel',   label:'Inteligência',   views:['inteligencia']},
  {id:'g_sistema', label:'Sistema',        views:['automacoes','agentes','dados']}
];
function navGroupedHTML(items){
  const byId={}; items.forEach(n=>{ byId[n.id]=n; });
  const modes={}; workspaceModes().forEach(m=>{ modes[m.id]=m; });
  const groups=NAV_GROUPS.map(g=>{
    const btns=g.views.map(id=>byId[id]).filter(Boolean).map(navBtnHTML)
      .concat((g.modes||[]).map(id=>modes[id]).filter(Boolean).map(navModeBtnHTML));
    if(!btns.length) return '';
    return `<div class="nav-group"><div class="nav-group-label">${esc(g.label)}</div>${btns.join('')}</div>`;
  }).join('');
  /* Rede de segurança: item visível fora dos grupos continua aparecendo. */
  const grouped=new Set([].concat(...NAV_GROUPS.map(g=>g.views)));
  const rest=items.filter(n=>!grouped.has(n.id));
  const restModes=workspaceModes().filter(m=>!(NAV_GROUPS.some(g=>(g.modes||[]).includes(m.id))));
  const tail=rest.map(navBtnHTML).concat(restModes.map(navModeBtnHTML)).join('');
  return groups+(tail?`<div class="nav-group">${tail}</div>`:'');
}
function filterDefsMap(){
  return {
    contexto:{label:'Contexto',opts:[['all','Tudo'],...SCHEMA.oportunidade.tipo.options.map(o=>[o,o])]},
    campanha:{label:'Campanha',opts:[['all','Todas'],...state.campaigns.filter(c=>!c.sugestao).map(c=>[c.id,c.nome])]},
    canal:{label:'Canal',opts:[['all','Todos'],...SCHEMA.canal.options.map(c=>[c,c])]},
    estagio:{label:'Estágio',opts:[['all','Todos'],...SCHEMA.oportunidade.estagio.options.map(c=>[c,c])]},
    prioridade:{label:'Prioridade',opts:[['all','Todas'],...SCHEMA.oportunidade.prioridade.options.map(c=>[c,c])]},
    grupo:{label:'Grupo',opts:[['all','Todos'],['A','Grupo A'],['B','Grupo B'],['C','Grupo C']]}
  };
}
function filtersHTML(variant){
  const defs=filterDefsMap();
  const active=userCfg.filters.filter(f=>f.visible);
  const wrapClass=variant==='stack'?'side-filters rail-filters':'filters';
  const groups=active.map(f=>{
    const def=defs[f.id]; if(!def) return '';
    return `<label class="filter-group"><span class="lbl">${esc(f.label)}</span>
      <select data-filter="${f.id}">
