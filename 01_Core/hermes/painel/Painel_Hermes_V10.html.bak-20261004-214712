        <input name="ba_tel" data-ba-tel value="21999719474" placeholder="5511999999999">
      </label>
      <div data-ba-out style="margin-top:12px"></div>`;
    const grab=()=>{
      const g=n=>{const el=body.querySelector('[name="'+n+'"]'); return el?el.value.trim():'';};
      return {url:g('ba_url'),token:g('ba_token'),sendPath:g('ba_path')||'/send',fieldTo:g('ba_to')||'number',fieldText:g('ba_text')||'message',jidSuffix:g('ba_jid')};
    };
    const save=()=>{ userCfg.integracoes.baileys=grab(); saveConfig(); renderSettingsTab(); };
    body.querySelector('[data-ba-save]').addEventListener('click',()=>{ save(); toast('Integração salva'); });
    body.querySelector('[data-ba-test]').addEventListener('click',async ()=>{
      save();
      const out=body.querySelector('[data-ba-out]');
      out.innerHTML='<div class="sub">Enviando…</div>';
      const num=body.querySelector('[data-ba-tel]')?body.querySelector('[data-ba-tel]').value.trim():'';
      /* Sem numero digitado eu NAO invento destinatario: mandar para um
         numero qualquer seria pior do que nao mandar. */
      if(!num){
        out.innerHTML='<div class="note" style="border-color:var(--warn-bd);background:var(--warn-bg)">Digite o número do teste acima. Não vou chutar um destinatário.</div>';
        return;
      }
      const r=await enviarWhatsApp(num,'Teste de integração do painel Hermes. Se você recebeu isto, o Baileys está ligado.');
      out.innerHTML=r.ok
        ?`<div class="note" style="border-color:var(--ok-bd);background:var(--ok-bg)"><b>Envio OK.</b> O servidor respondeu para o número ${esc(r.para)}.<br><span class="sub">${esc(JSON.stringify(r.resposta).slice(0,200))}</span></div>`
        :`<div class="note" style="border-color:var(--warn-bd);background:var(--warn-bg)"><b>Não enviei.</b> ${esc(r.erro)}</div>`;
    });
    /* Campo de número só aparece no teste, para não sujar a config. */
  }
}

/* =====================================================================
   27. CHAT
   ===================================================================== */
const CHAT_EXAMPLES=[
  'Quais oportunidades precisam de atenção hoje?',
  'Crie uma campanha para clínicas de estética',
  'Quais leads B2B estão quentes?',
  'Analise a campanha Freelancer Pro',
  'Crie uma abordagem usando o case My Dream'
];
function initChat(){
  const body=$('#chatBody');
  if(body.dataset.init) return;
  body.dataset.init='1';
  body.innerHTML=`<div class="msg hermes"><strong>Hermes</strong><br>O que você quer fazer?
    ${CHAT_EXAMPLES.map(txt=>`<div class="ex">${esc(txt)}<button class="btn sm ghost" data-chat-example="${esc(txt)}">usar</button></div>`).join('')}
  </div>`;
  body.querySelectorAll('[data-chat-example]').forEach(b=>b.addEventListener('click',()=>{
    $('#chatInput').value=b.dataset.chatExample; sendChatMsg();
  }));
}
async function sendChatMsg(){
  const input=$('#chatInput'); const txt=input.value.trim(); if(!txt) return;
  const body=$('#chatBody');
  body.insertAdjacentHTML('beforeend', '<div class="msg me">' + esc(txt) + '</div>');
  input.value=''; body.scrollTop=body.scrollHeight;
  const pid='p'+Date.now();
  body.insertAdjacentHTML('beforeend', '<div class="msg hermes" id="'+pid+'">…</div>');
  body.scrollTop=body.scrollHeight;
  try{
    const r = await fetch('http://127.0.0.1:8420/api/chat',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({msg:txt})});
    const d = await r.json();
    const el = document.getElementById(pid);
    if(el) el.textContent = d.resposta || d.erro || 'sem resposta';
  }catch(e){
    const el = document.getElementById(pid);
    if(el) el.textContent = 'Erro: ' + e.message;
  }
  body.scrollTop=body.scrollHeight;
}

/* =====================================================================
   28. INIT
   ===================================================================== */
$('#chatFab').addEventListener('click',()=>{
  const p=$('#chatPanel'); p.classList.toggle('open');
  if(p.classList.contains('open')){ initChat(); $('#chatInput').focus(); }
});
$('#chatClose').addEventListener('click',()=>$('#chatPanel').classList.remove('open'));
$('#chatSend').addEventListener('click',sendChatMsg);
$('#chatInput').addEventListener('keydown',e=>{ if(e.key==='Enter') sendChatMsg(); });

async function refresh(manual){
  try{
    const data=await loadData();
    applyData(data);
    applyAppearance();
    render();
    if(manual) toast('Leitura atualizada');
  }catch(err){ console.error(err); toast('Falha: '+err.message); }
}
(async function init(){ await refresh(false); setupCSVImport(); startLiveFeed(); startDisparoLoop(); })();
