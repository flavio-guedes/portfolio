      <div class="r">${o.grupo?`<span class="chip-s">${esc(o.grupo)}</span>`:''}${C.badge(s0.label,s0.tone||'neutral')}</div>
    </div>`;
  }).join('')+`<div class="cl-foot"><span class="sub">Mostrando ${Math.min(st.n,vis.length)} de ${vis.length}</span>
    ${vis.length>st.n?`<span style="display:flex;gap:6px"><button class="btn sm" data-cl-more="${esc(c.id)}">Mostrar +25</button><button class="btn sm ghost" data-cl-rest="${esc(c.id)}">Todos (${vis.length})</button></span>`:''}</div>`;
}
