function deleteCampaign(id){
  const c=campaignOf(id);
  if(!c) return;
  const acoes=acoesDaCampanha(id);
  const enviados=acoes.filter(a=>a.status==='ENVIADO').length;
  const aviso=enviados
    ? `A campanha "${c.nome}" e suas ${acoes.length} ações serão apagadas — ${enviados} já ${enviados===1?'foi enviado':'foram enviados'} e não dá para desfazer.`
    : `A campanha "${c.nome}" e suas ${acoes.length} ações serão apagadas.`;
  if(!confirm(aviso)) return;
  const store=loadUserStore();
  store.campanhas=store.campanhas.filter(x=>x.id!==id);
  const quantas=acoes.length;
  store.actions=(store.actions||[]).filter(a=>a.campaign_id!==id);
  saveUserStore(store);
  state.campaigns=state.campaigns.filter(x=>x.id!==id);
  state.actions=state.actions.filter(a=>a.campaign_id!==id);
  delete state.campaignExpanded[id];
  render();
  toast(quantas?`Campanha excluída · ${quantas} ação(ões) removida(s)`:'Campanha excluída');
}
