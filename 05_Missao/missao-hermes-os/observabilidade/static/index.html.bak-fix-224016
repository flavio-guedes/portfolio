<script>
(function(){
  function getView(){ return document.getElementById('escala-view'); }

  function injetar(){
    var tabs = document.getElementById('tabs');
    if (!tabs) return false;
    if (tabs.querySelector('#tab-escala')) return true;

    var btn = document.createElement('div');
    btn.className = 'tb';
    btn.id = 'tab-escala';
    btn.setAttribute('data-tab','escala');
    btn.innerHTML = '<span>Escala</span>';

    btn.onclick = function(e){
      e.stopPropagation();
      // marca visualmente
      tabs.querySelectorAll('.tb').forEach(function(x){ x.classList.remove('on'); });
      btn.classList.add('on');
      // mostra view, esconde conteúdo do app.js
      var v = getView(); if (v) v.classList.add('on');
      var pb = document.getElementById('pbody'); if (pb) pb.style.display = 'none';
      var pt = document.getElementById('ptitle'); if (pt) pt.style.display = 'none';
      // limpa seleção do app.js
      try { if (typeof window.det !== 'undefined') window.det = null; } catch(_){}
      carregar();
    };

    tabs.appendChild(btn);
    return true;
  }

  function esconder(){
    var v = getView(); if (v) v.classList.remove('on');
    var pb = document.getElementById('pbody'); if (pb) pb.style.display = '';
    var pt = document.getElementById('ptitle'); if (pt) pt.style.display = '';
    var tab = document.getElementById('tab-escala');
    if (tab) tab.classList.remove('on');
  }

  function carregar(){
    var box = document.getElementById('escala-alertas');
    if (!box) return;
    fetch('/api/alerts?tipo=escala&limit=5', {cache:'no-store'})
      .then(function(r){ if (!r.ok) throw 0; return r.json(); })
      .then(function(arr){
        if (!arr || !arr.length){ box.innerHTML = '<div>Nenhuma sugestão nova ainda</div>'; return; }
        box.innerHTML = arr.slice(-5).map(function(a){
          return '<div>'+(a.msg||'')+'</div>';
        }).join('');
      })
      .catch(function(){
        box.innerHTML = '<div>Fase 4: acumulando amostras para v11 preditiva</div>'
                      + '<div>Fase 2: hora de integrar leads + campanhas (só local)</div>';
      });
  }

  function start(){
    var tabs = document.getElementById('tabs');
    if (!tabs){ setTimeout(start, 200); return; }

    // Observa qualquer reescrita de #tabs e reinjeta o botão
    var obs = new MutationObserver(function(muts){
      // só reinjeta se o botão foi perdido
      if (!tabs.querySelector('#tab-escala')) injetar();
    });
    obs.observe(tabs, {childList: true, subtree: false});

    // Injeta imediatamente
    injetar();

    // Delega cliques nas OUTRAS abas para esconder a view de escala
    tabs.addEventListener('click', function(e){
      var alvo = e.target.closest('.tb');
      if (!alvo) return;
      if (alvo.id === 'tab-escala') return;
      esconder();
    }, true);
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', start);
  else start();
})();
</script>
