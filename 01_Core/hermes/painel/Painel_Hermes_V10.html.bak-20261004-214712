/* =====================================================================
   12b. INTEGRAÇÃO WHATSAPP (Baileys)
   O envio real sai do navegador para um servidor Baileys que o usuário
   roda. A ponte HTTP não tem um formato único no mundo, então URL, caminho
   e nome dos campos são configuráveis. Sem `url` preenchida o painel NÃO
   finge que enviou: a ação fica marcada como não despachada e a tela avisa.
   ===================================================================== */
function baileyConfig(){ return (userCfg.integracoes&&userCfg.integracoes.baileys)||{}; }
function waPronto(){ return !!(baileyConfig().url||'').trim(); }
/* Só remove o que não é dígito e tira o 55 quando ele já vem colado.
   Não invento o nono dígito: adivinhar telefone manda mensagem para a
   pessoa errada, que é pior do que não mandar. */
function normalizeBR(raw){
  let d=String(raw||'').replace(/\D/g,'');
  if(d.startsWith('55')&&d.length>11) d=d.slice(2);
  return d?('55'+d):'';
}
const ESTILO_ABORDAGEM={
  'Direto':{
    hint:'Frase curta, pergunta de reunião no fim. Sem enrolação.',
    template:'Olá {contato}, aqui é {responsavel}. {objetivo} Posso te mostrar em 2 minutos?'
  },
  'Consultivo':{
    hint:'Puxa um problema do dia a dia dele antes de falar da oferta.',
    template:'Oi {contato}, tudo bem? Notei que muita gente de {segmento} trava em {oferta}. Aqui a gente resolve assim. Vale uma conversa de 10 minutos?'
  },
  'Case técnico':{
    hint:'Prova primeiro, oferta depois. Manda o material e pergunta.',
    template:'{contato}, montei algo parecido com o que a {empresa} faz, usando {oferta}. Posso mandar o material para você ver?'
  },
  'Sequencial':{
    hint:'Primeiro toque só abre o assunto. Sem pedir nada.',
    template:'{contato}, passando para falar sobre {oferta}. Faz sentido trocar uma ideia?'
  }
};
function renderMensagem(act,camp,opp){
  const o=opp||oppOf(act.opportunity_id)||{};
  const c=camp||{};
  const mapa={
    '{contato}':act.contato||o.contato||'tudo bem',
    '{empresa}':c.empresa_alvo||o.empresa||'sua empresa',
    '{responsavel}':c.responsavel||'Flávio',
