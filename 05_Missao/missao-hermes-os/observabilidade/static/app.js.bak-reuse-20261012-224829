function renderTabs(){
  var t = $('tabs'); if (!t) return;
  var lista = TABS[modo]; var html = '';
  for (var i=0; i<lista.length; i++){
    var tab = lista[i];
    var on = tab.id === aba ? ' on' : '';
    var bd = '';
    try { if (tab.fn){ var v = tab.fn(); if (v > 0) bd = '<span class="bd">'+v+'</span>'; } } catch(e){}
    html += '<div class="tb'+on+'" data-tab="'+tab.id+'">'+ICO_(tab.ic,15)+'<span>'+E(tab.l)+'</span>'+bd+'</div>';
  }
  t.innerHTML = html;
  var els = t.querySelectorAll('[data-tab]');
  for (var j=0; j<els.length; j++){
    els[j].onclick = (function(id){ return function(){ aba = id; det = null; renderTabs(); render(); }; })(els[j].getAttribute('data-tab'));
  }
}

function renderHint(){
  if (!isCoz()) return '';
  var h = HINTS[aba]; if (!h) return '';
  var tips = '';
  for (var i=0;i<h.tips.length;i++) tips += '<div class="tip">'+E(h.tips[i])+'</div>';
  return '<div class="hint">'+ICO_('info',16)+'<div class="hb"><div class="ht">'+E(h.t)+'</div><div class="hd">'+E(h.d)+'</div><div class="htips">'+tips+'</div></div></div>';
}

