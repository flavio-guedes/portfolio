const C={
  badge(text,tone){ return `<span class="badge ${tone||''}">${esc(text)}</span>`; },
  grupoBadge(g){
    if(!g) return '';
    const tone=g==='A'?'gold':g==='B'?'info':'neutral';
    return `<span class="badge ${tone}">${esc(GRUPO_LABEL[g]||g)}</span>`;
  },
  kpi({k,n,d,cls}){ return `<div class="kpi ${cls||''}"><div class="k">${esc(k)}</div><div class="n">${esc(n)}</div><div class="d">${esc(d||'')}</div></div>`; },
  progress(pct,tone){ return `<div class="progress"><i class="${tone||''}" style="width:${Math.min(100,Math.max(0,pct))}%"></i></div>`; },
  kv(k,v){ return `<div class="kv"><span>${esc(k)}</span><b>${v==null?'—':v}</b></div>`; },
  empty(msg){ return `<div class="empty">${esc(msg)}</div>`; },
  sectionHead(title,sub,right){ return `<div class="section-head"><div><h2>${esc(title)}</h2>${sub?`<p>${esc(sub)}</p>`:''}</div>${right||''}</div>`; },
  note(html){ return `<div class="note">${html}</div>`; },
  statusTone(status){
    if(['PRONTO','ENVIADO','CONCLUÍDO'].includes(status)) return 'ok';
    if(['AGENDADO','EXECUTANDO'].includes(status)) return 'info';
    if(['RESPONDIDO'].includes(status)) return 'ai';
    if(['BLOQUEADO','REAGENDADO'].includes(status)) return 'warm';
    if(['ERRO','CANCELADO'].includes(status)) return 'hot';
    return 'neutral';
  },
  tempTone(t){
    if(t==='Muito quente'||t==='Quente') return 'hot';
    if(t==='Morno') return 'warm';
    return 'info';
  },
  prioTone(p){ return p==='Alta'?'hot':p==='Média'?'warm':''; }
};

