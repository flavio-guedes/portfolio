<script>
function toggleEvent(head){head.closest('.event').classList.toggle('open');}
function togglePhase(head){
  const ph = head.closest('.phase');
  ph.classList.toggle('collapsed');
  const body = ph.querySelector('.phase-body');
  if(ph.classList.contains('collapsed')){body.style.maxHeight='0px';}
  else{body.style.maxHeight=body.scrollHeight+'px';setTimeout(()=>{body.style.maxHeight='none';},320);}
}
function filterEv(btn, mode){
  document.querySelectorAll('.filter').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  document.querySelectorAll('.event').forEach(ev => {
    if(mode === 'all'){ ev.style.display = ''; return; }
    ev.style.display = (ev.dataset.state === mode) ? '' : 'none';
  });
  document.querySelectorAll('.phase').forEach(ph => {
    const visible = ph.querySelectorAll('.event:not([style*="display: none"])').length;
    ph.style.display = visible ? '' : 'none';
  });
}
let allExpanded = false;
function toggleAll(){
  allExpanded = !allExpanded;
  document.querySelectorAll('.event').forEach(ev => ev.classList.toggle('open', allExpanded));
  document.querySelectorAll('.phase').forEach(ph => {
    ph.classList.toggle('collapsed', !allExpanded);
    const body = ph.querySelector('.phase-body');
    body.style.maxHeight = allExpanded ? 'none' : '0px';
  });
}
document.addEventListener('DOMContentLoaded', () => {
  document.querySelectorAll('.phase-body').forEach(b => { b.style.maxHeight = 'none'; });
});
</script>

