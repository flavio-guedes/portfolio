    try:
        if tipo == "launchd":
            subprocess.Popen(["launchctl","kickstart","-k", f"gui/{os.getuid()}/{cmd}"])
        else:
            subprocess.Popen(["bash","-lc", cmd])
        return _chat_ok(f"Reinício de '{sv}' disparado. Digite 'status' em 5s.")
    except Exception as e:
        return _chat_erro(f"Falha: {e}")


def _chat_dispatch(texto):
    t = (texto or "").strip()
    if not t: return _chat_erro("Mensagem vazia.")
    low = t.lower()

    if any(k in low for k in ("ajuda","help","comandos","?")):          return _cmd_ajuda()
    if any(k in low for k in ("resumo","visão","visao","overview","painel")): return _cmd_resumo()
    if any(k in low for k in ("status","saúde","saude","serviços","servicos")): return _cmd_status()
    if "modelo" in low:                                                 return _cmd_modelos()
    if "provedor" in low:                                               return _cmd_provedores()
    if "alerta" in low:                                                 return _cmd_alertas()
    if "sugest" in low or "o que fazer" in low:                         return _cmd_sugestoes()
    if "reanal" in low:                                                 return _cmd_reanalisar()
    if "uptime" in low:
        m = re.search(r"(\d+)", low); return _cmd_uptime(int(m.group(1)) if m else 24)
    if "latên" in low or "laten" in low:                                return _cmd_latencia()
    if "escala" in low or "fase" in low or "progresso" in low:          return _cmd_escala()
    if "log" in low:
        partes = low.split(); return _cmd_logs(partes[1] if len(partes)>1 else "watchdog")
    if "seção" in low or "secao" in low or low.startswith("aba "):
        partes = t.split(maxsplit=1)
        return _cmd_secao(partes[1] if len(partes)>1 else "")
    if low.startswith("reiniciar") or low.startswith("restart"):
        partes = low.replace("reiniciar","").replace("restart","").strip().split()
        return _cmd_reiniciar(partes[0] if partes else "")

    # fallback: Ollama local
    try:
        body = json.dumps({
            "model": os.environ.get("OLLAMA_MODEL","llama3.2:1b"),
            "messages":[{"role":"system","content":"Você é o assistente do painel Hermes OS. Responda curto."},
                        {"role":"user","content":t}], "stream": False
        }).encode()
        req = urllib.request.Request("http://127.0.0.1:11434/api/chat",
            data=body, headers={"Content-Type":"application/json"})
        with urllib.request.urlopen(req, timeout=20) as r:
            j = json.loads(r.read())
            resp = j.get("message",{}).get("content","")
            if resp: return _chat_ok(resp, {"via":"ollama"})
    except Exception:
        pass

    return _chat_ok("Não entendi. Digite **ajuda** para ver os comandos.")


def chat_handler(body):
    try:
        msg = body.get("msg","")
        r = _chat_dispatch(msg)
        with CHAT_HIST.open("a") as f:
            f.write(json.dumps({"ts":datetime.now().isoformat(timespec="seconds"),
                                "user":msg,"bot":r.get("msg",""),"ok":r.get("ok",False)},
                               ensure_ascii=False)+"\n")
        return r
    except Exception as e:
        return _chat_erro(f"Erro: {e}")

class H(BaseHTTPRequestHandler):
    daemon_threads = True
    def log_message(self, *a): pass
    def _json(self, obj, code=200):
        b = json.dumps(obj, ensure_ascii=False).encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json; charset=utf-8")
        self.send_header("Access-Control-Allow-Origin", "*")
        self.send_header("Content-Length", str(len(b)))
        self.end_headers(); self.wfile.write(b)
    def do_GET(self):
        u = urlparse(self.path)
        if u.path == "/api/health":
            with lock: return self._json(estado)
        if u.path == "/api/metrics":
            horas = int(parse_qs(u.query).get("hours", [24])[0])
            corte = datetime.now() - timedelta(hours=horas)
            out = []
            arq = DATA / "metrics.jsonl"
            if arq.exists():
                for ln in arq.read_text().splitlines():
                    try:
                        o = json.loads(ln)
                        if datetime.fromisoformat(o["ts"]) >= corte: out.append(o)
                    except Exception: pass
            return self._json({"hours": horas, "count": len(out), "data": out})
        if u.path == "/api/stream":
            self.send_response(200)
            self.send_header("Content-Type", "text/event-stream")
            self.send_header("Cache-Control", "no-cache")
            self.send_header("Access-Control-Allow-Origin", "*")
            self.end_headers()
            ult = ""
            try:
                while True:
                    with lock: atual = dict(estado)
                    if atual["ts"] != ult:
                        ult = atual["ts"]
                        self.wfile.write(f"data: {json.dumps(atual, ensure_ascii=False)}\n\n".encode())
                        self.wfile.flush()
                    time.sleep(5)
            except (BrokenPipeError, ConnectionResetError): pass
            return
        if u.path == "/api/sugestoes":
            lim = int(parse_qs(u.query).get("n", ["20"])[0])
            ultimo = {"ts":"","origem":"","sugestoes":[]}
            if SUG_PATH.exists():
                for ln in SUG_PATH.read_text().splitlines()[-lim:]:
                    try: ultimo = json.loads(ln)
                    except Exception: pass
            return self._json(ultimo)
        if u.path == "/api/sugestoes/historico":
            lim = int(parse_qs(u.query).get("n", ["30"])[0])
            out = []
            if SUG_PATH.exists():
                for ln in SUG_PATH.read_text().splitlines()[-lim:]:
                    try: out.append(json.loads(ln))
                    except Exception: pass
            return self._json(out)

        self._json({"erro": "not found",
                    "paths": ["/api/health", "/api/metrics", "/api/stream"]}, 404)


