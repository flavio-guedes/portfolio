/* ---- Ações: persistência com override por id e exclusão por tombstone ----
   A base embutida recarrega a cada refresh(); então editar/excluir precisa
   sobreviver a isso. Regras:
   - acoes[]        -> edição de ação da base (mesmo id) OU ação nova (id ACT-*)
   - acoesExcluidas -> ids de ações da base que o usuário removeu
   Não guardamos a exclusão de ações criadas pelo próprio usuário: basta
   tirar do array acoes, que a base não vai ressuscitar. */
const ACTION_STATUSES=['PRONTO','AGENDADO','EXECUTANDO','ENVIADO','RESPONDIDO','REAGENDADO','BLOQUEADO','ERRO','CONCLUÍDO','CANCELADO'];
function allowedForActionStatus(st){
  switch(st){
    case 'PRONTO':
    case 'AGENDADO':     return ['execute','postpone','block'];
    case 'EXECUTANDO':   return ['postpone','block'];
    case 'ERRO':         return ['retry','postpone'];
    case 'BLOQUEADO':    return ['postpone'];
    default:             return [];
  }
}
function normalizeAction(a){
  const st=ACTION_STATUSES.includes(a.status)?a.status:'PRONTO';
  return Object.assign({},a,{
    status:st,
    publico:a.publico&&typeof a.publico==='object'?a.publico:{segmento:'',cargo:'',localizacao:''},
    lista:a.lista||'all',
    /* `allowed` é derivado do status: o usuário não pode liberar comando
       que a máquina não executa, nem a máquina expor comando incoerente. */
    allowed:allowedForActionStatus(st)
  });
}
function applyActionOverrides(store){
  const dead=new Set((store.acoesExcluidas||[]).map(String));
  if(dead.size) state.actions=state.actions.filter(a=>!dead.has(String(a.id)));
  const idx=new Map(state.actions.map(a=>[String(a.id),a]));
  (store.acoes||[]).forEach(raw=>{
    if(!raw||!raw.id) return;
    const norm=normalizeAction(raw);
    if(idx.has(String(raw.id))) Object.assign(idx.get(String(raw.id)),norm);
    else state.actions.push(norm);
  });
  return state.actions;
}
function nextActionId(){
  let max=0;
  state.actions.forEach(a=>{ const m=/^ACT-(\d+)/.exec(String(a.id)); if(m) max=Math.max(max,+m[1]); });
  return 'ACT-'+String(max+1).padStart(4,'0');
}
function upsertAction(action){
  const store=loadUserStore();
  store.acoes=Array.isArray(store.acoes)?store.acoes:[];
  const i=store.acoes.findIndex(a=>String(a.id)===String(action.id));
  const norm=normalizeAction(action);
  if(i>=0) store.acoes[i]=norm; else store.acoes.push(norm);
  /* Se voltou a existir depois de excluída, tira o tombstone. */
  store.acoesExcluidas=(store.acoesExcluidas||[]).filter(id=>String(id)!==String(action.id));
  saveUserStore(store);
  const live=state.actions.find(a=>String(a.id)===String(action.id));
  if(live) Object.assign(live,norm); else state.actions.push(norm);
  return norm;
}
function deleteAction(id){
  const store=loadUserStore();
  const key=String(id);
  const isUser=store.acoes.some(a=>String(a.id)===key);
  if(isUser){
    store.acoes=store.acoes.filter(a=>String(a.id)!==key);
  }else{
    store.acoesExcluidas=Array.isArray(store.acoesExcluidas)?store.acoesExcluidas:[];
    if(!store.acoesExcluidas.includes(key)) store.acoesExcluidas.push(key);
  }
  saveUserStore(store);
  const n=state.actions.length;
  state.actions=state.actions.filter(a=>String(a.id)!==key);
  return n-state.actions.length;
}

