<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Missão Hermes OS — Painel de Acompanhamento</title>
<style>
  :root{
    --bg:#0d1117; --panel:#161b22; --panel2:#1c2128; --panel3:#21262d; --border:#30363d;
    --txt:#e6edf3; --txt2:#8b949e; --txt3:#6e7681;
    --green:#3fb950; --yellow:#d29922; --red:#f85149; --blue:#58a6ff; --purple:#bc8cff;
    --gold:#e3b341;
  }
  *{box-sizing:border-box;margin:0;padding:0}
  body{font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif;background:var(--bg);color:var(--txt);line-height:1.5;padding:32px 20px;min-height:100vh}
  .wrap{max-width:1100px;margin:0 auto}
  header{margin-bottom:32px;padding-bottom:24px;border-bottom:1px solid var(--border)}
  h1{font-size:28px;font-weight:600;margin-bottom:8px;display:flex;align-items:center;gap:12px;flex-wrap:wrap}
  h1 .badge{font-size:11px;padding:3px 10px;border-radius:12px;background:var(--panel2);color:var(--blue);font-weight:500;letter-spacing:.5px}
  .sub-title{color:var(--txt2);font-size:14px}
  .meta{margin-top:12px;display:flex;gap:24px;flex-wrap:wrap;font-size:13px;color:var(--txt2)}
  .meta b{color:var(--txt);font-weight:600}
  .progress-box{background:var(--panel);border:1px solid var(--border);border-radius:10px;padding:20px;margin-bottom:20px}
  .progress-label{display:flex;justify-content:space-between;font-size:13px;margin-bottom:10px}
  .progress-label .pct{font-size:22px;font-weight:700;color:var(--green)}
  .bar{height:8px;background:var(--panel2);border-radius:4px;overflow:hidden}
  .bar-fill{height:100%;background:linear-gradient(90deg,var(--green),var(--blue));transition:width .4s}
  .stats{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-top:16px}
  .stat{background:var(--panel2);padding:12px;border-radius:8px;text-align:center}
  .stat .n{font-size:22px;font-weight:700}
  .stat .l{font-size:11px;color:var(--txt2);text-transform:uppercase;letter-spacing:.5px;margin-top:2px}
  .stat.done .n{color:var(--green)}.stat.prog .n{color:var(--yellow)}.stat.wait .n{color:var(--txt3)}.stat.fail .n{color:var(--red)}
  .toolbar{display:flex;gap:8px;margin-bottom:20px;flex-wrap:wrap;align-items:center}
  .filter{padding:6px 14px;border-radius:20px;border:1px solid var(--border);background:var(--panel);color:var(--txt2);font-size:13px;cursor:pointer;transition:.15s}
  .filter:hover{border-color:var(--blue);color:var(--txt)}
  .filter.active{background:var(--blue);border-color:var(--blue);color:#fff}
  .toolbar .spacer{flex:1}
  .expand-all{padding:6px 14px;border-radius:20px;border:1px solid var(--border);background:transparent;color:var(--txt2);font-size:12px;cursor:pointer;transition:.15s}
  .expand-all:hover{border-color:var(--purple);color:var(--purple)}
  .timeline{position:relative;padding-left:40px}
  .timeline::before{content:"";position:absolute;left:15px;top:8px;bottom:8px;width:2px;background:linear-gradient(180deg,var(--green),var(--blue),var(--border))}
  .phase{margin-bottom:28px;border-radius:12px;transition:.2s}
  .phase-head{display:flex;align-items:center;gap:10px;padding:10px 14px;background:var(--panel2);border:1px solid var(--border);border-radius:10px;cursor:pointer;user-select:none;transition:.15s;margin-bottom:12px}
  .phase-head:hover{border-color:var(--blue);background:var(--panel3)}
  .phase-head .chevron{font-size:12px;color:var(--txt2);transition:transform .2s;display:inline-block;width:14px}
  .phase.collapsed .phase-head .chevron{transform:rotate(-90deg)}
  .phase-title{font-size:13px;text-transform:uppercase;letter-spacing:1px;color:var(--txt);margin:0;font-weight:600;flex:1}
  .phase-title .count{color:var(--txt3);font-weight:400;margin-left:6px;text-transform:none;letter-spacing:0}
  .phase-body{overflow:hidden;transition:max-height .3s ease}
  .phase.collapsed .phase-body{max-height:0 !important;overflow:hidden}
  .event{position:relative;margin-bottom:10px;background:var(--panel);border:1px solid var(--border);border-radius:10px;transition:.15s;overflow:hidden}
  .event:hover{border-color:var(--blue)}
  .event::before{content:"";position:absolute;left:-33px;top:22px;width:12px;height:12px;border-radius:50%;border:2px solid var(--bg);background:var(--txt3);z-index:2}
  .event.done::before{background:var(--green)}
  .event.prog::before{background:var(--yellow);box-shadow:0 0 0 4px rgba(210,153,34,.2);animation:pulse 2s infinite}
  .event.fail::before{background:var(--red)}
  @keyframes pulse{0%,100%{box-shadow:0 0 0 4px rgba(210,153,34,.2)}50%{box-shadow:0 0 0 8px rgba(210,153,34,.05)}}
  .ev-head{display:flex;justify-content:space-between;align-items:flex-start;gap:12px;padding:16px 18px;cursor:pointer;user-select:none;transition:.15s}
  .ev-head:hover{background:var(--panel2)}
  .ev-title-box{flex:1;display:flex;align-items:flex-start;gap:10px}
  .ev-chevron{font-size:11px;color:var(--txt3);margin-top:4px;transition:transform .2s;display:inline-block;width:12px;flex-shrink:0}
  .event.open .ev-chevron{transform:rotate(90deg);color:var(--blue)}
  .ev-title{font-size:15px;font-weight:600;display:flex;align-items:center;gap:8px;flex-wrap:wrap}
  .ev-tag{font-size:10px;padding:2px 8px;border-radius:10px;font-weight:600;letter-spacing:.5px;text-transform:uppercase}
  .tag-done{background:rgba(63,185,80,.15);color:var(--green)}
  .tag-prog{background:rgba(210,153,34,.15);color:var(--yellow)}
  .tag-wait{background:rgba(110,118,129,.15);color:var(--txt2)}
  .tag-fail{background:rgba(248,81,73,.15);color:var(--red)}
  .ev-id{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:11px;color:var(--txt3);margin-top:3px}
  .ev-time{font-size:11px;color:var(--txt3);white-space:nowrap;margin-top:2px}
  .ev-dropdown{max-height:0;overflow:hidden;transition:max-height .35s ease;border-top:1px solid transparent}
  .event.open .ev-dropdown{max-height:3000px;border-top-color:var(--border)}
  .ev-dropdown-inner{padding:16px 18px;background:var(--bg)}
  .checklist{list-style:none;margin:0;padding:0}
  .checklist li{display:flex;align-items:flex-start;gap:10px;padding:10px 0;font-size:13px;color:var(--txt2);border-bottom:1px dashed var(--panel2)}
  .checklist li:last-child{border-bottom:none}
  .checklist li.done{color:var(--txt)}
  .checklist .box{flex-shrink:0;width:16px;height:16px;margin-top:2px;border-radius:4px;border:1.5px solid var(--border);display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:700;line-height:1}
  .checklist li.done .box{background:var(--green);border-color:var(--green);color:#fff}
  .checklist li.done .box::before{content:"✓"}
  .checklist li.active .box{border-color:var(--yellow);background:rgba(210,153,34,.15)}
  .checklist li.active .box::before{content:"•";color:var(--yellow);font-size:14px}
  .checklist li.pending .box{background:transparent}
  .checklist li.fail .box{background:var(--red);border-color:var(--red);color:#fff}
  .checklist li.fail .box::before{content:"✕"}
  .checklist .txt{flex:1;line-height:1.5}
  .checklist .txt code{background:var(--panel2);padding:1px 6px;border-radius:4px;font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:11.5px;color:var(--blue)}
  .checklist .sub{display:block;margin-top:5px;font-size:11.5px;color:var(--gold);font-style:italic;padding-left:8px;border-left:2px solid rgba(227,179,65,.3);line-height:1.45}
  .checklist .sub::before{content:"🍽 ";opacity:.7;margin-right:2px}
  .ev-evidence{margin-top:12px;padding:10px 14px;background:var(--panel);border-left:3px solid var(--blue);border-radius:6px;font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:11.5px;color:var(--txt);word-break:break-word}
  .ev-evidence.ok{border-left-color:var(--green)}
  .ev-evidence.warn{border-left-color:var(--yellow)}
  .ev-evidence.fail{border-left-color:var(--red)}
  .ev-evidence .label{display:block;font-family:-apple-system,sans-serif;font-size:10px;text-transform:uppercase;letter-spacing:.5px;color:var(--txt3);margin-bottom:4px;font-weight:600}
  footer{margin-top:48px;padding-top:24px;border-top:1px solid var(--border);font-size:12px;color:var(--txt3);text-align:center}
  footer b{color:var(--txt2)}
  footer code{background:var(--panel2);padding:1px 6px;border-radius:4px;font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:11px}
  @media(max-width:640px){.stats{grid-template-columns:repeat(2,1fr)}h1{font-size:22px}.timeline{padding-left:32px}.event::before{left:-25px}.ev-time{display:none}}
</style>
</head>
