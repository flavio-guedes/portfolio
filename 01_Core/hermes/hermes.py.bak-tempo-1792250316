def send_loop_unica():
    """Uma única thread: pega o próximo AGENDADO de QUALQUER tipo, respeita cadência,
       e se falhar, pula pro próximo imediatamente."""
    estado_ativo = False
    falhas_seguidas = 0
    while True:
        time.sleep(0.4)
        if not (EST["env_novo"] or EST["env_base"] or EST["env_hot"]):
            estado_ativo = False
            continue
        if not EST["lock"].acquire(blocking=False):
            continue
        try:
            d = load(FILA)
            if not d:
                continue
            pend = [i for i in d["itens"] if i["status"]=="AGENDADO"]
            if not pend:
                EST["env_novo"]=EST["env_base"]=EST["env_hot"]=False
                EST["msg"] = "fila concluída"
                continue
            p = min(pend, key=lambda x: x["prazo"])

            # espera prazo (a menos que venha de uma falha — burst)
            if falhas_seguidas == 0:
                try:
                    alvo = datetime.strptime(p["prazo"], "%Y-%m-%d %H:%M:%S")
                    seg = (alvo - datetime.now()).total_seconds()
                    if seg > 0:
                        EST["msg"] = f"aguardando {int(seg)}s → {p['empresa'][:30]}"
                        continue
                except: pass

            # bridge ok?
            hh = health()
            if not hh or hh.get("status")!="connected":
                EST["msg"] = "bridge desconectado"
                continue

            # enviar
            r = send1(p["chatId"], p["mensagem"])
            for i in d["itens"]:
                if i["id"]==p["id"]:
                    if r.get("success"):
                        i["status"]="OK"; i["enviado_em"]=now()
                        i["etapa"]=prox_etapa(i.get("etapa","D0"))
                        EST["ok"] += 1
                        EST["msg"] = f"✓ {p['empresa'][:30]}"
                        falhas_seguidas = 0
                    else:
                        err = str(r)[:80]
                        i["status"]="ERRO"; i["erro"]=err
                        EST["err"] += 1
                        if any(t in err.lower() for t in ["not registered","no whatsapp","invalid number","not on whatsapp"]):
                            i["erro"] = "sem WhatsApp"
                            EST["msg"] = f"⊘ {p['empresa'][:26]} sem WhatsApp"
                        else:
                            EST["msg"] = f"✗ {p['empresa'][:26]}"
                        falhas_seguidas += 1
                        if falhas_seguidas > 10:
                            falhas_seguidas = 0  # reset após 10 pulos
            save(FILA, d)
        finally:
            EST["lock"].release()



