/* Resolve o conjunto de oportunidades que vão receber a ação. */
function actionTargetsForScope(escopo,form){
  if(escopo==='global') return [];
  if(escopo==='pontual'){
    const id=String(new FormData(form).get('opportunity_id')||'');
    const o=id?oppOf(id):null;
    return o?[o]:[];
  }
  if(String(escopo).startsWith('l:')){
    const l=userLists().find(x=>'l:'+x.id===String(escopo));
    return l?userListMembers(l):[];
  }
  if(escopo==='campanha'){
    const open=state.opportunities.filter(o=>o.estagio!=='Fechado'&&o.estagio!=='Perdido');
    const campId=String(new FormData(form).get('campaign_id')||'');
    const camp=campId?campaignOf(campId):null;
    const seg=((camp&&camp.publico&&camp.publico.segmento)||'').split(',')[0].trim().toLowerCase();
    if(!seg) return open.slice(0,50);
    const match=open.filter(o=>(o.segmento||'').toLowerCase().includes(seg));
    return match.length?match:open.slice(0,50);
  }
  return filteredOpportunities();
}
function saveActionFromForm(form){
  const fd=new FormData(form);
  const isEdit=!!form.dataset.id;
  const acao=String(fd.get('acao')||'').trim();
  if(!acao){ toast('Descreva a ação'); return; }
  /* Só os campos que o form realmente edita. Em edição, campanha/lista/
     opportunity_id ficam de fora para não serem zerados. */
  const campos={
    acao,
    contato:String(fd.get('contato')||'').trim()||'—',
    canal:String(fd.get('canal')||'LinkedIn'),
    etapa:String(fd.get('etapa')||'A1').trim()||'A1',
    prazo:String(fd.get('prazo')||'').trim()||new Date(Date.now()+86400000).toISOString().slice(0,16),
    prioridade:String(fd.get('prioridade')||'Média'),
    status:String(fd.get('status')||'PRONTO'),
    publico:{
      segmento:String(fd.get('segmento')||'').trim(),
      cargo:String(fd.get('cargo')||'').trim(),
      localizacao:String(fd.get('localizacao')||'').trim()
    }
  };
  if(isEdit){
    const prev=state.actions.find(a=>String(a.id)===String(form.dataset.id))||{};
    upsertAction(Object.assign({},prev,campos));
    closeBackdrop(); render();
    toast('Ação atualizada');
    return;
  }
  const escopo=String(fd.get('escopo')||'global');
  const campId=String(fd.get('campaign_id')||'');
  if(escopo==='global'){
    upsertAction(Object.assign({},campos,{
      id:nextActionId(), opportunity_id:null, campaign_id:campId||null,
      lista:'global', motivo:acao, userEdited:true
    }));
    closeBackdrop(); render();
    toast('Ação global criada');
    return;
  }
  const targets=actionTargetsForScope(escopo,form);
  if(!targets.length){ toast('Nenhum alvo para esse escopo'); return; }
  const lote=targets.slice(0,300);
  /* Um único write no localStorage: criar 300 ações não pode virar 300 saves. */
  const store=loadUserStore();
  store.acoes=Array.isArray(store.acoes)?store.acoes:[];
  const byId=new Map(store.acoes.map(a=>[String(a.id),a]));
  lote.forEach(o=>{
    const a=normalizeAction(Object.assign({},campos,{
      id:nextActionId(), opportunity_id:o.id, campaign_id:campId||null,
      lista:escopo, userEdited:true,
      contato:campos.contato!=='—'?campos.contato:(o.contato||o.empresa||'—'),
      etapa:campos.etapa==='A1'?deriveEtapaSuggest(o):campos.etapa
    }));
    byId.set(String(a.id),a);
    state.actions.push(a);
  });
  store.acoes=[...byId.values()];
  saveUserStore(store);
  closeBackdrop(); render();
  toast(`${lote.length} ação(ões) criada(s)`);
}
