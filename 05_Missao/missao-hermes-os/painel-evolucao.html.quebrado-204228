<!-- ===== MONITORAMENTO AO VIVO v15 ===== -->
<section id="monitor-vivo" style="
  margin:24px auto;max-width:1100px;padding:20px;
  background:rgba(20,20,24,.72);backdrop-filter:blur(12px);
  border:1px solid rgba(255,255,255,.08);border-radius:14px;
  font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;color:#e8e8ec">
  <header style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px">
    <h2 style="margin:0;font-size:18px;font-weight:600">Monitoramento ao vivo</h2>
    <span id="mv-status" style="font-size:12px;padding:4px 10px;border-radius:999px;background:#333;color:#aaa">aguardando…</span>
  </header>
  <div id="mv-servicos" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:10px;margin-bottom:18px"></div>
  <div style="display:flex;gap:24px;align-items:center;flex-wrap:wrap">
    <div>
      <div style="font-size:11px;color:#888;text-transform:uppercase;letter-spacing:.08em">Latência</div>
      <div id="mv-lat" style="font-size:22px;font-weight:600">—</div>
    </div>
    <svg id="mv-spark" width="320" height="48" style="flex:1;min-width:220px"></svg>
    <div>
      <div style="font-size:11px;color:#888;text-transform:uppercase;letter-spacing:.08em">Última coleta</div>
      <div id="mv-hora" style="font-size:13px">—</div>
    </div>
  </div>
</section>
<script>
(() => {
  const API  = '/api/health';
  const POLL = 15000, MAXP = 20;
  const $ = id => document.getElementById(id);
  const hist = [];
  const cores = { ok:'#2ecc71', warn:'#f1c40f', down:'#e74c3c', desconhecido:'#555' };
  function pintar(status, msg) {
    const el = $('mv-status');
    el.textContent = msg;
    el.style.background = (cores[status] || '#333') + '22';
    el.style.color = cores[status] || '#aaa';
  }
  function render(servicos) {
    const box = $('mv-servicos');
    box.innerHTML = '';
    for (const [nome, st] of Object.entries(servicos)) {
      const s = (typeof st === 'string') ? {status: st, detalhe: ''} : st;
      const cor = cores[s.status] || cores.desconhecido;
      box.insertAdjacentHTML('beforeend',
        '<div style="padding:12px;border-radius:10px;background:rgba(255,255,255,.03);border:1px solid '+cor+'33">'+
        '<div style="display:flex;align-items:center;gap:8px">'+
        '<span style="width:8px;height:8px;border-radius:50%;background:'+cor+';box-shadow:0 0 8px '+cor+'"></span>'+
        '<strong style="font-size:13px">'+nome+'</strong></div>'+
        '<div style="font-size:11px;color:#999;margin-top:6px">'+(s.detalhe||s.status)+'</div></div>');
    }
  }
  function sparkline() {
    const svg = $('mv-spark');
    if (hist.length < 2) { svg.innerHTML=''; return; }
    const max = Math.max(...hist,1), min = Math.min(...hist);
    const w = svg.clientWidth || 320, h = 48, step = w/(MAXP-1);
    const pts = hist.map((v,i)=>{
      const x=i*step, y=h-((v-min)/((max-min)||1))*(h-6)-3;
      return x+','+y;
    }).join(' ');
    svg.innerHTML = '<polyline points="'+pts+'" fill="none" stroke="#4da3ff" stroke-width="2" stroke-linejoin="round"/>'+
      '<polyline points="'+pts+' '+(hist.length-1)*step+','+h+' 0,'+h+'" fill="#4da3ff22" stroke="none"/>';
  }
  async function tick() {
    const t0 = performance.now();
    try {
      const r = await fetch(API, {cache:'no-store'});
      const lat = Math.round(performance.now()-t0);
      if (!r.ok) throw new Error('HTTP '+r.status);
      const data = await r.json();
      hist.push(lat); if (hist.length>MAXP) hist.shift();
      $('mv-lat').textContent = lat+' ms';
      $('mv-hora').textContent = new Date().toLocaleTimeString('pt-BR');
      render(data.servicos || data);
      pintar('ok','operacional');
      sparkline();
    } catch(e) {
      pintar('down','API offline');
      $('mv-lat').textContent = '—';
    } finally { setTimeout(tick, POLL); }
  }
  tick();
})();
</script>


