const loadMock=async()=>{
  const imported=loadImported();
  if(imported&&imported.opportunities.length){
    return {...clone(MOCK),opportunities:imported.opportunities};
  }
  try{
    const {opportunities,stats}=await loadEmbeddedBase(EMBEDDED_GRUPOS);
    EMBEDDED_STATS=stats;
    return {...clone(MOCK),opportunities};
  }catch(err){
    console.error('Falha ao expandir a base embutida:',err);
    EMBEDDED_ERROR=err&&err.message||String(err);
    return clone(MOCK);
  }
};
const loadData=()=>DATA_SOURCE==='hermes'?null:loadMock();
let EMBEDDED_STATS=null;
let EMBEDDED_ERROR=null;
function applyData(data){
  ['opportunities','campaigns','projects','assets','conversations','actions','automations','agents','channels','events','executions'].forEach(k=>{
    state[k]=Array.isArray(data[k])?data[k]:[];
  });
  /* Campanhas criadas pelo usuário entram junto das que vieram da base. */
  const userStore=loadUserStore();
  const baseIds=new Set(state.campaigns.map(c=>c.id));
  userStore.campanhas.forEach(c=>{ if(!baseIds.has(c.id)) state.campaigns.push(c); });
  /* Leads que vieram de "Importar lista" e não existem na base. */
  if(Array.isArray(userStore.leadsExtras)&&userStore.leadsExtras.length){
    const have=new Set(state.opportunities.map(o=>o.id));
    userStore.leadsExtras.forEach(o=>{ if(!have.has(o.id)) state.opportunities.push(o); });
  }
  applyActionOverrides(userStore);
  rebuildOppIndex();
  state.executionPanel=data.executionPanel||{};
  state.intelligence=data.intelligence||{};
  state.config=data.config||{};
  /* Nova base de dados, novo marco do relógio da fila. */
  state.clockAnchorBase=undefined;
  state.meta.source=DATA_SOURCE;
  state.meta.syncedAt=new Date().toISOString();
  const imp=loadImported();
  state.meta.importedCount=imp?imp.count:0;
  state.meta.importedAt=imp?imp.importedAt:null;
  state.meta.efemera=imp?!!imp.efemera:false;
  state.meta.baseStats=imp?(imp.stats||null):(EMBEDDED_STATS||null);
  state.meta.baseFonte=imp
    ? (imp.stats&&imp.stats.fonte ? imp.stats.fonte : 'CSV importado')
    : (EMBEDDED_ERROR ? 'MOCK (base embutida falhou)' : LEADS_SOURCE_FILE+' · embutida');
}

