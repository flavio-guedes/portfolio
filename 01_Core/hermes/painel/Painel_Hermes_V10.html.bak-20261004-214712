      const id=b.dataset.modeToggle; const item=userCfg.modes.find(x=>x.id===id); if(!item) return;
      item.visible=!item.visible;
      if(!item.visible&&userCfg.mode===id){ const next=userCfg.modes.find(x=>x.visible&&x.id!==id); if(next) userCfg.mode=next.id; }
      saveConfig(); applyAppearance(); render(); renderSettingsTab();
    }));
  } else if(settingsTab==='nav'){
    body.innerHTML=`
      <div class="sub" style="margin-bottom:14px">Mostre, oculte e reordene os itens do menu.</div>
      ${userCfg.nav.map((n,i)=>`
        <div class="cfg-row">
