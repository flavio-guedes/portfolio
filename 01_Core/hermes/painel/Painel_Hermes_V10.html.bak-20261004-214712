function mergeConfig(def,p){
  let modes;
  if(Array.isArray(p.modes)&&p.modes.length){
    modes=p.modes.map(m=>{
      const meta=MODES.find(x=>x.id===m.id); if(!meta) return null;
      return {id:m.id,visible:m.visible!==false};
    }).filter(Boolean);
    const seen=new Set();
    modes=modes.filter(m=>{if(seen.has(m.id))return false; seen.add(m.id); return true;});
  } else modes=def.modes.slice();
  MODES.forEach(m=>{ if(!modes.find(x=>x.id===m.id)) modes.push({id:m.id,visible:true}); });
  const layout=Object.assign({},def.layout,p.layout||{});
  layout.collapsedSections=(layout.collapsedSections&&typeof layout.collapsedSections==='object')?layout.collapsedSections:{};
  const validPos=['sidebar','header','footer','right'];
  ['modesPosition','navPosition','filtersPosition'].forEach(k=>{
    if(!validPos.includes(layout[k])) layout[k]=def.layout[k];
  });
  return {
    mode:p.mode||def.mode,
    modes,
    layout,
    appearance:Object.assign({},def.appearance,p.appearance||{}),
    integracoes:Object.assign({},def.integracoes||{},p.integracoes||{},{
      baileys:Object.assign({},(def.integracoes||{}).baileys,(p.integracoes||{}).baileys||{})
    }),
    nav:Array.isArray(p.nav)?p.nav.filter(n=>!OP_LEGACY[n.id]).map(n=>{
      const d=def.nav.find(x=>x.id===n.id)||{};
      /* Campanhas + Ações + Em execução + Conversas viraram a aba Operação. */
      const label=(n.id==='execucao'&&(!n.label||n.label==='Em execução'))?d.label:(n.label||d.label||n.id);
      return {id:n.id,ico:n.ico||d.ico||'●',label,visible:n.visible!==false};
    }):def.nav,
    filters:(function(){
      const list=Array.isArray(p.filters)?p.filters.map(f=>{
        const d=def.filters.find(x=>x.id===f.id)||{};
        return {id:f.id,label:f.label||d.label||f.id,visible:f.visible!==false};
      }):def.filters.slice();
      if(!list.find(f=>f.id==='grupo')) list.push({...def.filters.find(x=>x.id==='grupo')});
      return list;
    })()
  };
}
