document.addEventListener('change',e=>{
  if(e.target.matches('[data-busca-canal]')){
    buscaEstado().canal=e.target.value;
    renderBuscaHint();
    return;
  }
  if(e.target.matches('[data-acao-escopo]')){
    /* Mostra só o seletor de alvo que o escopo escolhido usa. */
    const form=e.target.closest('form'); if(!form) return;
    const v=e.target.value;
    form.querySelectorAll('[data-scope-box]').forEach(b=>{
      b.hidden = String(b.dataset.scopeBox)!==v;
    });
    return;
  }
  if(e.target.matches('[data-rec-dim]')){
    const n=e.target.dataset.recDim;
    state.recommendFilter['dim'+n]=e.target.value;
    if(e.target.value==='none') state.recommendFilter['val'+n]='all';
    refreshRecommendSection(); return;
  }
  if(e.target.matches('[data-rec-val]')){
    state.recommendFilter['val'+e.target.dataset.recVal]=e.target.value;
    refreshRecommendSection(); return;
  }
  if(e.target.matches('[data-rec-scope]')){
    state.recommendScope=e.target.value; state.recommendTarget='all';
    refreshRecommendSection(); return;
  }
  if(e.target.matches('[data-rec-target]')){
    state.recommendTarget=e.target.value; refreshRecommendSection(); return;
  }
  if(e.target.matches('[data-dash-dim]')){
    state.dashboardDim=e.target.value; render(); return;
  }
  if(e.target.matches('[data-lista-select]')){
    state.listasFilter=e.target.value; render(); return;
  }
  if(e.target.matches('[data-sim]')){
    state.simulador[e.target.dataset.sim]=parseInt(e.target.value)||0; render(); return;
  }
});
