/* ============ RECOMENDAÇÕES ============ */
function recommendDims(){
  return [
    {v:'none',l:'—'},{v:'contexto',l:'Público'},{v:'canal',l:'Canal'},{v:'estagio',l:'Estágio'},
    {v:'prioridade',l:'Prioridade'},{v:'grupo',l:'Grupo'},{v:'perfil',l:'Perfil'},
    {v:'segmento',l:'Segmento'},{v:'campanha',l:'Campanha'}
  ];
}
function recommendValuesFor(dim){
  if(dim==='contexto') return [['all','Tudo'],...SCHEMA.oportunidade.tipo.options.map(o=>[o,o])];
  if(dim==='canal') return [['all','Todos'],...SCHEMA.canal.options.map(o=>[o,o])];
  if(dim==='estagio') return [['all','Todos'],...SCHEMA.oportunidade.estagio.options.map(o=>[o,o])];
  if(dim==='prioridade') return [['all','Todas'],...SCHEMA.oportunidade.prioridade.options.map(o=>[o,o])];
  if(dim==='grupo') return [['all','Todos'],['A','Grupo A'],['B','Grupo B'],['C','Grupo C']];
  if(dim==='perfil') return [['all','Todos'],['Decisor','Decisor'],['Gestor','Gestor'],['Recrutador','Recrutador'],['Execução','Execução'],['Outro','Outro']];
  if(dim==='segmento'){
    const segs=[...new Set(state.opportunities.map(o=>o.segmento).filter(Boolean))].sort();
    return [['all','Todos'],...segs.map(s=>[s,s])];
  }
  if(dim==='campanha') return [['all','Todas'],...state.campaigns.filter(c=>!c.sugestao).map(c=>[c.id,c.nome])];
  return [['all','Todos']];
}
function recommendFilterGroup(n){
  const dimKey='dim'+n,valKey='val'+n;
  const dim=state.recommendFilter[dimKey], val=state.recommendFilter[valKey];
  const dims=recommendDims(), vals=recommendValuesFor(dim);
  return `<div class="rec-filter-group">
    <span class="lbl">F${n}</span>
    <select data-rec-dim="${n}">${dims.map(d=>`<option value="${d.v}" ${dim===d.v?'selected':''}>${esc(d.l)}</option>`).join('')}</select>
    ${dim!=='none'?`<span class="rec-sep">·</span>
      <select data-rec-val="${n}">${vals.map(v=>`<option value="${esc(v[0])}" ${val===v[0]?'selected':''}>${esc(v[1])}</option>`).join('')}</select>`:''}
  </div>`;
}
function recommendScopeHTML(){
  const scope=state.recommendScope, tgt=state.recommendTarget;
  let targetOpts=[];
  if(scope==='campaign') targetOpts=[['all','Todas'],...state.campaigns.filter(c=>!c.sugestao).map(c=>[c.id,c.nome])];
  else if(scope==='action'){
    const open=state.opportunities.filter(o=>o.estagio!=='Fechado'&&o.estagio!=='Perdido');
    targetOpts=[['all','Todas'],...open.slice(0,200).map(o=>[o.id,o.empresa])];
