  });
}
function recolherTodas(){
  document.querySelectorAll('.etapa').forEach(e => e.classList.remove('open'));
}
function marcarConcluidas(){
  document.querySelectorAll('.etapa').forEach(e => {
    e.style.display = (e.dataset.status === 'done') ? '' : 'none';
  });
}
function mostrarTodas(){
  document.querySelectorAll('.etapa').forEach(e => e.style.display = '');
}

// Abre a v9 por padrão
window.addEventListener('DOMContentLoaded', () => {
  const v9 = document.querySelector('.etapa.active');
  if (v9) v9.classList.add('open');
});

// Parallax suave nas camadas de fundo
const layers = document.querySelectorAll('[data-d]');
let mx=.5,my=.5,cx=.5,cy=.5;
document.addEventListener('mousemove', e => {
  mx = e.clientX / innerWidth;
  my = e.clientY / innerHeight;
});
function tick(){
  cx += (mx-cx)*.055;
  cy += (my-cy)*.055;
  const dx=cx-.5, dy=cy-.5;
  layers.forEach(l => {
    const d = parseFloat(l.dataset.d) || 0;
    l.style.transform = `translate(${dx*-d}px,${dy*-d}px)`;
  });
  requestAnimationFrame(tick);
}
tick();

// Animação em cascata
document.querySelectorAll('section').forEach((s,i) => {
  s.style.animationDelay = (i*0.08)+'s';
});
</script>


