<!-- ===== BOTÃO ESCALA (flutuante, independente) ===== -->
<style>
#escala-btn{
  position:fixed;top:16px;right:16px;z-index:9998;
  background:#4da3ff22;color:#4da3ff;border:1px solid #4da3ff55;
  padding:8px 14px;border-radius:10px;font-size:13px;font-weight:500;
  font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;
  cursor:pointer;backdrop-filter:blur(10px);transition:all .15s;
  box-shadow:0 4px 14px rgba(0,0,0,.4);
}
#escala-btn:hover{background:#4da3ff33;transform:translateY(-1px)}
#escala-btn.on{background:#4da3ff;color:#0b0c10}

#escala-painel{
  position:fixed;top:60px;right:16px;z-index:9999;
  width:min(880px, calc(100vw - 32px));
  max-height:calc(100vh - 90px);overflow-y:auto;
  background:rgba(15,15,20,.97);backdrop-filter:blur(16px);
  border:1px solid rgba(255,255,255,.1);border-radius:14px;
  padding:22px;color:#e8e8ec;
  font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;
  font-size:12px;
  box-shadow:0 20px 60px rgba(0,0,0,.6);
  display:none;
}
#escala-painel.on{display:block}
#escala-painel h2{margin:0 0 4px;font-size:18px;font-weight:600;color:#fff}
#escala-painel .sub{color:#888;font-size:12px;margin-bottom:16px}
#escala-painel h3{margin:20px 0 0;font-size:13px;color:#aaa;
  text-transform:uppercase;letter-spacing:.08em;font-weight:500}
#escala-painel table{width:100%;border-collapse:collapse;font-size:12px;margin-top:8px}
#escala-painel th{text-align:left;color:#888;font-weight:500;padding:8px 10px;
  border-bottom:1px solid rgba(255,255,255,.1);text-transform:uppercase;
  letter-spacing:.05em;font-size:10px}
#escala-painel td{padding:8px 10px;border-bottom:1px solid rgba(255,255,255,.04)}
#escala-painel tr:last-child td{border:none}
#escala-painel .fase{font-weight:600;color:#4da3ff}
#escala-painel .ok{color:#2ecc71}
#escala-painel .warn{color:#f1c40f}
#escala-painel .off{color:#888}
#escala-painel .pill{display:inline-block;padding:2px 8px;border-radius:999px;
  font-size:10px;background:#4da3ff22;color:#4da3ff}
#escala-painel .fases{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-top:8px}
#escala-painel .f{padding:12px;border-radius:10px;background:rgba(255,255,255,.03);
  border:1px solid rgba(255,255,255,.06);position:relative}
#escala-painel .f.on{border-color:#4da3ff55;background:#4da3ff11}
#escala-painel .f .n{color:#888;font-size:10px;text-transform:uppercase;letter-spacing:.06em}
#escala-painel .f .t{font-weight:600;font-size:13px;margin:2px 0 6px;color:#fff}
#escala-painel .f .d{color:#999;font-size:11px;line-height:1.4}
#escala-painel .f .eta{position:absolute;top:8px;right:10px;font-size:10px;color:#4da3ff}
#escala-painel .regra{margin-top:14px;padding:10px 14px;border-radius:8px;
  background:#e74c3c11;border:1px solid #e74c3c33;color:#e74c3c;font-size:11px}
#escala-painel .alertas{margin-top:12px;padding:10px 14px;border-radius:8px;
  background:#4da3ff11;border:1px solid #4da3ff33;font-size:11px}
#escala-painel .alertas div{padding:3px 0;color:#cce4ff}
#escala-painel .alertas div::before{content:"▶ ";color:#4da3ff;margin-right:4px}

@media (max-width:700px){
  #escala-painel .fases{grid-template-columns:1fr 1fr}
  #escala-btn{top:auto;bottom:16px;right:16px}
  #escala-painel{top:auto;bottom:60px;right:16px}
}
</style>

<button id="escala-btn">📋 Escala</button>

<div id="escala-painel">
  <h2>Plano de Escala</h2>
  <div class="sub">4 fases · crescer sem quebrar · leads nunca saem da máquina</div>

  <div class="fases">
    <div class="f on">
      <span class="eta">2h</span>
      <div class="n">Fase 1</div>
      <div class="t">Endurecer</div>
      <div class="d">Rotação metrics · launchd daemon · fix /static/</div>
    </div>
    <div class="f">
      <span class="eta">8h</span>
      <div class="n">Fase 2</div>
      <div class="t">Integrar</div>
      <div class="d">Leads + campanhas no painel (só local)</div>
    </div>
    <div class="f">
      <span class="eta">16h</span>
      <div class="n">Fase 3</div>
      <div class="t">Distribuir</div>
      <div class="d">VM standby · réplica SQLite · failover</div>
    </div>
    <div class="f">
      <span class="eta">∞</span>
      <div class="n">Fase 4</div>
      <div class="t">Observar</div>
      <div class="d">v11 preditiva · alertas WhatsApp</div>
    </div>
  </div>

  <h3>O que quebra primeiro</h3>
  <table>
    <tr><th>#</th><th>Limite</th><th>Quando estoura</th><th>Sintoma</th></tr>
    <tr><td>1</td><td>metrics.jsonl infinito</td><td>~2M linhas (~3 anos)</td><td class="warn">Leitura lenta</td></tr>
    <tr><td>2</td><td>HTTPServer + SSE</td><td>2+ abas abertas</td><td class="warn">/api/health timeout</td></tr>
    <tr><td>3</td><td>Watchdog single-thread</td><td>30+ serviços</td><td class="warn">Coleta &gt;15s</td></tr>
    <tr><td>4</td><td>RAM backend CRM</td><td>&gt;5.000 leads</td><td class="warn">Swap ativo</td></tr>
    <tr><td>5</td><td>Porta única :9100</td><td>Necessidade de HA</td><td class="warn">SPOF</td></tr>
  </table>

  <h3>Regras inegociáveis</h3>
  <table>
    <tr><th>Item</th><th>Regra</th></tr>
    <tr><td>Leads (592)</td><td class="off">Nunca para a nuvem — só local</td></tr>
    <tr><td>Campanhas</td><td class="off">Processadas só no Mac (PII)</td></tr>
    <tr><td>Ollama</td><td class="off">Fogão de casa — privacidade + zero custo</td></tr>
    <tr><td>Backend CRM</td><td class="off">Contém PII — nunca migra</td></tr>
    <tr><td>~/.hermes_env</td><td class="off">Chaves nunca saem da máquina</td></tr>
    <tr><td>Nuvem</td><td class="ok">Só processa o que é público</td></tr>
  </table>

  <div class="regra">
    ⛔ Leads · campanhas · CRM · chaves — nunca saem da máquina.
  </div>

  <div class="alertas" id="escala-alertas">
    <div>Carregando sugestões…</div>
  </div>
</div>

<script>
(function(){
  var btn = document.getElementById('escala-btn');
  var pnl = document.getElementById('escala-painel');
  if (!btn || !pnl) return;

  btn.addEventListener('click', function(e){
    e.stopPropagation();
    var aberto = pnl.classList.toggle('on');
    btn.classList.toggle('on', aberto);
    if (aberto) carregar();
  });

  // ESC fecha
  document.addEventListener('keydown', function(e){
    if (e.key === 'Escape' && pnl.classList.contains('on')){
      pnl.classList.remove('on');
      btn.classList.remove('on');
    }
  });

  function carregar(){
    var box = document.getElementById('escala-alertas');
    if (!box) return;
    fetch('/api/alerts?tipo=escala&limit=5', {cache:'no-store'})
      .then(function(r){ if (!r.ok) throw 0; return r.json(); })
      .then(function(arr){
        if (!arr || !arr.length){
          box.innerHTML = '<div>Nenhuma sugestão nova ainda</div>';
          return;
        }
        box.innerHTML = arr.slice(-5).map(function(a){
          return '<div>'+(a.msg||'')+'</div>';
        }).join('');
      })
      .catch(function(){
        box.innerHTML = '<div>Fase 4: acumulando amostras para v11 preditiva</div>'
                      + '<div>Fase 2: hora de integrar leads + campanhas (só local)</div>';
      });
  }
})();
</script>
<!-- ===== fim BOTÃO ESCALA ===== -->

</body></html>
