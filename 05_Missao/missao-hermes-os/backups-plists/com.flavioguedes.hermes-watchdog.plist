<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>Label</key><string>com.flavioguedes.hermes-watchdog</string>
<key>ProgramArguments</key><array><string>/Users/mac/.hermes/watchdog/hermes-watchdog.sh</string></array>
<key>RunAtLoad</key><true/>
<key>KeepAlive</key><false/>
<key>StartInterval</key><integer>30</integer>
<key>StandardOutPath</key><string>/Users/mac/.hermes/watchdog/launchd.log</string>
<key>StandardErrorPath</key><string>/Users/mac/.hermes/watchdog/launchd-error.log</string>
</dict></plist>
