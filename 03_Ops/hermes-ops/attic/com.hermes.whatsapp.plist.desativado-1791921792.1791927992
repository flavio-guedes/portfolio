<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.hermes.whatsapp</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/mac/hermes-work/_whatsapp_agendado.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Year</key><integer>2026</integer>
    <key>Month</key><integer>10</integer>
    <key>Day</key><integer>09</integer>
    <key>Hour</key><integer>13</integer>
    <key>Minute</key><integer>0</integer>
  </dict>
  <key>StandardOutPath</key><string>/Users/mac/hermes-work/agendamento.log</string>
  <key>StandardErrorPath</key><string>/Users/mac/hermes-work/agendamento.err</string>
</dict>
</plist>
