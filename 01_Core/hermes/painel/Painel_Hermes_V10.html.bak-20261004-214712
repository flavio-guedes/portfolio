    body.innerHTML=`
      <div class="sub" style="margin-bottom:14px">Onde vivem os blocos de chrome e qual a largura/altura de cada coluna.</div>
      <div class="cfg-row"><span class="grip">◎</span><div class="label">Modos</div><span></span>${posSeg('modesPosition',userCfg.layout.modesPosition)}</div>
      <div class="cfg-row"><span class="grip">◇</span><div class="label">Menu</div><span></span>${posSeg('navPosition',userCfg.layout.navPosition)}</div>
