    if(userCfg.layout.leftCollapsed) return;
    resizing=true; startX=e.clientX; startW=userCfg.layout.leftWidth||240;
    r.classList.add('dragging'); document.body.style.cursor='col-resize'; document.body.style.userSelect='none';
    document.addEventListener('mousemove',onMove); document.addEventListener('mouseup',onUp);
    e.preventDefault();
  });
}

