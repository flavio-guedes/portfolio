/* Prévia viva: quantos contatos a configuração atual realmente alcança.
   Sem isso o usuário descobre o tamanho do disparo só depois de enviar. */
function campPreviewTargets(form){
  const fd=new FormData(form);
  return campTargets({
    lista:String(fd.get('lista')||'base'),
    publico:{
      segmento:String(fd.get('segmento')||'').trim()||'Multi',
      cargo:String(fd.get('cargo')||'').trim()||'Decisor',
      localizacao:'BR'
    }
  });
}
function refreshCampPreview(form){
  const out=form.querySelector('[data-camp-preview]');
  if(!out) return;
  let n=0,comTel=0;
  try{
    const alvo=campPreviewTargets(form);
    n=alvo.length;
    comTel=alvo.filter(o=>normalizeBR(o.telefone)).length;
  }catch(e){}
  out.innerHTML=`<b>${fmtNum(n)}</b> contatos na origem · <b>${fmtNum(comTel)}</b> com telefone no formato brasileiro`;
}
function refreshCampEstilo(form){
  const sel=form.querySelector('[data-camp-estilo]');
  const hint=form.querySelector('[data-camp-estilo-hint]');
  const msg=form.querySelector('[data-camp-msg]');
  const k=sel?sel.value:'Direto';
  if(hint) hint.textContent=(ESTILO_ABORDAGEM[k]||{}).hint||'';
  /* Só preenche se o usuário não digitou nada. Mas trocar de estilo tem
     que trocar o texto: se o campo ainda é o que o painel sugeriu, ele
     não é do usuário. `touched` marca a partir da primeira edição manual. */
  if(msg&&!msg.dataset.touched) msg.value=((ESTILO_ABORDAGEM[k]||ESTILO_ABORDAGEM.Direto).template)||'';
}
function refreshCampWarn(form){
  const out=form.querySelector('[data-camp-warn]');
  if(!out) return;
  const fd=new FormData(form);
  const canais=fd.getAll('canais').map(String);
  const linhas=[];
  if(canais.includes('WhatsApp')&&!waPronto()){
    linhas.push('<b>WhatsApp sem integração.</b> Abrindo Ajustes › Integrações para apontar o seu servidor Baileys, ou o disparo vai falhar e as ações ficam em ERRO.');
  }
  if(!canais.includes('WhatsApp')&&canais.length){
    linhas.push('<b>Nenhum canal com envio real.</b> '+canais.join(', ')+' ainda não têm integração. As ações serão criadas, mas não sairão.');
  }
  const quando=String(fd.get('agendada_em')||'');
  if(quando&&new Date(quando).getTime()<Date.now()){
    linhas.push('<b>Data no passado.</b> Executar agora dispara na hora.');
  }
  out.innerHTML=linhas.length?linhas.join('<br><br>'):'';
  out.style.display=linhas.length?'':'none';
}
function saveCampaignFromForm(form,sugerida,executar){
  const fd=new FormData(form);
  const nome=String(fd.get('nome')||'').trim();
  if(!nome){ toast('Dê um nome à campanha'); return; }
  const canais=fd.getAll('canais').map(String);
  const etapas=String(fd.get('etapas')||'').split(',').map(s=>s.trim()).filter(Boolean);
  const agendada=String(fd.get('agendada_em')||'').trim();
  const c={
    id:nextCampaignId(), nome,
    objetivo:String(fd.get('objetivo')||'').trim()||'Sem objetivo definido',
    responsavel:String(fd.get('responsavel')||'').trim()||'Flávio',
    periodo:String(fd.get('periodo')||'').trim()||'a definir',
    status:executar?'EM EXECUÇÃO':String(fd.get('status')||'PLANEJADA'),
    lista:String(fd.get('lista')||'base'),
    publico:{
      segmento:String(fd.get('segmento')||'').trim()||'Multi',
      cargo:String(fd.get('cargo')||'').trim()||'Decisor',
      localizacao:'BR'
    },
    oferta:String(fd.get('oferta')||'').trim()||'a definir',
    cases:[],
    canais:canais.length?canais:['LinkedIn'],
    etapas:etapas.length?etapas:['Mapear','Abordar','Follow-up'],
    cadencia:String(fd.get('cadencia')||'').trim()||'Toque único',
    estilo:String(fd.get('estilo')||'Direto').trim(),
    mensagem:String(fd.get('mensagem')||'').trim(),
    volume_dia:Math.max(1,parseInt(String(fd.get('volume_dia')||'30'),10)||30),
    agendada_em:agendada||null,
    metricas:{enviados:0,respondidos:0,conversas:0,reunioes:0,propostas:0,ganhos:0},
    nota:String(fd.get('nota')||'').trim(),
