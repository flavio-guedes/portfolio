        <div class="seg-control" data-seg="font" style="flex-wrap:wrap">
          ${Object.entries(FONT_CHOICES).map(([k,f])=>`<button data-val="${k}" class="${(userCfg.appearance.font||'manrope')===k?'active':''}" style="font-family:${f.stack}">${esc(f.label)}</button>`).join('')}
        </div>
        <div class="sub" style="text-align:right">${esc((FONT_CHOICES[userCfg.appearance.font||'manrope']||FONT_CHOICES.manrope).hint)}</div>
      </div>`;
    body.querySelectorAll('[data-app="theme"]').forEach(b=>b.addEventListener('click',()=>{
      userCfg.appearance.theme=(userCfg.appearance.theme||'dark')==='light'?'dark':'light';
      saveConfig(); applyAppearance(); render(); renderSettingsTab();
    }));
    body.querySelectorAll('[data-seg="contrast"] button').forEach(b=>b.addEventListener('click',()=>{
      userCfg.appearance.contrast=b.dataset.val; saveConfig(); applyAppearance(); render(); renderSettingsTab();
    }));
    body.querySelectorAll('[data-seg="font"] button').forEach(b=>b.addEventListener('click',()=>{
      const k=b.dataset.val;
      if(!FONT_CHOICES[k]) return;
      userCfg.appearance.font=k; saveConfig(); applyAppearance(); render(); renderSettingsTab();
    }));
    body.querySelectorAll('[data-app="density"]').forEach(b=>b.addEventListener('click',()=>{
      userCfg.appearance.density=userCfg.appearance.density==='compact'?'comfortable':'compact';
      saveConfig(); renderSettingsTab();
    }));
  } else if(settingsTab==='integracoes'){
    const c=baileyConfig();
    body.innerHTML=`
      <div class="sub" style="margin-bottom:14px">Envio real de WhatsApp por um servidor Baileys que você roda. Fica salvo só neste navegador.</div>
      <div style="border:1px solid ${waPronto()?'var(--ok-bd)':'var(--warn-bd)'};background:${waPronto()?'var(--ok-bg)':'var(--warn-bg)'};border-radius:12px;padding:12px 14px;margin-bottom:16px">
        <div class="label">${waPronto()?'● Baileys configurado':'● Baileys não configurado'}</div>
        <div class="sub" style="margin-top:4px">${waPronto()
          ?'As campanhas com WhatsApp vão chamar seu servidor de verdade.'
          :'Sem URL abaixo, o painel <b>não envia</b> e marca a ação como não despachada. Não existe envio simulado.'}</div>
      </div>
      <label class="cfg-label">URL do servidor Baileys
        <input name="ba_url" value="${esc(c.url||'')}" placeholder="http://127.0.0.1:8080">
      </label>
      <label class="cfg-label">Token (opcional)
        <input name="ba_token" type="password" value="${esc(c.token||'')}" placeholder="se o seu servidor pedir">
      </label>
      <div class="cfg-row" style="grid-template-columns:1fr 1fr;gap:10px">
        <label class="cfg-label">Caminho do envio<input name="ba_path" value="${esc(c.sendPath||'/send')}" placeholder="/send"></label>
        <label class="cfg-label">Campo do número<input name="ba_to" value="${esc(c.fieldTo||'number')}" placeholder="number"></label>
      </div>
      <label class="cfg-label">Campo do texto<input name="ba_text" value="${esc(c.fieldText||'message')}" placeholder="message"></label>
      <label class="cfg-label">Sufixo do destinatário
        <input name="ba_jid" value="${esc(c.jidSuffix||'')}" placeholder="@s.whatsapp.net">
      </label>
      <div class="sub" style="margin:8px 0 14px;line-height:1.6">A ponte HTTP do Baileys não tem um formato único, por isso o caminho e o nome dos campos são configuráveis. O painel sempre envia <code>POST</code> com JSON. Se a sua ponte exigir o JID completo, use <code>@s.whatsapp.net</code> no sufixo.</div>
      <div style="display:flex;gap:8px;flex-wrap:wrap">
        <button class="btn primary sm" data-ba-save>Salvar</button>
        <button class="btn sm" data-ba-test>Testar envio</button>
      </div>
