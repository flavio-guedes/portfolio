function renderSidebar(){
  const showModes=userCfg.layout.modesPosition==='sidebar';
  const showNav=userCfg.layout.navPosition==='sidebar';
  const showFilters=userCfg.layout.filtersPosition==='sidebar';
  if(!showModes&&!showNav&&!showFilters){
