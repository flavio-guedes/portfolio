/* Faz polling no módulo local. Sem endpoint de conversas, o painel cai no
   snapshot e diz isso — não inventa mensagem que não chegou. */
async function pollLiveFeed(){
  const lv=liveState();
  try{
    const r=await fetch(CONV_FEED_URL,{cache:'no-store'});
    if(r.ok){
      const d=await r.json();
      const incoming=Array.isArray(d)?d:(d.conversas||d.conversations||[]);
      if(incoming.length){
        const have=new Set(state.conversations.map(c=>c.id));
        incoming.forEach(c=>{
          if(c&&c.id&&!have.has(c.id)){
            if(CHANNEL_STATUS[c.canal]&&CHANNEL_STATUS[c.canal].conectado) state.conversations.push(c);
            have.add(c.id);
          }
        });
      }
      lv.status='ao-vivo';
      lv.erro='';
    }else lv.status='sem-fonte';
  }catch(e){
    lv.status='sem-fonte';
    lv.erro='Módulo local não expõe histórico de conversas ainda ('+CONV_FEED_URL+'). O feed usa o último registro conhecido.';
  }
  lv.ultimo=new Date().toLocaleTimeString('pt-BR',{hour:'2-digit',minute:'2-digit',second:'2-digit'});
  const box=$('#liveFeedList');
  if(box&&box.dataset.compact){ box.outerHTML=convListHTML(); return; }
  if(box) box.outerHTML=liveFeedHTML().match(/<div id="liveFeedList">[\s\S]*?<\/div>\s*(?:<\/div>)?/)?.[0]||box.outerHTML;
}
function startLiveFeed(){
  if(state.liveTimer) return;
  pollLiveFeed();
  state.liveTimer=setInterval(pollLiveFeed,20000);
}
