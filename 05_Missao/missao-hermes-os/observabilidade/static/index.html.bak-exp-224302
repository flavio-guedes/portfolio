          <div style="color:#888;font-size:10px;text-transform:uppercase;letter-spacing:.06em">Fase 1</div>
          <div style="font-weight:600;font-size:13px;margin:2px 0 6px">Endurecer</div>
          <div style="color:#999;font-size:11px;line-height:1.4">Rotação metrics · launchd daemon · fix /static/</div>
        </div>
        <div style="padding:12px;border-radius:10px;background:rgba(255,255,255,.03);border:1px solid rgba(255,255,255,.06);position:relative">
          <div style="position:absolute;top:8px;right:10px;font-size:10px;color:#4da3ff">8h</div>
          <div style="color:#888;font-size:10px;text-transform:uppercase;letter-spacing:.06em">Fase 2</div>
          <div style="font-weight:600;font-size:13px;margin:2px 0 6px">Integrar</div>
          <div style="color:#999;font-size:11px;line-height:1.4">Leads + campanhas no painel (só local)</div>
        </div>
        <div style="padding:12px;border-radius:10px;background:rgba(255,255,255,.03);border:1px solid rgba(255,255,255,.06);position:relative">
          <div style="position:absolute;top:8px;right:10px;font-size:10px;color:#4da3ff">16h</div>
          <div style="color:#888;font-size:10px;text-transform:uppercase;letter-spacing:.06em">Fase 3</div>
          <div style="font-weight:600;font-size:13px;margin:2px 0 6px">Distribuir</div>
          <div style="color:#999;font-size:11px;line-height:1.4">VM standby · réplica SQLite · failover</div>
        </div>
        <div style="padding:12px;border-radius:10px;background:rgba(255,255,255,.03);border:1px solid rgba(255,255,255,.06);position:relative">
          <div style="position:absolute;top:8px;right:10px;font-size:10px;color:#4da3ff">∞</div>
          <div style="color:#888;font-size:10px;text-transform:uppercase;letter-spacing:.06em">Fase 4</div>
          <div style="font-weight:600;font-size:13px;margin:2px 0 6px">Observar</div>
          <div style="color:#999;font-size:11px;line-height:1.4">v11 preditiva · alertas WhatsApp</div>
        </div>
      </div>

      <h3 style="font-size:13px;color:#aaa;text-transform:uppercase;letter-spacing:.08em;font-weight:500;margin:20px 0 8px">O que quebra primeiro</h3>
      <table style="width:100%;border-collapse:collapse;font-size:12px">
        <tr><th style="text-align:left;color:#888;font-weight:500;padding:8px 10px;border-bottom:1px solid rgba(255,255,255,.1);text-transform:uppercase;font-size:10px;letter-spacing:.05em">#</th>
            <th style="text-align:left;color:#888;font-weight:500;padding:8px 10px;border-bottom:1px solid rgba(255,255,255,.1);text-transform:uppercase;font-size:10px;letter-spacing:.05em">Limite</th>
            <th style="text-align:left;color:#888;font-weight:500;padding:8px 10px;border-bottom:1px solid rgba(255,255,255,.1);text-transform:uppercase;font-size:10px;letter-spacing:.05em">Quando</th>
            <th style="text-align:left;color:#888;font-weight:500;padding:8px 10px;border-bottom:1px solid rgba(255,255,255,.1);text-transform:uppercase;font-size:10px;letter-spacing:.05em">Sintoma</th></tr>
        <tr><td style="padding:8px 10px;border-bottom:1px solid rgba(255,255,255,.04)">1</td><td style="padding:8px 10px;border-bottom:1px solid rgba(255,255,255,.04)">metrics.jsonl infinito</td><td style="padding:8px 10px;border-bottom:1px solid rgba(255,255,255,.04)">~2M linhas (~3 anos)</td><td style="padding:8px 10px;border-bottom:1px solid rgba(255,255,255,.04);color:#f1c40f">Leitura lenta</td></tr>
        <tr><td style="padding:8px 10px;border-bottom:1px solid rgba(255,255,255,.04)">2</td><td style="padding:8px 10px;border-bottom:1px solid rgba(255,255,255,.04)">HTTPServer + SSE</td><td style="padding:8px 10px;border-bottom:1px solid rgba(255,255,255,.04)">2+ abas abertas</td><td style="padding:8px 10px;border-bottom:1px solid rgba(255,255,255,.04);color:#f1c40f">/api/health timeout</td></tr>
        <tr><td style="padding:8px 10px;border-bottom:1px solid rgba(255,255,255,.04)">3</td><td style="padding:8px 10px;border-bottom:1px solid rgba(255,255,255,.04)">Watchdog single-thread</td><td style="padding:8px 10px;border-bottom:1px solid rgba(255,255,255,.04)">30+ serviços</td><td style="padding:8px 10px;border-bottom:1px solid rgba(255,255,255,.04);color:#f1c40f">Coleta &gt;15s</td></tr>
        <tr><td style="padding:8px 10px;border-bottom:1px solid rgba(255,255,255,.04)">4</td><td style="padding:8px 10px;border-bottom:1px solid rgba(255,255,255,.04)">RAM backend CRM</td><td style="padding:8px 10px;border-bottom:1px solid rgba(255,255,255,.04)">&gt;5.000 leads</td><td style="padding:8px 10px;border-bottom:1px solid rgba(255,255,255,.04);color:#f1c40f">Swap ativo</td></tr>
        <tr><td style="padding:8px 10px;border-bottom:1px solid rgba(255,255,255,.04)">5</td><td style="padding:8px 10px;border-bottom:1px solid rgba(255,255,255,.04)">Porta única :9100</td><td style="padding:8px 10px;border-bottom:1px solid rgba(255,255,255,.04)">Necessidade de HA</td><td style="padding:8px 10px;border-bottom:1px solid rgba(255,255,255,.04);color:#f1c40f">SPOF</td></tr>
      </table>

      <h3 style="font-size:13px;color:#aaa;text-transform:uppercase;letter-spacing:.08em;font-weight:500;margin:20px 0 8px">Regras inegociáveis</h3>
      <table style="width:100%;border-collapse:collapse;font-size:12px">
        <tr><th style="text-align:left;color:#888;font-weight:500;padding:8px 10px;border-bottom:1px solid rgba(255,255,255,.1);text-transform:uppercase;font-size:10px;letter-spacing:.05em">Item</th>
            <th style="text-align:left;color:#888;font-weight:500;padding:8px 10px;border-bottom:1px solid rgba(255,255,255,.1);text-transform:uppercase;font-size:10px;letter-spacing:.05em">Regra</th></tr>
        <tr><td style="padding:8px 10px;border-bottom:1px solid rgba(255,255,255,.04)">Leads (592)</td><td style="padding:8px 10px;border-bottom:1px solid rgba(255,255,255,.04);color:#888">Nunca para a nuvem — só local</td></tr>
        <tr><td style="padding:8px 10px;border-bottom:1px solid rgba(255,255,255,.04)">Campanhas</td><td style="padding:8px 10px;border-bottom:1px solid rgba(255,255,255,.04);color:#888">Processadas só no Mac (PII)</td></tr>
        <tr><td style="padding:8px 10px;border-bottom:1px solid rgba(255,255,255,.04)">Ollama</td><td style="padding:8px 10px;border-bottom:1px solid rgba(255,255,255,.04);color:#888">Fogão de casa — privacidade + zero custo</td></tr>
        <tr><td style="padding:8px 10px;border-bottom:1px solid rgba(255,255,255,.04)">Backend CRM</td><td style="padding:8px 10px;border-bottom:1px solid rgba(255,255,255,.04);color:#888">Contém PII — nunca migra</td></tr>
        <tr><td style="padding:8px 10px;border-bottom:1px solid rgba(255,255,255,.04)">~/.hermes_env</td><td style="padding:8px 10px;border-bottom:1px solid rgba(255,255,255,.04);color:#888">Chaves nunca saem da máquina</td></tr>
        <tr><td style="padding:8px 10px">Nuvem</td><td style="padding:8px 10px;color:#2ecc71">Só processa o que é público</td></tr>
      </table>

      <div style="margin-top:16px;padding:10px 14px;border-radius:8px;background:rgba(231,76,60,.07);border:1px solid rgba(231,76,60,.2);color:#e74c3c;font-size:11px">
        ⛔ Leads · campanhas · CRM · chaves — nunca saem da máquina.
      </div>

      <div id="escala-alertas-box" style="margin-top:12px;padding:10px 14px;border-radius:8px;background:rgba(77,163,255,.07);border:1px solid rgba(77,163,255,.2);font-size:11px">
        <div style="color:#cce4ff">▶ Carregando sugestões…</div>
      </div>
    </div>
  `;

  function injetar(){
    var tabs = document.getElementById('tabs');
    if (!tabs) return;
    if (tabs.querySelector('#tab-escala')) return;

    var btn = document.createElement('div');
    btn.className = 'tb';
    btn.id = 'tab-escala';
    btn.setAttribute('data-tab','escala');
    btn.innerHTML = '<span>Escala</span>';
    btn.style.cursor = 'pointer';

    btn.onclick = function(e){
      e.stopPropagation();
      tabs.querySelectorAll('.tb').forEach(function(x){ x.classList.remove('on'); });
      btn.classList.add('on');

      var pb = document.getElementById('pbody');
      var pt = document.getElementById('ptitle');
      if (pt) pt.innerHTML = 'Plano de Escala';
      if (pb) {
        pb.innerHTML = HTML_ESCALA;
        carregar();
      }
    };

    tabs.appendChild(btn);
  }

  function carregar(){
    var box = document.getElementById('escala-alertas-box');
    if (!box) return;
    fetch('/api/alerts?tipo=escala&limit=5', {cache:'no-store'})
      .then(function(r){ if (!r.ok) throw 0; return r.json(); })
      .then(function(arr){
        if (!arr || !arr.length){
          box.innerHTML = '<div style="color:#cce4ff">▶ Nenhuma sugestão nova ainda</div>';
          return;
        }
        box.innerHTML = arr.slice(-5).map(function(a){
          return '<div style="padding:3px 0;color:#cce4ff">▶ '+(a.msg||'')+'</div>';
        }).join('');
      })
      .catch(function(){
        box.innerHTML = '<div style="padding:3px 0;color:#cce4ff">▶ Fase 4: acumulando amostras para v11 preditiva</div>'
                      + '<div style="padding:3px 0;color:#cce4ff">▶ Fase 2: hora de integrar leads + campanhas (só local)</div>';
      });
  }

  function start(){
    var tabs = document.getElementById('tabs');
    if (!tabs){ setTimeout(start, 200); return; }

    var obs = new MutationObserver(function(){
      if (!tabs.querySelector('#tab-escala')) injetar();
    });
    obs.observe(tabs, {childList: true});

    injetar();
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', start);
  else start();
})();
</script>
<!-- ===== fim MENU ESCALA ===== -->

