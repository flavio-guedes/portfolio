/* ============ DASHBOARDS ============ */
function deriveDashData(dim){
  const o=state.opportunities;
  const groups={};
  o.forEach(x=>{
    const key=x[dim]||'—';
    if(!groups[key]) groups[key]={total:0,quentes:0,respondidos:0,reunioes:0,aberto:0};
    groups[key].total++;
    if(x.temperatura==='Quente'||x.temperatura==='Muito quente') groups[key].quentes++;
    if(x.estagio==='Conversa') groups[key].respondidos++;
    if(x.estagio==='Fechado') groups[key].reunioes++;
    if(x.estagio!=='Fechado'&&x.estagio!=='Perdido') groups[key].aberto++;
  });
  return Object.entries(groups).sort((a,b)=>b[1].total-a[1].total);
}
