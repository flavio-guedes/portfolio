  if(recBtn){
    e.stopPropagation();
    const id=recBtn.dataset.recId, dec=recBtn.dataset.recDecision;
    if(dec==='schedule'){ state.recommendScheduling=id; refreshRecommendSection(); }
    else handleRecommendDecision(id,dec);
    return;
  }
  const recConfirm=e.target.closest('[data-rec-confirm-schedule]');
  if(recConfirm){
    e.stopPropagation();
    const id=recConfirm.dataset.recConfirmSchedule;
    const input=document.querySelector('#scheduleInput-'+id);
    const when=input?input.value:suggestDate(1);
    if(when) handleRecommendDecision(id,'schedule',when);
    return;
  }
  const recCancel=e.target.closest('[data-rec-cancel-schedule]');
  if(recCancel){ e.stopPropagation(); state.recommendScheduling=null; refreshRecommendSection(); return; }
  const recReset=e.target.closest('[data-rec-reset]');
  if(recReset){ e.stopPropagation(); delete state.recommendDecisions[recReset.dataset.recReset]; refreshRecommendSection(); return; }
  if(e.target.closest('#clearRecFilters')){
    e.stopPropagation();
    state.recommendFilter={dim1:'none',val1:'all',dim2:'none',val2:'all',dim3:'none',val3:'all',count:2};
    state.recommendScope='all'; state.recommendTarget='all';
    refreshRecommendSection(); return;
  }
  if(e.target.closest('#recAddFilter')){
    e.stopPropagation();
    if(state.recommendFilter.count<3) state.recommendFilter.count++;
    refreshRecommendSection(); return;
  }
  if(e.target.closest('#recRemoveFilter')){
    e.stopPropagation();
    if(state.recommendFilter.count>1){
      state.recommendFilter.count--;
      const k='dim'+(state.recommendFilter.count+1), vk='val'+(state.recommendFilter.count+1);
      state.recommendFilter[k]='none'; state.recommendFilter[vk]='all';
    }
    refreshRecommendSection(); return;
  }
  if(e.target.closest('[data-approve-all]')){
    e.stopPropagation();
    if(confirm('Autorizar TODAS as recomendações pendentes?')){
      getRecommendations().filter(r=>r.status==='pending').forEach(r=>{
        state.recommendDecisions[r.id]={status:'approved'};
        createActionFromRecommendation(r,r.prazo);
      });
      toast('Todas autorizadas'); refreshRecommendSection();
    }
    return;
  }
  // Fila: um clique isola a situação, um segundo clique no mesmo grupo volta
  // para "tudo". Sem estado escondido — sempre dá para desfazer no lugar.
  const fFila=e.target.closest('[data-fila-filtro]');
  if(fFila){
    e.stopPropagation();
    const v=fFila.dataset.filaFiltro;
    state.filaFiltro=(v==='tudo'||state.filaFiltro===v)?'tudo':v;
    render();
    return;
  }
  const opJump=e.target.closest('[data-op-jump]');
  if(opJump){
    e.stopPropagation();
    const k=opJump.dataset.opOpen; if(k){ (state.opOpen=state.opOpen||{})[k]=true; render(); }
    const alvo=document.getElementById(opJump.dataset.opJump);
    if(alvo) alvo.scrollIntoView({behavior:'smooth',block:'start'});
    return;
  }
  const opFold=e.target.closest('details[data-op-keep] > summary');
  if(opFold){
    const box=opFold.parentElement;
    setTimeout(()=>{ (state.opOpen=state.opOpen||{})[box.dataset.opKeep]=box.open; },0);
    return;
  }
  const opConvAll=e.target.closest('[data-op-conv-all]');
  if(opConvAll){ e.stopPropagation(); state.opConvAll=!state.opConvAll; render(); return; }
  const fHoras=e.target.closest('[data-agenda-horas]');
  if(fHoras){ e.stopPropagation(); state.agendaHoras=Number(fHoras.dataset.agendaHoras)||24; render(); return; }
  // Histórico recolhido: guardar o estado evita que o painel feche a cada
  // redesenho do relógio.
  const fHist=e.target.closest('.hist-box summary');
  if(fHist){
    const box=fHist.parentElement;
    setTimeout(()=>{ state.execHistOpen=box.open; },0);
    return;
  }
  // Em execução: filtros
  const fFonte=e.target.closest('[data-exec-fonte]');
  if(fFonte){ e.stopPropagation(); state.executionFilters.fonte=fFonte.dataset.execFonte; render(); return; }
  const fStatus=e.target.closest('[data-exec-status]');
  if(fStatus){ e.stopPropagation(); state.executionFilters.status=fStatus.dataset.execStatus; render(); return; }
  // Em execução: expandir inline
  const execToggle=e.target.closest('[data-exec-toggle]');
  if(execToggle){
    e.stopPropagation();
    const id=execToggle.dataset.execToggle;
    state.executionExpanded[id]=!state.executionExpanded[id];
    render();
    return;
  }
  const execProc=e.target.closest('[data-exec-process]');
  if(execProc){ e.stopPropagation(); toast('Abrindo processo · '+execProc.dataset.execProcess); return; }
  // Comandos
  const cmd=e.target.closest('[data-cmd]');
  if(cmd){ e.stopPropagation(); sendCommand(cmd.dataset.cmd,cmd.dataset.actionId); return; }
  // Nav
  const navBtn=e.target.closest('[data-view]');
  if(navBtn && !navBtn.closest('#sidebar') && !navBtn.closest('#topbar') && !navBtn.closest('#appFooter')){
    e.preventDefault(); setView(navBtn.dataset.view); return;
  }
  const openOpp=e.target.closest('[data-open]');
  if(openOpp&&openOpp.dataset.open){ drawerOpportunity(openOpp.dataset.open); return; }
  const openCamp=e.target.closest('[data-open-campaign]');
  if(openCamp){ drawerCampaign(openCamp.dataset.openCampaign); return; }
  const openProj=e.target.closest('[data-open-project]');
  if(openProj){ drawerProject(openProj.dataset.openProject); return; }
  const openConv=e.target.closest('[data-open-conversation]');
  if(openConv){ drawerConversation(openConv.dataset.openConversation); return; }
  if(e.target.closest('[data-close]')||e.target.id==='backdrop'){ closeBackdrop(); return; }
});
document.addEventListener('submit',e=>{
  const f=e.target;
  if(f.matches('[data-form-busca]')){ e.preventDefault(); executarBuscaLead(); return; }
  if(f.matches('[data-form-avulso]')){ e.preventDefault(); enviarAvulso(f); return; }
  if(f.matches('[data-form-campaign]')){
    e.preventDefault();
    /* O botão que disparou decide se a campanha nasce rodando ou parada.
       `submitter` é o único lugar confiável: o form tem dois submits. */
    const run=!!(e.submitter&&e.submitter.matches('[data-camp-run]'));
    saveCampaignFromForm(f, f.dataset.sugerida==='1', run);
    return;
  }
  if(f.matches('[data-form-acao]')){ e.preventDefault(); saveActionFromForm(f); return; }
  if(f.matches('[data-form-list]')){ e.preventDefault(); saveListFromForm(f,{filterName:f.dataset.filterName||null}); return; }
  if(f.matches('[data-form-import-list]')){ e.preventDefault(); importListFromForm(f); return; }
});
document.addEventListener('input',e=>{
  if(!e.target.closest('[data-form-import-list]')) return;
