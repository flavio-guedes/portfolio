}
/* ---- Ciclo de vida da campanha: pausar, retomar, excluir --------------
   Tudo passa pelo userStore porque é ele que sobrevive ao reload; o
   state.campaigns é só o espelho em memória. */
function setCampaignStatus(id,status){
  const store=loadUserStore();
  const c=store.campanhas.find(x=>x.id===id);
  if(!c) return false;
  c.status=status;
  saveUserStore(store);
  const naMemoria=state.campaigns.find(x=>x.id===id);
  if(naMemoria) naMemoria.status=status;
  render();
  return true;
}
