def send_loop(tipo):
    """Loop com burst: se um envio falha, tenta o próximo IMEDIATAMENTE (sem esperar cadência)."""
    k_ativ = f"env_{tipo}"
    burst = 0            # tentativas imediatas seguidas
    BURST_MAX = 20       # limite por rajada, pra não varrer a fila toda de uma vez
    while True:
        time.sleep(0.4 if burst > 0 else 1)
        if not EST[k_ativ]: 
            burst = 0
            continue
        if not EST["lock"].acquire(blocking=False): continue
        try:
            d = load(FILA)
            if not d: continue
            pend = sorted([i for i in d["itens"]
                           if i["status"]=="AGENDADO" and i["tipo"]==tipo],
                          key=lambda x:x["prazo"])
            if not pend:
                EST[k_ativ] = False; EST["msg"] = f"{tipo} concluída"; continue
            p = pend[0]

            # burst ativo pula a espera do prazo
            if burst == 0:
                try:
                    alvo_dt = datetime.strptime(p["prazo"], "%Y-%m-%d %H:%M:%S")
                    esp = (alvo_dt - datetime.now()).total_seconds()
                    if esp > 0:
                        EST["msg"] = f"aguardando {int(esp)}s → {p['empresa'][:30]}"
                        continue
                except: pass

            h = health()
            if not h or h.get("status")!="connected":
                EST["msg"] = "bridge desconectado"; continue

            r = send1(p["chatId"], p["mensagem"])

            for i in d["itens"]:
                if i["id"]==p["id"]:
                    if r.get("success"):
                        i["status"]="OK"; i["enviado_em"]=now()
                        i["etapa"]=prox_etapa(i.get("etapa","D0"))
                        EST["ok"] += 1
                        EST["msg"] = f"✓ {p['empresa'][:30]}"
                        burst = 0    # sucesso volta à cadência normal
                    else:
                        # ERRO: marca e dispara próximo imediatamente
                        err = str(r)[:80]
                        i["status"]="ERRO"; i["erro"]=err
                        EST["err"] += 1
                        # guarda o motivo pra mostrar "sem WhatsApp" quando for o caso
                        if any(t in err.lower() for t in ["not registered","no whatsapp","invalid number","not on whatsapp"]):
                            i["erro"] = "sem WhatsApp: " + err
                            EST["msg"] = f"⊘ {p['empresa'][:24]} sem WhatsApp — pulando"
                        else:
                            EST["msg"] = f"✗ {p['empresa'][:24]} — pulando"
                        # ativa burst: próximo imediato
                        burst += 1
                        if burst >= BURST_MAX:
                            burst = 0
                            EST["msg"] = f"⏸ pausa anti-loop ({BURST_MAX} erros seguidos)"
            save(FILA, d)
        finally:
            EST["lock"].release()



def ordenada(fila):
    if not fila: return []
    it = fila["itens"]
    p = sorted([i for i in it if i["status"]=="AGENDADO"], key=lambda x:x["prazo"])
    f = sorted([i for i in it if i["status"]!="AGENDADO"],
               key=lambda x:x.get("enviado_em") or "", reverse=True)
    return p + f

