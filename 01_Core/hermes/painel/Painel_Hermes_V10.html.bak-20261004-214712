function agoLabel(iso){
  const t=new Date(iso||'').getTime();
  if(!t||isNaN(t)) return '—';
  const s=Math.max(0,Math.round((Date.now()-t)/1000));
  if(s<60) return `há ${s}s`;
  if(s<3600) return `há ${Math.floor(s/60)} min`;
  if(s<86400) return `há ${Math.floor(s/3600)} h`;
