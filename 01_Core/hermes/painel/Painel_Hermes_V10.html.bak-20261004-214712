function campLeadsRefresh(id,full){
  const c=campaignOf(id); if(!c) return;
  const wrap=document.querySelector(`[data-camp-leads="${CSS.escape(id)}"]`); if(!wrap) return;
  if(full){
    const had=document.activeElement&&document.activeElement.matches('[data-cl-q]');
    wrap.outerHTML=campLeadsHTML(c);
    if(had){ const i=document.querySelector(`[data-cl-q="${CSS.escape(id)}"]`); if(i){ i.focus(); i.setSelectionRange(i.value.length,i.value.length); } }
