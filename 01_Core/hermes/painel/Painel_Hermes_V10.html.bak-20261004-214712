function importListFromForm(form){
  const fd=new FormData(form);
  const nome=String(fd.get('nome')||'').trim();
  const csv=String(fd.get('csv')||'');
  const grupos=String(fd.get('grupos')||'A,B').split(',').map(s=>s.trim()).filter(Boolean);
  if(!nome){ toast('Dê um nome à lista'); return; }
  if(!csv.trim()){ toast('Cole o conteúdo do CSV'); return; }
  let parsed;
  try{ parsed=importCSV(csv,{grupos}); }
  catch(e){ toast('CSV inválido: '+e.message); return; }
  if(!parsed.opportunities.length){ toast('Nenhum lead encontrado no CSV'); return; }
  const known=new Set(state.opportunities.map(o=>o.id));
  const novos=parsed.opportunities.filter(o=>!known.has(o.id));
  const store=loadUserStore();
  if(novos.length){
    state.opportunities=state.opportunities.concat(novos);
    rebuildOppIndex();
    store.leadsExtras=store.leadsExtras||[];
    store.leadsExtras=store.leadsExtras.concat(novos);
    saveUserStore(store);
  }
  const dup=store.listas.find(l=>l.nome.toLowerCase()===nome.toLowerCase());
  if(dup){
    const seen=new Set(dup.ids);
    parsed.opportunities.forEach(o=>{ if(!seen.has(o.id)) dup.ids.push(o.id); });
    state.listasFilter='u:'+dup.id;
    closeBackdrop(); render();
    toast(`Lista ${dup.nome} atualizada · ${dup.ids.length} leads`);
    return;
  }
  const l={id:nextListId(),nome,ids:parsed.opportunities.map(o=>o.id),filtro:`importado · ${grupos.join('+')}`,criadaEm:new Date().toISOString()};
  store.listas.push(l);
  saveUserStore(store);
  state.listasFilter='u:'+l.id;
  state.view='listas'; userCfg.mode='listas';
  closeBackdrop(); applyAppearance(); render();
  toast(`Lista criada: ${l.nome} · ${l.ids.length} leads${novos.length?` (${novos.length} novos)`:''}`);
}

