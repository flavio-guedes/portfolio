<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<title>Hermes OS · Evolução com Checkpoints</title>
<style>
:root{
 --bg:#0a0b0d; --s1:rgba(26,28,32,.6); --s2:rgba(38,41,46,.7);
 --st:rgba(255,255,255,.055); --st2:rgba(255,255,255,.12);
 --t1:#d3d7de; --t2:#959aa4; --t3:#666a73; --t4:#41444c;
 --ok:#6ee7a5; --warn:#f2c94c; --err:#f27a7a; --info:#8ca8d8; --accent:#9aa3b0;
 --g1:linear-gradient(135deg,#b6bcc6 0%,#8b909a 50%,#6c7079 100%);
 --g2:linear-gradient(90deg,rgba(140,145,155,.4),rgba(90,95,105,.4),rgba(70,74,82,.4));
}
*{box-sizing:border-box;margin:0;padding:0}
html,body{min-height:100%}
body{font-family:-apple-system,BlinkMacSystemFont,'Inter',system-ui,sans-serif;
 background:var(--bg);color:var(--t1);font-size:15px;line-height:1.55;
 -webkit-font-smoothing:antialiased}
#bg{position:fixed;inset:0;z-index:0;overflow:hidden;pointer-events:none}
.bl{position:absolute;inset:-25%}
.bl1{background:
 radial-gradient(circle at 22% 18%,rgba(130,136,148,.1),transparent 48%),
 radial-gradient(circle at 78% 82%,rgba(80,86,96,.1),transparent 52%),
 radial-gradient(circle at 55% 45%,rgba(110,116,128,.06),transparent 55%);}
.bl2{background-image:
 linear-gradient(rgba(255,255,255,.02) 1px,transparent 1px),
 linear-gradient(90deg,rgba(255,255,255,.02) 1px,transparent 1px);
 background-size:60px 60px;
 mask-image:radial-gradient(ellipse at center,black 20%,transparent 85%);
 -webkit-mask-image:radial-gradient(ellipse at center,black 20%,transparent 85%);}
.nz{position:absolute;inset:0;opacity:.028;
 background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='120' height='120'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='2'/></filter><rect width='100%25' height='100%25' filter='url(%23n)'/></svg>");}

.wrap{position:relative;z-index:1;max-width:1340px;margin:0 auto;padding:32px 24px 80px}

/* HEADER */
header{display:flex;align-items:center;gap:16px;padding:18px 24px;border-radius:16px;
 background:var(--s1);backdrop-filter:blur(24px) saturate(150%);
 border:1px solid var(--st);position:relative;overflow:hidden;margin-bottom:28px}
header::before{content:'';position:absolute;inset:0;border-radius:16px;padding:1px;
 background:var(--g2);-webkit-mask:linear-gradient(#000 0 0) content-box,linear-gradient(#000 0 0);
 -webkit-mask-composite:xor;mask-composite:exclude;opacity:.4;pointer-events:none}
header::after{content:'';position:absolute;top:0;left:-40%;width:40%;height:100%;
 background:linear-gradient(90deg,transparent,rgba(180,190,205,.07),transparent);
 animation:shimmer 9s ease-in-out infinite;pointer-events:none}
@keyframes shimmer{0%,100%{left:-40%}50%{left:120%}}
header .logo{width:44px;height:44px;border-radius:12px;
 background:linear-gradient(135deg,#3a3e46,#22252a);
 border:1px solid var(--st2);display:flex;align-items:center;justify-content:center;color:var(--t2)}
header h1{font-size:22px;font-weight:800;letter-spacing:.5px;
 background:linear-gradient(135deg,#e4e8ee 0%,#8c919c 100%);
 -webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}
header .sub{font-size:12px;font-weight:600;letter-spacing:1.2px;color:var(--t3);
 text-transform:uppercase;margin-top:2px}
header .pill{margin-left:auto;display:flex;align-items:center;gap:10px;padding:8px 16px;
 border-radius:999px;background:var(--s2);border:1px solid var(--st2);font-size:12.5px}
header .dot{width:8px;height:8px;border-radius:50%;background:var(--ok);
 box-shadow:0 0 10px var(--ok);animation:pulse 2.2s ease-in-out infinite}
@keyframes pulse{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.55;transform:scale(.9)}}

/* SEÇÕES */
section{margin-bottom:36px}
h2{font-size:14px;font-weight:800;letter-spacing:1.5px;text-transform:uppercase;
 color:var(--t3);margin-bottom:18px;display:flex;align-items:center;gap:12px}
h2::before{content:'';width:3px;height:16px;border-radius:2px;background:var(--g1)}

/* PROGRESSO GERAL */
.prog-geral{background:rgba(255,255,255,.02);border:1px solid var(--st);
 border-radius:14px;padding:22px 24px;margin-bottom:28px}
.prog-bar-wrap{display:flex;gap:22px;align-items:center;margin-bottom:18px;flex-wrap:wrap}
.prog-circ{position:relative;width:96px;height:96px;flex-shrink:0}
.prog-circ svg{transform:rotate(-90deg)}
.prog-circ .inner{position:absolute;inset:0;display:flex;flex-direction:column;
 align-items:center;justify-content:center}
.prog-circ .pct{font-size:22px;font-weight:800;font-family:ui-monospace,Menlo,monospace;
 color:var(--t1);line-height:1}
.prog-circ .lbl{font-size:9.5px;font-weight:700;letter-spacing:1.2px;
 color:var(--t3);text-transform:uppercase;margin-top:2px}
.prog-info{flex:1;min-width:260px}
.prog-info .line{display:flex;justify-content:space-between;font-size:12.5px;
 margin-bottom:8px;color:var(--t2)}
.prog-info .line b{color:var(--t1);font-weight:700;font-family:ui-monospace,Menlo,monospace}
.prog-bar{height:8px;border-radius:4px;background:rgba(255,255,255,.04);
 overflow:hidden;position:relative;margin-bottom:8px}
.prog-bar .fill{height:100%;border-radius:4px;
 background:linear-gradient(90deg,#8b909a 0%,#b6bcc6 50%,#6ee7a5 100%);
 transition:width .6s cubic-bezier(.2,.8,.2,1)}

/* KPIs compactos */
.grid-kpi{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:10px}
.kpi{background:rgba(255,255,255,.02);border:1px solid var(--st);border-radius:12px;
 padding:14px 16px;transition:.25s}
.kpi:hover{background:rgba(255,255,255,.04);border-color:var(--st2);transform:translateY(-2px)}
.kpi .lbl{font-size:10.5px;font-weight:800;letter-spacing:1.2px;color:var(--t3);
 text-transform:uppercase;margin-bottom:6px}
.kpi .val{font-size:26px;font-weight:800;font-family:ui-monospace,Menlo,monospace;
 letter-spacing:-1px;color:var(--t1);line-height:1}
.kpi .delta{font-size:11.5px;color:var(--t2);margin-top:5px}
.kpi .delta.up{color:var(--ok)}.kpi .delta.down{color:var(--err)}

/* TIMELINE EXPANDIDA */
.tl-wrap{position:relative}
.tl-wrap::before{content:'';position:absolute;left:22px;top:8px;bottom:8px;width:2px;
 background:linear-gradient(180deg,transparent 0%,var(--t4) 4%,var(--t4) 96%,transparent 100%);
 border-radius:1px;z-index:0}

.etapa{position:relative;margin-bottom:18px;z-index:1}
.etapa .head{display:flex;align-items:center;gap:14px;padding:14px 20px;
 background:var(--s1);backdrop-filter:blur(20px);
 border:1px solid var(--st);border-radius:14px;cursor:pointer;
 transition:.25s;position:relative;overflow:hidden}
.etapa .head::before{content:'';position:absolute;left:-4px;top:50%;transform:translateY(-50%);
 width:16px;height:16px;border-radius:50%;background:var(--bg);
 border:2px solid var(--t4);z-index:2;transition:.3s;
 box-shadow:0 0 0 6px var(--bg)}
.etapa.done .head::before{background:var(--ok);border-color:var(--ok);
 box-shadow:0 0 0 6px var(--bg),0 0 14px var(--ok)}
.etapa.active .head::before{background:var(--info);border-color:var(--info);
 box-shadow:0 0 0 6px var(--bg),0 0 14px var(--info);
 animation:pulse 2s ease-in-out infinite}
.etapa:hover .head{background:rgba(255,255,255,.03);border-color:var(--st2)}
.etapa .head .num{font-family:ui-monospace,Menlo,monospace;font-size:12px;font-weight:700;
 color:var(--t3);background:rgba(255,255,255,.04);padding:3px 9px;border-radius:6px;
 border:1px solid var(--st2);flex-shrink:0}
.etapa .head .tit{font-size:16px;font-weight:800;color:var(--t1);flex:1;line-height:1.3}
.etapa .head .status{font-size:11px;font-weight:800;letter-spacing:1.2px;
 padding:4px 10px;border-radius:999px;flex-shrink:0;text-transform:uppercase}
.etapa .head .status.ok{background:rgba(110,231,165,.12);color:#a6f0c6;
 border:1px solid rgba(110,231,165,.28)}
.etapa .head .status.run{background:rgba(140,168,216,.12);color:#b3c9e6;
 border:1px solid rgba(140,168,216,.28)}
.etapa .head .status.wait{background:rgba(255,255,255,.05);color:var(--t3);
 border:1px solid var(--st2)}
.etapa .head .chev{color:var(--t3);font-size:14px;transition:transform .25s;flex-shrink:0}
.etapa.open .head .chev{transform:rotate(90deg);color:var(--t2)}

.etapa .body{max-height:0;overflow:hidden;transition:max-height .4s cubic-bezier(.2,.8,.2,1)}
.etapa.open .body{max-height:2400px}
.etapa .body-inner{padding:18px 22px 22px 56px;background:rgba(255,255,255,.015);
 border:1px solid var(--st);border-top:0;border-radius:0 0 14px 14px;margin-top:-8px;
 padding-top:24px}

/* CHECKLIST */
.chk-title{font-size:11px;font-weight:800;letter-spacing:1.4px;
 color:var(--t3);text-transform:uppercase;margin-bottom:12px;
 display:flex;align-items:center;gap:8px}
.chk-title .count{margin-left:auto;font-family:ui-monospace,Menlo,monospace;
 color:var(--t2);letter-spacing:0;font-size:11px}
.chk{list-style:none;display:flex;flex-direction:column;gap:7px;margin-bottom:18px}
.chk li{display:flex;gap:11px;align-items:flex-start;font-size:13.5px;
 color:var(--t2);line-height:1.55}
.chk li .bx{flex-shrink:0;width:17px;height:17px;border-radius:5px;
 border:1.6px solid var(--t3);margin-top:2px;display:flex;
 align-items:center;justify-content:center;color:transparent;
 transition:.2s;background:rgba(255,255,255,.01)}
.chk li.done .bx{background:var(--ok);border-color:var(--ok);color:#0a0b0d}
.chk li.done{color:var(--t1)}
.chk li.done b{color:var(--t1)}
.chk li.pending .bx{border-style:dashed;border-color:var(--t3)}
.chk li.pending{color:var(--t3);font-style:italic}
.chk li.run .bx{border-color:var(--info);color:var(--info);
 background:rgba(140,168,216,.12)}
.chk li.run{color:var(--t1)}
.chk li b{font-weight:700;color:var(--t1)}
.chk li code{background:rgba(255,255,255,.05);padding:1px 6px;border-radius:4px;
 font-family:ui-monospace,Menlo,monospace;font-size:12px;color:#b3c9e6}

/* CHECKPOINTS */
.cp-title{font-size:11px;font-weight:800;letter-spacing:1.4px;
 color:var(--t3);text-transform:uppercase;margin-bottom:12px;
 display:flex;align-items:center;gap:8px}
.cp{display:flex;flex-direction:column;gap:8px}
.cp-item{background:rgba(255,255,255,.02);border:1px solid var(--st);
 border-radius:10px;padding:11px 14px;display:flex;gap:12px;align-items:flex-start;
 transition:.2s}
.cp-item:hover{background:rgba(255,255,255,.04);border-color:var(--st2)}
.cp-item .cp-ic{width:22px;height:22px;border-radius:6px;flex-shrink:0;
 display:flex;align-items:center;justify-content:center;
 background:rgba(110,231,165,.1);border:1px solid rgba(110,231,165,.24);
 color:var(--ok);font-size:13px}
.cp-item .cp-tx{flex:1;font-size:13px;color:var(--t2);line-height:1.55}
.cp-item .cp-tx b{color:var(--t1);font-weight:700}
.cp-item .cp-tx code{background:rgba(255,255,255,.05);padding:1px 6px;
 border-radius:4px;font-family:ui-monospace,Menlo,monospace;font-size:12px;color:#b3c9e6}
.cp-item.warn .cp-ic{background:rgba(242,201,76,.1);border-color:rgba(242,201,76,.24);color:var(--warn)}

/* SUB-MÉTRICAS */
.metrics-mini{display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));
 gap:8px;margin-top:14px}
.mm{background:rgba(255,255,255,.02);border:1px solid var(--st);
 border-radius:9px;padding:10px 12px}
.mm .k{font-size:9.5px;font-weight:800;letter-spacing:1.2px;color:var(--t3);
 text-transform:uppercase;margin-bottom:4px}
.mm .v{font-size:15px;font-weight:800;font-family:ui-monospace,Menlo,monospace;
 color:var(--t1);line-height:1}
.mm .v small{font-size:10.5px;color:var(--t3);font-weight:600;margin-left:3px}

/* SVG ICONS */
.ic{display:inline-block;vertical-align:middle;flex-shrink:0}
.bx svg{width:11px;height:11px}

@keyframes fadeUp{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}
.fade{animation:fadeUp .4s ease both}

/* BOTÕES DE CONTROLE */
.ctrl{display:flex;gap:8px;margin-bottom:20px;flex-wrap:wrap}
.ctrl button{background:rgba(255,255,255,.03);border:1px solid var(--st2);
 color:var(--t2);padding:8px 16px;border-radius:9px;font-size:11.5px;
 font-weight:700;letter-spacing:.6px;text-transform:uppercase;cursor:pointer;
 transition:.2s;font-family:inherit}
.ctrl button:hover{background:rgba(255,255,255,.07);color:var(--t1)}
.ctrl button.pr{background:linear-gradient(135deg,#c8d0db,#9aa3b0);color:#14161a;border:0}

footer{margin-top:48px;padding:20px;text-align:center;font-size:12px;color:var(--t3);
 border-top:1px solid var(--st)}
footer code{background:rgba(255,255,255,.04);padding:2px 8px;border-radius:5px;
 font-family:ui-monospace,Menlo,monospace;color:var(--t2)}
</style>
</head>
<body>
<div id="bg">
  <div class="bl bl1" data-d="10"></div>
  <div class="bl bl2" data-d="18"></div>
  <div class="nz"></div>
</div>

<div class="wrap">

<header>
  <div class="logo">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
      <path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/>
    </svg>
  </div>
  <div>
    <h1>Evolução do Painel Hermes OS</h1>
    <div class="sub">Timeline com checklists e checkpoints por etapa</div>
  </div>
  <div class="pill">
    <span class="dot"></span>
    <span>9 etapas concluídas</span>
    <span style="color:var(--t3);font-size:11px">· 4 próximas</span>
  </div>
</header>

<!-- PROGRESSO GERAL -->
<section class="fade">
  <div class="prog-geral">
    <div class="prog-bar-wrap">
      <div class="prog-circ">
        <svg width="96" height="96">
          <circle cx="48" cy="48" r="42" fill="none" stroke="rgba(255,255,255,.06)" stroke-width="7"/>
          <circle cx="48" cy="48" r="42" fill="none" stroke="#6ee7a5" stroke-width="7"
                  stroke-linecap="round" stroke-dasharray="263.9" stroke-dashoffset="79.2"/>
        </svg>
        <div class="inner">
          <div class="pct">70%</div>
          <div class="lbl">completo</div>
        </div>
      </div>
      <div class="prog-info">
        <div class="line">
          <span>Roadmap consolidado</span>
          <b>9 de 13 etapas</b>
        </div>
        <div class="prog-bar"><div class="fill" style="width:70%"></div></div>
        <div class="line">
          <span>Painel + Watchdog operacionais</span>
          <b>v9 ativo</b>
        </div>
        <div class="prog-bar"><div class="fill" style="width:100%"></div></div>
        <div class="line">
          <span>Guardrails de segurança</span>
          <b>Ativos</b>
        </div>
        <div class="prog-bar"><div class="fill" style="width:88%"></div></div>
      </div>
    </div>

    <div class="grid-kpi">
      <div class="kpi">
        <div class="lbl">Peso por recarga</div>
        <div class="val">~3 KB</div>
        <div class="delta down">▼ 94% vs v0-v8</div>
      </div>
      <div class="kpi">
        <div class="lbl">Latência API</div>
        <div class="val">18 ms</div>
        <div class="delta down">▼ 96% vs v0-v8</div>
      </div>
      <div class="kpi">
        <div class="lbl">Detecção de falha</div>
        <div class="val">15 s</div>
        <div class="delta up">▲ automática</div>
      </div>
      <div class="kpi">
        <div class="lbl">Regras ativas</div>
        <div class="val">9</div>
        <div class="delta up">▲ editáveis em JSON</div>
      </div>
      <div class="kpi">
        <div class="lbl">Auto-heal</div>
        <div class="val">5/dia</div>
        <div class="delta">guardrail por serviço</div>
      </div>
      <div class="kpi">
        <div class="lbl">Dependências</div>
        <div class="val">0</div>
        <div class="delta up">▲ stdlib puro</div>
      </div>
    </div>
  </div>
</section>

<!-- TIMELINE EXPANDIDA -->
<section class="fade">
  <h2>Timeline com checkpoints</h2>
  <div class="ctrl">
    <button class="pr" onclick="expandirTodas()">Expandir tudo</button>
    <button onclick="recolherTodas()">Recolher tudo</button>
    <button onclick="marcarConcluidas()">Só concluídas</button>
    <button onclick="mostrarTodas()">Mostrar todas</button>
  </div>

  <div class="tl-wrap">

  <!-- v0 -->
  <div class="etapa done" data-status="done">
    <div class="head" onclick="toggleEtapa(this)">
      <span class="num">v0</span>
      <span class="tit">Painel de Missão — estático</span>
      <span class="status ok">CONCLUÍDA</span>
      <span class="chev">›</span>
    </div>
    <div class="body">
      <div class="body-inner">
        <div class="chk-title">
          <svg class="ic" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
          Checklist
          <span class="count">6/6</span>
        </div>
        <ul class="chk">
          <li class="done"><span class="bx"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6 9 17l-5-5"/></svg></span><span>HTML puro gerado manualmente com <b>6 fases</b> da missão</span></li>
          <li class="done"><span class="bx"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6 9 17l-5-5"/></svg></span><span>Estrutura de cards com <code>data-state</code> (wait/run/done)</span></li>
          <li class="done"><span class="bx"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6 9 17l-5-5"/></svg></span><span>Filtros por estado (all/wait/run/done)</span></li>
          <li class="done"><span class="bx"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6 9 17l-5-5"/></svg></span><span>Barra de progresso da Fase 4</span></li>
          <li class="done"><span class="bx"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6 9 17l-5-5"/></svg></span><span>Acordeão por fase e por evento</span></li>
          <li class="done"><span class="bx"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6 9 17l-5-5"/></svg></span><span>Rodapé com documentos-fonte</span></li>
        </ul>
        <div class="cp-title">
          <svg class="ic" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
          Checkpoint de validação
        </div>
        <div class="cp">
          <div class="cp-item">
            <div class="cp-ic">✓</div>
            <div class="cp-tx"><b>Critério de aceite:</b> painel abre sem erros de console, todas as 6 fases aparecem, filtros funcionam. <code>~19 KB</code> total.</div>
          </div>
        </div>
        <div class="metrics-mini">
          <div class="mm"><div class="k">Peso</div><div class="v">19<small>KB</small></div></div>
          <div class="mm"><div class="k">Reqs HTTP</div><div class="v">0</div></div>
          <div class="mm"><div class="k">Dependências</div><div class="v">0</div></div>
        </div>
      </div>
    </div>
  </div>

  <!-- v1 -->
  <div class="etapa done" data-status="done">
    <div class="head" onclick="toggleEtapa(this)">
      <span class="num">v1</span>
      <span class="tit">Dashboard de saúde ao vivo</span>
      <span class="status ok">CONCLUÍDA</span>
      <span class="chev">›</span>
    </div>
    <div class="body">
      <div class="body-inner">
        <div class="chk-title">
          <svg class="ic" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
          Checklist
          <span class="count">8/8</span>
        </div>
        <ul class="chk">
