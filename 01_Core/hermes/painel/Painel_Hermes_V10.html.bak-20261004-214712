function initRightResizer(){
  const r=$('#rightResizer'); if(!r) return;
  let resizing=false,startX=0,startW=0;
  const onMove=e=>{ if(!resizing) return;
    const dx=startX-e.clientX;
    const w=Math.max(220,Math.min(560,startW+dx));
    document.body.style.setProperty('--right-w',w+'px');
  };
  const onUp=()=>{ if(!resizing) return; resizing=false; r.classList.remove('dragging');
    document.body.style.cursor=''; document.body.style.userSelect='';
    const w=parseInt(getComputedStyle(document.body).getPropertyValue('--right-w'))||320;
    userCfg.layout.rightWidth=w; userCfg.layout.rightCollapsed=false;
    saveConfig(); applyAppearance();
    document.removeEventListener('mousemove',onMove); document.removeEventListener('mouseup',onUp);
  };
  r.addEventListener('mousedown',e=>{
    if(userCfg.layout.rightCollapsed) return;
    resizing=true; startX=e.clientX; startW=userCfg.layout.rightWidth||320;
    r.classList.add('dragging'); document.body.style.cursor='col-resize'; document.body.style.userSelect='none';
    document.addEventListener('mousemove',onMove); document.addEventListener('mouseup',onUp);
    e.preventDefault();
  });
}

