def now(): return datetime.now().strftime("%Y-%m-%d %H:%M:%S")
def load(p):
    try:
        with open(p, encoding="utf-8") as f: return json.load(f)
    except: return None
def save(p, d):
    with open(p, "w", encoding="utf-8") as f:
        json.dump(d, f, ensure_ascii=False, indent=2)
def health():
    try: return json.loads(urllib.request.urlopen(BRIDGE+"/health", timeout=2).read().decode())
    except: return None
def send1(cid, msg):
    body = json.dumps({"chatId":cid,"message":msg}).encode()
    req = urllib.request.Request(BRIDGE+"/send", data=body, method="POST",
                                 headers={"Content-Type":"application/json"})
    try:
        r = urllib.request.urlopen(req, timeout=20)
        return json.loads(r.read().decode())
    except Exception as e: return {"success":False,"error":str(e)[:80]}

def msg_etapa(et, nome, empresa):
    primeiro = (nome or "tudo bem").split()[0]
    emp = empresa or "sua empresa"
    tpl = ETAPAS.get(et, ETAPAS["D0"])[1]
    return tpl.format(primeiro=primeiro, empresa=emp)

def prox_etapa(et):
    try: i = ORDEM.index(et)
    except: i = 0
    return ORDEM[(i+1) % len(ORDEM)]

