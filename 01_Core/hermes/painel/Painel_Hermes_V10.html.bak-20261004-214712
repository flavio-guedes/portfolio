function deriveOverview(){
  const hoje=todayISO();
  const ev=state.events.filter(e=>String(e.ts).slice(0,10)===hoje);
  const acts=state.actions;
  return {
    eventos_hoje:ev.length,
    capturas:ev.filter(e=>e.tipo==='captura').length,
    envios:ev.filter(e=>e.tipo==='envio').length,
    respostas:ev.filter(e=>e.tipo==='resposta').length,
    bloqueios:acts.filter(a=>a.status==='BLOQUEADO').length,
    erros:acts.filter(a=>a.status==='ERRO').length,
    atrasadas:acts.filter(isLate).length,
    oportunidades:state.opportunities.filter(o=>o.estagio!=='Fechado'&&o.estagio!=='Perdido').length,
    reunioes:state.campaigns.reduce((s,c)=>s+(c.metricas.reunioes||0),0),
    sugeridas:state.campaigns.filter(c=>c.sugestao).length
  };
}
function deriveCampaignMetrics(c){
  const t=Math.max(1,c.metricas.enviados);
  return {taxaResposta:c.metricas.respondidos/t*100,taxaConversa:c.metricas.conversas/t*100,taxaReuniao:c.metricas.reunioes/t*100};
}
function deriveAgenda(){
  return state.actions
    .filter(a=>['PRONTO','AGENDADO'].includes(a.status))
    .sort((a,b)=>(a.prioridade_fila||9)-(b.prioridade_fila||9)||String(a.prazo).localeCompare(String(b.prazo)));
}
function deriveCritical(){
  return state.actions.filter(a=>isLate(a)||a.status==='ERRO'||a.status==='BLOQUEADO')
    .sort((a,b)=>{ const w={ERRO:0,BLOQUEADO:1,PRONTO:2,AGENDADO:3}; return (w[a.status]??4)-(w[b.status]??4); });
}

