  function injetar(){
    var tabs = document.getElementById('tabs');
    if (!tabs) return;
    if (tabs.querySelector('#tab-escala')) return;

    var btn = document.createElement('div');
    btn.className = 'tb';
    btn.id = 'tab-escala';
    btn.setAttribute('data-tab','escala');
    btn.innerHTML = '<span>Escala</span>';
    btn.style.cursor = 'pointer';

    btn.onclick = function(e){
      e.stopPropagation();
      tabs.querySelectorAll('.tb').forEach(function(x){ x.classList.remove('on'); });
      btn.classList.add('on');

      var pb = document.getElementById('pbody');
      var pt = document.getElementById('ptitle');
      if (pt) pt.innerHTML = 'Plano de Escala';
      if (pb) {
        pb.innerHTML = HTML_ESCALA;
        carregar();
      }
    };

    tabs.appendChild(btn);
  }

  function carregar(){
    var box = document.getElementById('escala-alertas-box');
    if (!box) return;
    fetch('/api/alerts?tipo=escala&limit=5', {cache:'no-store'})
      .then(function(r){ if (!r.ok) throw 0; return r.json(); })
      .then(function(arr){
        if (!arr || !arr.length){
          box.innerHTML = '<div style="color:#cce4ff">▶ Nenhuma sugestão nova ainda</div>';
          return;
        }
        box.innerHTML = arr.slice(-5).map(function(a){
          return '<div style="padding:3px 0;color:#cce4ff">▶ '+(a.msg||'')+'</div>';
        }).join('');
      })
      .catch(function(){
        box.innerHTML = '<div style="padding:3px 0;color:#cce4ff">▶ Fase 4: acumulando amostras para v11 preditiva</div>'
                      + '<div style="padding:3px 0;color:#cce4ff">▶ Fase 2: hora de integrar leads + campanhas (só local)</div>';
      });
  }

  function start(){
    var tabs = document.getElementById('tabs');
    if (!tabs){ setTimeout(start, 200); return; }

    var obs = new MutationObserver(function(){
      if (!tabs.querySelector('#tab-escala')) injetar();
    });
    obs.observe(tabs, {childList: true});

    injetar();
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', start);
  else start();
})();
