def importar():
    if not os.path.exists(CRM): return 0
    d = json.load(open(CRM, encoding="utf-8"))
    out = []
    for l in d:
        tel = (l.get("whatsapp_digits") or "").strip()
        if len(tel) < 10: continue
        nome = (l.get("nome") or "").strip()
        emp = (l.get("empresa") or "").strip()
        if not nome and not emp and not l.get("trecho"): continue
        out.append({"id":f"C{len(out)+1:05d}","nome":nome or "(sem nome)",
                    "empresa":emp or nome or "(sem empresa)","telefone":tel,
                    "score":int(l.get("score") or 0),
                    "score_composto":int(l.get("score_composto") or 0),
                    "prioridade":(l.get("priority") or "Baixa").strip(),
                    "tentativas":0,"ultimo_contato":""})
    save(LEADS, out); return len(out)

def construir(maxl=200):
    leads = load(LEADS) or []
    if not leads: return 0,0
    ord_p = {"alta":0,"média":1,"media":1,"baixa":2}
    leads.sort(key=lambda l:(ord_p.get(l["prioridade"].lower(),9), -l["score"]))
    f = leads[:maxl]
    ja_env = _ja_enviados()
    def virgem(l):
        t = l["telefone"].replace("+","")
        return t not in ja_env and not l.get("tentativas") and not l.get("ultimo_contato")
    novos = [l for l in f if virgem(l)]
    base  = [l for l in f if not virgem(l)]
    itens = []
    def add(lst, tipo, gap):
        cur = (datetime.now() + timedelta(seconds=20)).replace(microsecond=0)
        for l in lst:
            itens.append({
                "id": f"{tipo[0].upper()}{len(itens)+1:03d}",
                "nome":l["nome"],"empresa":l["empresa"],"telefone":l["telefone"],
                "chatId":l["telefone"]+"@s.whatsapp.net","tipo":tipo,"etapa":"D0",
                "mensagem":msg_etapa("D0", l["nome"], l["empresa"]),
                "prazo":cur.strftime("%Y-%m-%d %H:%M:%S"),
                "status":"AGENDADO","enviado_em":None,"erro":None})
            cur += timedelta(minutes=gap)
    add(novos,"novo",GAP_NOVO); add(base,"base",GAP_BASE)
    save(FILA,{"gerado_em":now(),"total":len(itens),"novos":len(novos),
               "base":len(base),"itens":itens})
    return len(novos), len(base)

def _ja_enviados():
    s = set()
    for path in [os.path.join(HOME,"hermes/disparos.json"), FILA]:
        if not os.path.exists(path): continue
        try:
            d = json.load(open(path, encoding="utf-8"))
            arr = d if isinstance(d,list) else d.get("itens",[])
            for x in arr:
                t = (x.get("telefone") or "").replace("+","").strip()
                if t: s.add(t)
        except: pass
    return s

def construir_hot(n=3):
    leads = load(LEADS) or []
    ja = _ja_enviados()
    disp = [l for l in leads if l["telefone"].replace("+","") not in ja
            and not l.get("tentativas") and not l.get("ultimo_contato")]
    disp.sort(key=lambda l:(-l.get("score_composto",0), -l.get("score",0)))
    hot = disp[:n]
    if not hot: return 0
    d = load(FILA) or {"itens":[], "total":0, "novos":0, "base":0}
    d["itens"] = [i for i in d["itens"] if not i["id"].startswith("H")]
    cur = (datetime.now() + timedelta(seconds=15)).replace(microsecond=0)
    c = 0
    for l in hot:
        d["itens"].append({
            "id":f"H{c+1:03d}","nome":l["nome"],"empresa":l["empresa"],
            "telefone":l["telefone"],"chatId":l["telefone"]+"@s.whatsapp.net",
            "tipo":"hot","etapa":"D0",
            "mensagem":msg_etapa("D0", l["nome"], l["empresa"]),
            "prazo":cur.strftime("%Y-%m-%d %H:%M:%S"),
            "status":"AGENDADO","enviado_em":None,"erro":None})
        c += 1
        cur += timedelta(minutes=GAP_HOT)
    d["total"] = len(d["itens"]); d["hot"] = c
    save(FILA, d); return c


