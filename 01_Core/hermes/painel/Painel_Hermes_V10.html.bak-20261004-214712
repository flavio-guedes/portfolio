      <div class="cfg-row"><span class="grip">↕</span><div class="label">Recolher cabeçalho</div><span></span><div class="toggle ${userCfg.layout.headerCollapsed?'on':''}" data-lay="headerCollapsed"></div></div>
      <div style="margin-top:18px"><button class="btn danger" id="resetCfgBtn">Restaurar padrões</button></div>`;
    body.querySelectorAll('[data-seg="modesPosition"] button,[data-seg="navPosition"] button,[data-seg="filtersPosition"] button').forEach(b=>b.addEventListener('click',()=>{
      const seg=b.closest('.seg-control'); userCfg.layout[seg.dataset.seg]=b.dataset.val;
      saveConfig(); render(); renderSettingsTab();
    }));
    body.querySelectorAll('[data-lay]').forEach(b=>b.addEventListener('click',()=>{
      userCfg.layout[b.dataset.lay]=!userCfg.layout[b.dataset.lay]; saveConfig(); render(); renderSettingsTab();
    }));
    const sl=body.querySelector('#widthSliderL');
    if(sl) sl.addEventListener('input',e=>{ const v=parseInt(e.target.value); userCfg.layout.leftWidth=v; applyAppearance(); const val=body.querySelector('#widthValL'); if(val) val.textContent=v+'px'; });
    const sr=body.querySelector('#widthSliderR');
    if(sr) sr.addEventListener('input',e=>{ const v=parseInt(e.target.value); userCfg.layout.rightWidth=v; applyAppearance(); const val=body.querySelector('#widthValR'); if(val) val.textContent=v+'px'; });
    const rc=body.querySelector('#resetCfgBtn');
    if(rc) rc.addEventListener('click',()=>{ if(confirm('Restaurar padrões?')) resetConfig(); });
  } else if(settingsTab==='appearance'){
    const theme=userCfg.appearance.theme||'dark', contrast=userCfg.appearance.contrast||'normal';
    body.innerHTML=`
      <div class="sub" style="margin-bottom:14px">Aparência e legibilidade.</div>
      <div class="cfg-row"><span class="grip">☼</span><div class="label">Tema claro</div><span></span><div class="toggle ${theme==='light'?'on':''}" data-app="theme"></div></div>
      <div class="cfg-row"><span class="grip">◐</span><div class="label">Contraste</div><span></span>
        <div class="seg-control" data-seg="contrast">
          <button data-val="normal" class="${contrast==='normal'?'active':''}">Normal</button>
          <button data-val="high"   class="${contrast==='high'?'active':''}">Alto</button>
          <button data-val="max"    class="${contrast==='max'?'active':''}">Máximo</button>
        </div>
      </div>
      <div class="cfg-row"><span class="grip">▤</span><div class="label">Densidade compacta</div><span></span><div class="toggle ${userCfg.appearance.density==='compact'?'on':''}" data-app="density"></div></div>
