<script>
/* =====================================================================
   0. UTILITÁRIOS BASE
   ===================================================================== */
const $  = s => document.querySelector(s);
const $$ = (s,r) => Array.from((r||document).querySelectorAll(s));
const esc = v => String(v==null?'':v).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const clone = o => JSON.parse(JSON.stringify(o));
const pad = n => String(n).padStart(2,'0');
const MESES = ['jan','fev','mar','abr','mai','jun','jul','ago','set','out','nov','dez'];
const todayISO = () => new Date().toISOString().slice(0,10);
const nowISO = () => state.config.agora || new Date().toISOString().slice(0,16);
const fmtTime = ts => { if(!ts) return '—'; const d=new Date(ts); return pad(d.getHours())+':'+pad(d.getMinutes()); };
const fmtDay = ts => { const [,m,d]=String(ts).slice(0,10).split('-'); return d+' '+MESES[+m-1]; };
function fmtWhen(ts){
  if(!ts) return '—';
  const d=String(ts).slice(0,10), t=String(ts).length>10?' · '+String(ts).slice(11,16):'', td=todayISO();
  if(d===td) return 'Hoje'+t;
  const y1=new Date(); y1.setDate(y1.getDate()+1);
  if(d===y1.toISOString().slice(0,10)) return 'Amanhã'+t;
  const y2=new Date(); y2.setDate(y2.getDate()-1);
  if(d===y2.toISOString().slice(0,10)) return 'Ontem'+t;
  return fmtDay(ts)+t;
}
const isLate = a => ['PRONTO','AGENDADO'].includes(a.status) && a.prazo && String(a.prazo).slice(0,16) < nowISO();

/* ---- Relógio da fila --------------------------------------------------
   O painel precisa mostrar o que está para as próximas horas. As funções
   abaixo classificam a fila em dojos grupos e calculam a distância no
   tempo. Tudo é derivado do prazo, sem criar estado paralelo: se a ação
   mudar de status, o grupo muda sozinho. */
const FILA_GRUPOS=[
  {id:'atrasadas', label:'Atrasadas',  tom:'urgent'},
  {id:'erro',      label:'Com erro',  tom:'hot'},
  {id:'bloqueadas',label:'Bloqueadas',tom:'warn'},
  {id:'andamento', label:'Em andamento',tom:'info'},
  {id:'agendadas', label:'Agendadas',  tom:'ai'},
  {id:'prontas',   label:'Prontas',    tom:'ok'},
  {id:'enviadas',  label:'Enviadas hoje',tom:'accent'}
];
/* Prioridade da classificação: o primeiro grupo que casar vence, para uma
   ação nunca contar em dois lugares ao mesmo tempo. */
function filaGrupo(a){
  if(a.status==='BLOQUEADO') return 'bloqueadas';
  if(a.status==='ERRO') return 'erro';
  if(a.status==='EXECUTANDO') return 'andamento';
  if(isLate(a)) return 'atrasadas';
  if(a.status==='AGENDADO') return 'agendadas';
  if(a.status==='PRONTO') return 'prontas';
  if(a.status==='ENVIADO'&&String(a.enviado_em||'').slice(0,10)===todayISO()) return 'enviadas';
  return null;
}
function filaContagem(){
  const c={};
  FILA_GRUPOS.forEach(g=>c[g.id]=0);
  filteredActions().forEach(a=>{ const g=filaGrupo(a); if(g) c[g]++; });
  return c;
}
/* Minutos até o prazo. Negativo = já venceu. */
function minutosAte(prazo){
  if(!prazo) return null;
  const alvo=new Date(String(prazo).length<=10?prazo+'T23:59':prazo).getTime();
  if(!Number.isFinite(alvo)) return null;
  return Math.round((alvo-clockBase())/60000);
}
/* Base do relógio da fila. A base do painel (`config.agora`) serve para
   demo e testes, mas não pode congelar a contagem: ancoramos uma vez e
   somamos o tempo real decorrido desde a carga dos dados. Sem isso, o
   "faltam 12 min" ficaria parado em 12 min para sempre. */
function clockBase(){
  if(!state.config.agora) return Date.now();
  if(state.clockAnchorBase===undefined){
    state.clockAnchorBase=new Date(state.config.agora).getTime();
    state.clockAnchorReal=Date.now();
  }
  return state.clockAnchorBase+(Date.now()-state.clockAnchorReal);
}
function fmtContagem(min){
  if(min===null||min===undefined) return '—';
  const neg=min<0, m=Math.abs(min);
  let txt;
  if(m<60) txt=m+' min';
  else if(m<60*24) txt=Math.floor(m/60)+'h'+String(m%60).padStart(2,'0');
  else txt=Math.floor(m/1440)+'d'+String(Math.floor(m%1440/60)).padStart(2,'0')+'h';
  return neg?txt+' atrás':txt;
}
/* Fila agrupada, na ordem que importa para quem trabalha: o que já venceu
   primeiro, o que sai em seguida, o que está pronto para sair. */
function filaAgrupada(){
  const grupos={};
  FILA_GRUPOS.forEach(g=>grupos[g.id]=[]);
  filteredActions().forEach(a=>{ const g=filaGrupo(a); if(g) grupos[g].push(a); });
  FILA_GRUPOS.forEach(g=>grupos[g.id].sort((x,y)=>String(x.prazo||'9999').localeCompare(String(y.prazo||'9999'))));
  return grupos;
}
/* Próximas horas: o que está por vir, em ordem cronológica. Inclui ações
   pendentes e campanhas agendadas — são as duas coisas que o relógio
   realmente vai disparar. */
function agendaProximas(horas){
  const lim=(horas||24)*60, out=[];
  filteredActions().forEach(a=>{
    const g=filaGrupo(a);
    if(!['prontas','agendadas','atrasadas'].includes(g)) return;
    const m=minutosAte(a.prazo);
    if(m===null||m>lim) return;
    out.push({tipo:'acao',min:m,prazo:a.prazo,grupo:g,a});
  });
  state.campaigns.filter(c=>!c.sugestao&&c.status!=='PAUSADA'&&c.status!=='ENCERRADA'&&c.agendada_em).forEach(c=>{
    const m=minutosAte(c.agendada_em);
    if(m===null||m>lim) return;
    const pend=campPendentes(c);
    if(!pend) return;
    out.push({tipo:'campanha',min:m,prazo:c.agendada_em,grupo:'campanha',c,pend});
  });
  return out.sort((a,b)=>a.min-b.min).slice(0,14);
}
const fmtPct = n => Math.round(n)+'%';
const fmtNum = n => Number(n||0).toLocaleString('pt-BR');
const fmtClock = ts => { if(!ts) return '—'; const d=new Date(ts); return pad(d.getHours())+':'+pad(d.getMinutes())+':'+pad(d.getSeconds()); };

function suggestDate(offsetDays){
  const d=new Date(); d.setDate(d.getDate()+(offsetDays||1)); d.setHours(10,0,0,0);
  return `${d.getFullYear()}-${pad(d.getMonth()+1)}-${pad(d.getDate())}T${pad(d.getHours())}:${pad(d.getMinutes())}`;
}

function toast(msg){
  const t=document.createElement('div'); t.className='toast'; t.textContent=msg;
  document.body.appendChild(t); setTimeout(()=>t.remove(),2600);
}

/* =====================================================================
   1. FONTE
   ===================================================================== */
const DATA_SOURCE='mock';
const HERMES_BASE_URL=null;

/* =====================================================================
   2. IMPORTAÇÃO CSV
   ===================================================================== */
const IMPORT_KEY='hermes-os.v7.data';
const GRUPO_MAP={'TIER 1':'A','TIER 2':'B','TIER 6':'C'};
const GRUPO_LABEL={A:'Grupo A',B:'Grupo B',C:'Grupo C'};

/* ---------------------------------------------------------------------
   2.1 BASE EMBUTIDA · 00 - Mestre_V2.csv
   A base completa (11.389 leads) viaja dentro do próprio HTML como gzip
   + base64 e é expandida no boot pelo mesmo pipeline do importador.
   Motivo: o JSON enriquecido passaria de 7 MB e estouraria o localStorage
   (limite ~5 MB). O payload comprimido fica em ~760 KB.
   --------------------------------------------------------------------- */
const LEADS_SOURCE_FILE='00 - Mestre_V2.csv';
const LEADS_PAYLOAD_B64='';
const LEADS_PAYLOAD_META={linhas:11389,geradoEm:'2026-10-01',tiers:{A:2627,B:3476,C:5286}};
const EMBEDDED_GRUPOS=['A','B','C'];

let _embeddedCache=null;

function b64ToBytes(b64){
  const bin=atob(b64);
  const out=new Uint8Array(bin.length);
  for(let i=0;i<bin.length;i++) out[i]=bin.charCodeAt(i);
  return out;
}
async function gunzip(bytes){
  const ds=new DecompressionStream('gzip');
  const stream=new Blob([bytes]).stream().pipeThrough(ds);
  return await new Response(stream).text();
}
async function loadEmbeddedCSV(){
  if(_embeddedCache) return _embeddedCache;
  const csv=await gunzip(b64ToBytes(LEADS_PAYLOAD_B64));
  _embeddedCache=csv;
  return csv;
}
function countBy(rows,key){
  const m={};
  rows.forEach(r=>{const v=(r[key]||'').trim()||'—'; m[v]=(m[v]||0)+1;});
  return m;
}
async function buildEmbeddedBase(grupos){
  const csv=await loadEmbeddedCSV();
  const objs=rowsToObjects(parseCSV(csv));
  const wanted=grupos&&grupos.length?grupos:['A','B','C'];
  const all=enrichAll(objs);
  const byTier={A:0,B:0,C:0};
  all.forEach(o=>{byTier[o.grupo]++;});
  const enriched=all.filter(o=>wanted.includes(o.grupo));
  return {
    opportunities:enriched,
    stats:{
      total:objs.length,
      A:byTier.A, B:byTier.B, C:byTier.C,
      importadas:enriched.length,
      fonte:LEADS_SOURCE_FILE,
      categorias:countBy(objs,'Categoria'),
      listas:countBy(objs,'Lista V2'),
      scoreMedio:Math.round(objs.reduce((s,r)=>s+(parseInt(r['Score composto']||'0',10)||0),0)/Math.max(1,objs.length))
    }
  };
}

function parseCSV(text){
  const rows=[]; let cur=[],field='',inQ=false;
  for(let i=0;i<text.length;i++){
    const c=text[i], n=text[i+1];
    if(inQ){
      if(c==='"'&&n==='"'){ field+='"'; i++; }
      else if(c==='"'){ inQ=false; }
      else field+=c;
    } else {
      if(c==='"') inQ=true;
      else if(c===','){ cur.push(field); field=''; }
      else if(c==='\n'){ cur.push(field); rows.push(cur); cur=[]; field=''; }
      else if(c==='\r'){}
      else field+=c;
    }
  }
  if(field||cur.length){ cur.push(field); rows.push(cur); }
  return rows;
}
function rowsToObjects(rows){
  if(!rows.length) return [];
  const header=rows[0].map(h=>h.replace(/^\uFEFF/,'').trim());
  return rows.slice(1).filter(r=>r.some(c=>c&&String(c).trim()!=='')).map(r=>{
    const o={}; header.forEach((h,i)=>o[h]=(r[i]??'').trim()); return o;
  });
}
function decodeEntities(s){
  if(!s) return '';
  return String(s)
    .replace(/&aacute;/g,'á').replace(/&eacute;/g,'é').replace(/&iacute;/g,'í')
    .replace(/&oacute;/g,'ó').replace(/&uacute;/g,'ú').replace(/&atilde;/g,'ã')
    .replace(/&otilde;/g,'õ').replace(/&ccedil;/g,'ç').replace(/&acirc;/g,'â')
    .replace(/&ecirc;/g,'ê').replace(/&ocirc;/g,'ô').replace(/&nbsp;/g,' ')
    .replace(/&amp;/g,'&').replace(/&lt;/g,'<').replace(/&gt;/g,'>')
    .replace(/&quot;/g,'"').replace(/&#39;/g,"'")
    .replace(/<[^>]+>/g,' ').replace(/\s+/g,' ').trim();
}
function parseDateBR(s){
  if(!s) return null;
  const t=String(s).trim();
  const m1=t.match(/^(\d{1,2})[\/\.\-](\d{1,2})[\/\.\-](\d{2,4})$/);
  if(m1){ const [,d,mo,y]=m1; const year=y.length===2?(parseInt(y,10)>50?'19':'20')+y:y;
    return `${year}-${pad(mo)}-${pad(d)}T10:00`; }
  const meses={jan:1,fev:2,feb:2,mar:3,abr:4,apr:4,mai:5,may:5,jun:6,jul:7,ago:8,aug:8,set:9,sep:9,out:10,oct:10,nov:11,dez:12,dec:12};
  const m2=t.toLowerCase().match(/^(\d{1,2})\s+([a-zç]{3,})\.?\s+(\d{4})$/);
  if(m2){ const [,d,mes,y]=m2; const mo=meses[mes.slice(0,3)]||1; return `${y}-${pad(mo)}-${pad(d)}T10:00`; }
  return null;
}
function deriveSegmento(o){
  const k=[o.Categoria,o.Cargo,o['Lista V2']].filter(Boolean).join(' ').toLowerCase();
  if(/rh|recursos humanos|recruit|headhunt|talent|pessoas|people/.test(k)) return 'RH';
  if(/design|designer|\barte\b|creative|ilustra|art director/.test(k)) return 'Design';
  if(/marketing|growth|m[ií]dia|social|seo|crm|branding|influenc/.test(k)) return 'Marketing';
  if(/vendas|comercial|sales|business dev|\bbd\b|account/.test(k)) return 'Vendas';
  if(/jur[ií]dic|advog|\blaw\b|legal|advocacia/.test(k)) return 'Jurídico';
  if(/engenh|arquitet|\bdev\b|software|\bti\b|tech|dados|data/.test(k)) return 'Tecnologia';
  if(/sa[uú]de|cl[ií]nic|medic|health|hospital|derma|odont|est[eé]tic/.test(k)) return 'Saúde';
  if(/educa|escola|col[eé]gio|ensino|pedagog|univers/.test(k)) return 'Educação';
  if(/capta|fundrais|recursos|editais|projeto|proponente/.test(k)) return 'Captação';
  if(/cultura|event|m[uú]sica|teatro|arte/.test(k)) return 'Cultura';
  return 'Geral';
}
function derivePerfil(cargo){
  const c=(cargo||'').toLowerCase();
  if(/(ceo|founder|fundador|s[óo]cio|diretor[a]?|c-level|cto|cmo|cfo|coo|partner|presidente|owner|chief)/.test(c)) return 'Decisor';
  if(/(head|coordenador|coordinator|gerente|manager|leader|l[íi]der|supervisor)/.test(c)) return 'Gestor';
  if(/(recruit|headhunt|talent|r&s|sourcer|recursos humanos|people ops|\brh\b)/.test(c)) return 'Recrutador';
  if(/(analista|assistente|estagi|trainee|\bjr\b|j[úu]nior|junior|auxiliar)/.test(c)) return 'Execução';
  return 'Outro';
}
function deriveCanal(row){
  if(row['WhatsApp']) return 'WhatsApp';
  if(row['LinkedIn']) return 'LinkedIn';
  if(row['E-mail'])   return 'E-mail';
  return 'LinkedIn';
}
/* O Mestre_V2 pontua 0–40 (TIER1=40, TIER2=30, TIER3=20, TIER5=15,
   TIER4=10, TIER6=0). As faixas originais 0–100 (70/40) deixavam 77% da
   base como "Frio". Ancoramos no formato real do score. */
function deriveTemperatura(score,categoria){
  if(categoria==='Vaga/Contratação'&&score>0) return 'Quente';
  if(score>=35) return 'Quente';
  if(score>=15) return 'Morno';
  return 'Frio';
}
function deriveEstagio(listaV2,terceiro){
  const lv=listaV2||'';
  if(lv.includes('Vaga_Contratacao')) return 'Qualificação';
  if(lv.includes('Indicacao')) return 'Qualificação';
  if(lv.includes('Gestao_Marketing')) return 'Conversa';
  if(lv.includes('Captacao_Recursos')) return 'Descoberta';
  if(terceiro) return 'Conversa';
  return 'Descoberta';
}
function deriveTipo(listaV2){
  const lv=listaV2||'';
  if(lv.includes('Vaga_Contratacao')) return 'Vaga';
  if(lv.includes('Indicacao')) return 'Parceria';
  if(lv.includes('Captacao_Recursos')) return 'Projeto';
  return 'B2B';
}
function deriveProbabilidade(score){
  if(score>=40) return .60;
  if(score>=30) return .40;
  if(score>=20) return .25;
  if(score>=10) return .15;
  return .05;
}
function deriveProxima(listaV2,terceiro,categoria){
  const lv=listaV2||'';
  if(lv.includes('Vaga_Contratacao')) return 'Enviar currículo + prova direta (case)';
  if(lv.includes('Indicacao')) return 'Solicitar apresentação ao decisor';
  if(lv.includes('Captacao_Recursos')) return 'Enviar proposta de projeto';
  if(lv.includes('Gestao_Marketing')) return 'Enviar case + insight setorial';
  if(terceiro) return 'Contatar pessoa indicada com referência';
  if(categoria==='Baixa relevância') return 'Revisar antes de abordar';
  return 'Fazer primeiro contato com contexto específico';
}
function deriveCadencia(prio){
  if(prio==='Alta') return '3 toques · 7 dias';
  if(prio==='Média') return '3 toques · 14 dias';
  return '1 toque · revisar em 30 dias';
}
function deriveAbordagem(row,listaV2){
  const cat=row['Categoria']||''; const lv=listaV2||'';
  if(cat==='Vaga/Contratação') return 'Prova direta (case + portfólio)';
  if(lv.includes('Indicacao')) return 'Mensagem curta pedindo intro';
  if(lv.includes('Captacao_Recursos')) return 'Diagnóstico + proposta de valor';
  if(lv.includes('Gestao_Marketing')) return 'Case + insight setorial';
  return row['Tipo de abordagem sugerida'] || 'Abordagem personalizada';
}
function enrichRow(row,idx){
  const grupo=GRUPO_MAP[row['Tier']]||'C';
  const score=parseInt(row['Score composto']||row['Score']||'0',10)||0;
  const categoria=row['Categoria']||'';
  const listaV2=row['Lista V2']||'';
  const cargo=row['Cargo']||'';
  const trecho=decodeEntities(row['Trecho']||'').slice(0,500);
  const terceiro=/^sim$/i.test(row['Terceiro']||'');
  const nome=row['Nome']||'(sem nome)';
  const empresa=row['Empresa']||nome;
  const canal=deriveCanal(row);
  const segmento=deriveSegmento(row);
  const perfil=derivePerfil(cargo);
  const temperatura=deriveTemperatura(score,categoria);
  const estagio=deriveEstagio(listaV2,terceiro);
  const tipo=deriveTipo(listaV2);
  const probabilidade=deriveProbabilidade(score);
  const potencial=grupo==='A'?'Alto':grupo==='B'?'Médio':'Baixo';
  const ultimaISO=parseDateBR(row['Data Contato']||'');

  return {
    id: row['ID V2'] || `IMP-${String(idx).padStart(5,'0')}`,
    empresa, descricao: cargo||categoria||'',
    tipo, segmento, estagio, temperatura,
    prioridade: row['Prioridade']||'Média',
    responsavel: 'Flávio',
    campaign_id: null,
    contato: nome,
    canal_preferido: canal,
    case_sugerido: null,
    proxima_acao: deriveProxima(listaV2,terceiro,categoria),
    proxima_data: suggestDate(estagio==='Conversa'?1:2),
    ultima_interacao: terceiro?null:ultimaISO,
    score,
    status_lead: estagio==='Conversa'?'EM CONVERSA':'QUALIFICADO',
    grupo, perfil, potencial, probabilidade,
    cadencia: deriveCadencia(row['Prioridade']||'Média'),
    abordagem_recomendada: deriveAbordagem(row,listaV2),
    trecho,
    linkedin_url: row['LinkedIn']||null,
    email: row['E-mail']||null,
    whatsapp: row['WhatsApp']||null,
    telefone: row['Telefone']||null,
    categoria_origem: categoria,
    lista_v2: listaV2,
    indicado_por_terceiro: terceiro,
    motivo_classificacao: row['Motivo da classificação']||''
  };
}
function enrichAll(objs){
  const out=new Array(objs.length);
  for(let i=0;i<objs.length;i++) out[i]=enrichRow(objs[i],i);
  return out;
}
function importCSV(text,opts){
  const {grupos=['A','B']}=opts||{};
  const objs=rowsToObjects(parseCSV(text));
  const all=enrichAll(objs);
  const chosen=all.filter(o=>grupos.includes(o.grupo));
  const stats={
    total:all.length,
    A:all.filter(o=>o.grupo==='A').length,
    B:all.filter(o=>o.grupo==='B').length,
    C:all.filter(o=>o.grupo==='C').length,
    importadas:chosen.length
  };
  return {opportunities:chosen, stats};
}
/* Importação do usuário: tenta persistir em localStorage; se estourar a
   cota (a base completa não cabe), mantém em memória apenas nesta sessão. */
