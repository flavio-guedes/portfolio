function webParaOportunidade(r,origem){
  /* Mapeia o registro público do módulo para o formato de oportunidade que
     o painel já sabe ler (enrichRow/OPP_INDEX). Sem isso os campos chegam
     vazios e a lista fica inerte. Atenção: o módulo devolve `estado`, `pais`
     e `segmento` (OpenStreetMap), não `uf`. */
  const empresa=(r.empresa||'').trim()||(r.nome||'').trim()||'Contato sem empresa';
  const regiao=(r.cidade||'').trim();
  const uf=(r.estado||r.uf||'').trim();
  const chave=[empresa,regiao||uf].join('|').toUpperCase().replace(/[^A-Z0-9]+/g,'-').slice(0,34);
  const id='WEB-'+origem+'-'+chave;
  return {
    id, empresa, contato:(r.nome||'').trim()||empresa,
    cargo:(r.cargo||'').trim(),
    segmento:(r.segmento||'').trim()||'Web',
    cidade:regiao, uf,
    email:(r.email||'').trim(), telefone:(r.telefone||'').trim(),
    site:(r.site||r.empresa_url||r.url_origem||'').trim(),
    origem:origem, fonte:origem,
    origem_registro:r,
    observacao:(r.observacao||'').trim(),
    estagio:'Descoberta', temperatura:'Morno', grupo:'C', perfil:'Decisor',
    tipo:'Lead web', score:35, prioridade:'Média',
    canal_preferido:(r.email?'E-mail':r.telefone?'WhatsApp':'LinkedIn')
  };
}
async function executarBuscaLead(){
  const b=buscaEstado();
  /* O termo mora em campos com nomes diferentes por canal, então leio o que
     estiver preenchido em vez de fixar um único input. */
  const form=$('[data-form-busca]');
  if(form){
    const fd=new FormData(form);
    b.termo=String(fd.get('termo')||fd.get('termo_dir')||fd.get('termo_wa')||'').trim();
    b.url=String(fd.get('url')||'').trim();
    b.regiao=String(fd.get('regiao')||'').trim();
    b.manual=String(fd.get('manual')||'').trim();
  }
  const out=$('[data-busca-result]');
  const canal=b.canal;
  if(canal==='LinkedIn'||canal==='Google'){
    const c=BUSCA_CANAIS.find(x=>x.id===canal);
    if(out) out.innerHTML=`<div class="empty">${esc(c.rotulo)} indisponível — ${esc(c.motivo)}</div>`;
    return;
  }
  if(canal==='WhatsApp'){
    const termo=(b.termo||'').toLowerCase().trim();
    const rows=(state.conversations||[]).filter(c=>{
      /* Só canais conectados: LinkedIn não entra. */
      if(!(CHANNEL_STATUS[c.canal]&&CHANNEL_STATUS[c.canal].conectado)) return false;
      if(!termo) return true;
      return [c.contato,c.empresa,c.ultimo_texto,c.contexto].join(' ').toLowerCase().includes(termo);
    }).slice(0,60);
    b.resultados=rows.map(c=>({
      nome:c.contato, cargo:c.cargo||'', empresa:c.empresa||'',
      email:c.email||'', telefone:c.telefone||'',
      _conv:{id:c.id,canal:c.canal,quando:c.atualizado||c.ts,preview:c.preview||c.ultima||''}
    }));
    b.status=b.resultados.length?`${b.resultados.length} contato(s) do histórico.`:'Nada encontrado no histórico.';
    renderBuscaResults();
    return;
  }
  if(out) out.innerHTML='<div class="empty">Consultando…</div>';
  try{
    const payload={canal,termo:b.termo,quantidade:25,regiao:b.regiao,url_alvo:b.url,texto_manual:b.manual};
    const r=await fetch(BUSCA_API+'/api/pesquisar',{
      method:'POST',headers:{'Content-Type':'application/json'},
      body:JSON.stringify(payload)
    });
    const data=await r.json();
    if(!r.ok) throw new Error(data&&data.erro?data.erro:('HTTP '+r.status));
    b.resultados=(data.resultados||[]).map(x=>({...x,_web:true}));
    b.status=(data.aviso?data.aviso+' · ':'')+`${b.resultados.length} resultado(s) de "${b.termo||b.regiao||'consulta'}".`;
  }catch(e){
    b.resultados=[];
    b.status='Não consegui falar com o módulo local ('+e.message+'). Ele roda em '+BUSCA_API+'.';
  }
  renderBuscaResults();
}
function renderBuscaResults(){
  const b=buscaEstado();
  const out=$('[data-busca-result]');
  if(!out) return;
  if(!b.resultados.length){
    out.innerHTML=`<div class="empty">${esc(b.status||'Busque para ver candidatos.')}</div>`;
    return;
  }
  out.innerHTML=`
    <div class="sub" style="margin-bottom:10px">${esc(b.status)} Escolha o que entra na lista.</div>
    <div style="max-height:280px;overflow:auto;border:1px solid var(--line);border-radius:10px">
      <table class="tbl">
        <thead><tr><th style="width:34px"></th><th>Nome</th><th>Empresa</th><th>Contato</th></tr></thead>
        <tbody>
          ${b.resultados.map((r,i)=>`
            <tr class="row">
              <td><input type="checkbox" data-busca-pick="${i}" checked style="accent-color:var(--accent)"></td>
              <td><div class="name">${esc(r.nome||'—')}</div>${r.cargo?`<div class="sub">${esc(r.cargo)}</div>`:''}</td>
              <td>${esc(r.empresa||'—')}${r.cidade?`<div class="sub">${esc(r.cidade)}</div>`:''}</td>
              <td>${esc([r.email,r.telefone].filter(Boolean).join(' · ')||'—')}</td>
            </tr>`).join('')}
        </tbody>
      </table>
    </div>
    <div class="form-actions">
      <button class="btn" data-close>Cancelar</button>
      <button class="btn primary" data-busca-save>Salvar na lista atual</button>
    </div>`;
  $$('[data-busca-pick]').forEach(cb=>cb.addEventListener('change',()=>{}));
  const save=$('[data-busca-save]');
  if(save) save.addEventListener('click',()=>{
    const b2=buscaEstado();
    const picks=$$('[data-busca-pick]').filter(cb=>cb.checked).map(cb=>b2.resultados[+cb.dataset.buscaPick]);
    if(!picks.length){ toast('Selecione ao menos um contato'); return; }
    const nome='Web · '+(b2.termo||b2.regiao||'busca')+' · '+new Date().toLocaleDateString('pt-BR');
    const store=loadUserStore();
    const have=new Set(state.opportunities.map(o=>o.id));
    const novos=[];
    picks.forEach(r=>{
      const opp=webParaOportunidade(r,b2.canal==='WhatsApp'?'WA':'WEB');
      if(r._conv){opp.conversa_origem=r._conv;opp.origem=r._conv.canal;opp.fonte=r._conv.canal;}
      if(!have.has(opp.id)){ store.leadsExtras.push(opp); state.opportunities.push(opp); have.add(opp.id); }
      else{
        const ex=state.opportunities.find(o=>o.id===opp.id);
        if(ex) Object.assign(ex,opp);
      }
      novos.push(opp);
    });
    const l={id:nextListId(),nome,ids:novos.map(o=>o.id),filtro:'busca na internet',criadaEm:new Date().toISOString()};
    store.listas.push(l);
    saveUserStore(store);
    rebuildOppIndex();
    state.listasFilter='u:'+l.id;
    closeBackdrop(); render();
    toast(`${novos.length} contato(s) na lista "${nome}"`);
  });
}
