</head><body id="body">
<div id="bg"><div class="bl bl1" data-d="14"></div>
<div class="bl bl2" data-d="24"></div><div class="nz"></div></div>
<main>
 <div class="hd">
   <div class="brand">
     <div class="logo" id="logo"></div>
